<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f5f7fb">
<title>Maths Lab | Explore, Discover, Explain</title>
<style>
:root{color-scheme:light;--ink:#17243b;--muted:#66748b;--line:#e4e9f1;--paper:#fff;--wash:#f5f7fb;--blue:#4569e8;--blue2:#edf1ff;--teal:#10a998;--tealwash:#e8f8f5;--orange:#f4a340;--pink:#eb7184;--shadow:0 12px 35px rgba(39,56,95,.07);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
*{box-sizing:border-box}body{margin:0;background:var(--wash);color:var(--ink);font-size:15px;line-height:1.55}button,input,select{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:3px solid #9aafff;outline-offset:2px}.shell{min-height:100vh;display:grid;grid-template-columns:276px minmax(0,1fr)}aside{background:#fff;border-right:1px solid var(--line);padding:24px 16px;position:sticky;top:0;height:100vh;overflow:auto}.brand{display:flex;align-items:center;gap:12px;padding:4px 10px 24px}.brandmark{width:42px;height:42px;border-radius:14px;background:linear-gradient(140deg,#5778ee,#21b9a2);display:grid;place-items:center;color:#fff;font-size:23px;font-weight:800}.brand strong{display:block;font-size:16px;letter-spacing:-.3px}.brand small{color:var(--muted);font-size:12px}.nav-label{margin:20px 10px 8px;text-transform:uppercase;letter-spacing:1.2px;font-size:10px;font-weight:800;color:#9aa5b7}.grade-button,.topic-button{width:100%;border:0;background:none;color:var(--ink);text-align:left;border-radius:10px;padding:10px 12px;display:flex;align-items:center;justify-content:space-between}.grade-button{font-weight:750;margin:3px 0}.grade-button:hover,.topic-button:hover{background:#f4f6fb}.grade-button.active{background:var(--blue2);color:var(--blue)}.grade-count{font-size:11px;color:var(--muted);font-weight:600}.topic-list{padding:3px 0 8px 11px}.topic-button{font-size:12px;color:#66748b;padding:8px 10px;gap:8px}.topic-button .num{font-size:10px;font-weight:800;color:#9aa5b7;min-width:18px}.topic-button.active{background:#f0f3ff;color:var(--blue);font-weight:700}.side-progress{margin:25px 6px 0;padding:14px;background:#f8f9fc;border:1px solid var(--line);border-radius:13px}.side-progress strong{font-size:12px}.progress-track{height:6px;border-radius:8px;background:#e6eaf2;margin:10px 0 5px;overflow:hidden}.progress-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--teal));width:0;transition:width .25s}.side-progress small{font-size:11px;color:var(--muted)}
main{min-width:0;padding:26px clamp(18px,4vw,54px) 60px;max-width:1450px;width:100%;margin:auto}.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:26px}.crumb{font-size:13px;color:var(--muted)}.crumb b{color:var(--ink)}.session-pill{font-size:12px;color:#16897e;background:var(--tealwash);border-radius:30px;padding:7px 12px;font-weight:700;white-space:nowrap}.welcome{background:linear-gradient(115deg,#263a69,#4569e8 70%,#6382f1);border-radius:20px;padding:24px 28px;color:#fff;margin-bottom:25px;position:relative;overflow:hidden}.welcome:after{content:"＋  ×  ÷  √";position:absolute;right:26px;top:18px;font-size:35px;letter-spacing:12px;color:#ffffff29;transform:rotate(-9deg);font-weight:800}.welcome .eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:1.4px;color:#dce4ff;font-weight:800}.welcome h1{font-size:clamp(23px,3vw,34px);line-height:1.15;letter-spacing:-.8px;margin:6px 0 8px}.welcome p{margin:0;color:#e3e9ff;max-width:630px;font-size:14px}.welcome-meta{margin-top:16px;display:flex;gap:8px;flex-wrap:wrap}.welcome-meta span{font-size:11px;padding:5px 10px;border:1px solid #ffffff3d;border-radius:30px;color:#f0f3ff}.activity-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:17px}.activity-title{display:flex;gap:13px;align-items:flex-start}.topic-icon{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;background:var(--tealwash);font-size:21px;flex:none}.activity-title h2{font-size:22px;letter-spacing:-.5px;line-height:1.2;margin:0 0 4px}.activity-title p{margin:0;color:var(--muted);font-size:13px}.topic-tag{font-size:11px;color:#5169c8;background:var(--blue2);padding:6px 10px;border-radius:20px;white-space:nowrap;font-weight:700}.steps{display:flex;gap:7px;flex-wrap:wrap;margin:15px 0 18px}.step{font-size:11px;color:#758198;background:#fff;border:1px solid var(--line);border-radius:20px;padding:5px 10px}.step b{color:var(--blue);margin-right:4px}
.lab-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(290px,.85fr);gap:17px;align-items:stretch}.card{background:var(--paper);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);min-width:0}.visual-card{padding:18px;min-height:360px}.card-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.card-heading h3{margin:0;font-size:13px}.card-heading span{font-size:11px;color:var(--muted)}.visual{min-height:270px;display:flex;align-items:center;justify-content:center;overflow:auto;padding:6px 2px}.visual svg{max-width:100%;height:auto}.right-stack{display:flex;flex-direction:column;gap:14px}.controls-card,.thinking-card,.explain-card{padding:16px}.card h3{font-size:13px;margin:0 0 10px}.instruction{background:#f7f8ff;border-radius:10px;padding:10px 11px;font-size:12px;color:#4f5c79;margin-bottom:13px}.prediction{font-size:12px;font-weight:700;margin-bottom:9px}.control{margin:10px 0 13px}.control-top{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:5px}.control label{font-size:12px;font-weight:650}.control output{font-size:12px;color:var(--blue);font-weight:800}.control input[type=range]{width:100%;accent-color:var(--blue);height:22px;margin:0}.control select{width:100%;border:1px solid var(--line);border-radius:8px;background:#fff;padding:8px;color:var(--ink);font-size:12px}.control input[type=number]{width:100%;border:1px solid var(--line);border-radius:8px;padding:8px}.button-row{display:flex;gap:8px;margin-top:13px}.button{border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:9px;padding:8px 12px;font-size:12px;font-weight:700}.button:hover{background:#f6f7fb}.button.primary{background:var(--blue);border-color:var(--blue);color:#fff}.button.primary:hover{background:#3455d6}.calc{border-radius:11px;background:#f7f9fc;padding:11px 12px;font-size:12px;color:#39465f;line-height:1.7;overflow-wrap:anywhere}.calc strong{color:var(--ink)}.explanation{font-size:12px;color:#58657a;margin:0}.thinking-card{border-left:3px solid var(--orange)}.thinking-card p{font-size:12px;margin:0 0 8px}.question{font-weight:700!important;color:var(--ink)}.answer-row{display:flex;gap:7px}.answer-row input{min-width:0;flex:1;border:1px solid var(--line);border-radius:8px;padding:8px 9px;font-size:12px}.feedback{min-height:18px;font-size:11px;font-weight:650;margin-top:7px;color:#18877d}.feedback.wrong{color:#c7653e}.try-row{display:flex;align-items:center;justify-content:space-between;margin-top:13px;gap:8px}.try-row span{font-size:11px;color:var(--muted)}.quiz-section{margin-top:27px}.section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.section-title h2{font-size:17px;margin:0;letter-spacing:-.3px}.score{font-size:12px;font-weight:700;color:#16897e}.quiz-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.quiz-card{padding:15px}.quiz-card .qnum{font-size:10px;text-transform:uppercase;letter-spacing:.8px;color:var(--blue);font-weight:800}.quiz-card p{font-size:13px;font-weight:650;min-height:40px;margin:6px 0 11px}.quiz-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.quiz-options button{background:#fff;border:1px solid var(--line);border-radius:8px;padding:8px;text-align:left;font-size:11px;color:#48546a}.quiz-options button:hover:not(:disabled){border-color:#9cafff;background:#f7f8ff}.quiz-options button.correct{border-color:#68c5ab;background:#effaf6;color:#087b67}.quiz-options button.incorrect{border-color:#e7a59e;background:#fff5f3;color:#b24c43}.quiz-options button:disabled{cursor:default}.quiz-feedback{font-size:11px;margin-top:7px;color:var(--muted);min-height:16px}.quiz-summary{display:none;margin-top:13px;background:#eef8f5;border-radius:11px;padding:13px;font-size:13px;font-weight:700;color:#167e70}.quiz-progress-row{display:flex;align-items:center;justify-content:space-between;gap:12px}.difficulty{font-size:11px;color:var(--muted);font-weight:500}.topic-quiz-card .progress-track{margin:12px 0}.topic-question{font-size:15px;font-weight:700;min-height:auto!important;margin:13px 0!important}.topic-options button{min-height:42px}.quiz-feedback.wrong{color:#b85a43}.quiz-hint{margin-top:10px;padding:10px 12px;border-radius:9px;background:#fff8e9;color:#735d36;font-size:12px}.topic-quiz-actions{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:13px}.topic-quiz-actions span{font-size:11px;color:var(--muted)}.topic-quiz-card .quiz-options button:disabled{opacity:.9}.quiz-summary p{margin:6px 0 12px;font-weight:500}.data-table{border-collapse:collapse;font-size:11px;margin:5px auto}.data-table th,.data-table td{border:1px solid #dfe5ef;padding:5px 8px;text-align:center}.data-table th{background:#f2f5fb}.empty-state{text-align:center;padding:35px 20px;color:var(--muted)}.empty-state h2{color:var(--ink)}.vis-note{text-align:center;color:var(--muted);font-size:11px;padding-top:5px}.mobile-menu{display:none}
@media(max-width:980px){.shell{grid-template-columns:230px minmax(0,1fr)}aside{padding:20px 11px}main{padding:22px 22px 50px}.lab-grid{grid-template-columns:minmax(0,1fr)}.right-stack{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.controls-card{grid-row:span 2}.visual-card{min-height:320px}}
@media(max-width:680px){.shell{display:block}aside{position:relative;width:100%;height:auto;max-height:none;border-right:0;border-bottom:1px solid var(--line);padding:12px 13px}.brand{padding:0 2px 10px}.brandmark{width:36px;height:36px}.nav-label{margin:10px 4px 6px}.grade-button{display:inline-flex;width:auto;margin:0 4px 3px 0;padding:8px 10px}.grade-count{margin-left:7px}.topic-list{display:none;padding:6px 0;overflow:auto;white-space:nowrap}.topic-list.mobile-open{display:flex}.topic-button{width:auto;display:inline-flex;flex:none;padding:8px 10px}.side-progress{display:none}main{padding:16px 13px 40px}.topbar{margin-bottom:16px}.welcome{padding:21px 19px;margin-bottom:20px}.welcome:after{right:-25px;top:4px;font-size:25px}.welcome p{max-width:85%}.activity-head{gap:8px}.activity-title h2{font-size:19px}.topic-tag{font-size:10px}.lab-grid{gap:12px}.visual-card{padding:14px;min-height:290px}.visual{min-height:220px}.right-stack{display:flex}.quiz-grid{grid-template-columns:1fr}.quiz-card p{min-height:auto}.steps{margin:11px 0 14px}.quiz-options{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
</style>
</head>
<body>
<div class="shell">
<aside aria-label="Mathematics lab navigation">
  <div class="brand"><div class="brandmark" aria-hidden="true">∑</div><div><strong>Maths Lab</strong><small>Explore • Discover • Explain</small></div></div>
  <div class="nav-label">Choose your class</div>
  <div id="gradeNav"></div>
  <div class="side-progress" aria-live="polite"><strong>Your learning journey</strong><div class="progress-track"><div class="progress-fill" id="progressFill"></div></div><small id="progressText">0 activities explored</small></div>
</aside>
<main>
  <div class="topbar"><div class="crumb">Learning space <span aria-hidden="true">/</span> <b id="crumb">Class 6</b></div><div class="session-pill">● Progress stays in this session</div></div>
  <section class="welcome"><div class="eyebrow">Your interactive mathematics studio</div><h1>Make a guess. Try it out. Learn why.</h1><p>Move numbers, reshape figures, and test your ideas. Mathematics makes more sense when you can see it.</p><div class="welcome-meta"><span>18 hands-on activities</span><span>3 classes</span><span>No sign-in • Works offline</span></div></section>
  <div id="activityRoot"></div>
</main>
</div>
<script>
(() => {
"use strict";
const activities = [
 {id:1,grade:6,title:"Whole Numbers and Integers",icon:"↔",kind:"integers",desc:"Travel along a number line to add, subtract, compare, and measure distance.",instruction:"Predict where you will land, then move the start and step controls. Choose comparison or distance to inspect two points.",question:"Starting at −2, move 5 steps to the right. Where do you land?",answer:["3"],controls:[["start","Starting number",-8,8,2],["steps","Step size",-8,8,3],["operation","Operation","select",["Addition","Subtraction","Compare","Distance"]]]},
 {id:2,grade:6,title:"Fractions and Decimals",icon:"▥",kind:"fractions",desc:"Compare parts of a whole and see fraction operations on fraction bars.",instruction:"Change each fraction and choose an operation. Bars show whole groups; decimal labels help compare their values.",question:"Which is greater: 1/2 or 2/5?",answer:["1/2","0.5"],controls:[["a","First numerator",1,9,2],["b","First denominator",2,10,3],["c","Second numerator",1,9,1],["d","Second denominator",2,10,4],["operation","Operation","select",["Add","Subtract","Compare"]]]},
 {id:3,grade:6,title:"Ratio and Proportion",icon:"●",kind:"ratio",desc:"Scale a recipe and watch equivalent groups grow together.",instruction:"Choose how many batches to make. Each batch keeps the same fruit-to-yoghurt ratio.",question:"If 2 cups of fruit go with 3 cups of yoghurt, how much yoghurt for 4 cups of fruit?",answer:["6"],controls:[["batches","Number of batches",1,6,2],["fruit","Fruit per batch (cups)",1,5,2],["yoghurt","Yoghurt per batch (cups)",1,6,3]]},
 {id:4,grade:6,title:"Basic Algebra",icon:"⚖",kind:"balance",desc:"Use a balance to solve one-step equations by keeping both sides equal.",instruction:"Adjust the equation values. Remove the same amount from both sides, then share equally.",question:"If 2x = 10, what is x?",answer:["5"],controls:[["a","Number of x tiles",1,5,2],["b","Extra unit tiles",0,8,2],["total","Total on right",2,20,12]]},
 {id:5,grade:6,title:"Geometry and Measurement",icon:"△",kind:"geometry",desc:"Explore triangle angles and quadrilaterals; change measurements to reshape figures.",instruction:"Switch between a triangle and quadrilateral. Adjust angles and size to see the figure change; the displayed angle sums are geometric facts.",question:"Two angles are 60° and 60°. What is the third angle of a triangle?",answer:["60"],controls:[["shape","Figure","select",["Triangle","Quadrilateral"]],["angleA","Angle A (degrees)",20,140,60],["angleB","Angle B (degrees)",20,140,60],["length","Size (cm)",3,10,6]]},
 {id:6,grade:6,title:"Perimeter, Area, and Data",icon:"▦",kind:"rectangle",desc:"Resize a rectangle, calculate its area and perimeter, and collect a tiny dataset.",instruction:"Change the side lengths or add a data point. The rectangle and chart update together.",question:"A rectangle is 5 cm by 3 cm. What is its area?",answer:["15","15 cm2","15 cm²"],controls:[["length","Length (cm)",1,12,5],["width","Width (cm)",1,10,3],["data","Add a data point","button"]]},
 {id:7,grade:7,title:"Rational Numbers and Percentages",icon:"%",kind:"percent",desc:"Connect fractions, decimals, and percentages with discounts and number lines.",instruction:"Change the price, discount, and signed rational number. Compare the amount saved with the price you pay.",question:"What is 25% of 80?",answer:["20"],controls:[["price","Original price ($)",20,200,80],["percent","Discount (%)",0,90,25],["rational","Rational value (tenths)",-10,10,-3]]},
 {id:8,grade:7,title:"Algebraic Expressions and Equations",icon:"x²",kind:"algebra",desc:"Build an expression from variable tiles and balance it against a number.",instruction:"Change x, the coefficient, and constant. The tile model shows ax + b and its value.",question:"When x = 3, what is 2x + 1?",answer:["7"],controls:[["x","Value of x",0,10,3],["a","Coefficient a",1,6,2],["b","Constant b",0,10,1]]},
 {id:9,grade:7,title:"Lines, Angles, and Triangles",icon:"∠",kind:"angles",desc:"Adjust triangle angles and explore the straight-line and triangle angle sums.",instruction:"Move the first two angles. The third is calculated so the triangle remains possible.",question:"Angles on a straight line add to how many degrees?",answer:["180","180°"],controls:[["angleA","Angle A (degrees)",20,140,50],["angleB","Angle B (degrees)",20,140,60]]},
 {id:10,grade:7,title:"Congruence and Symmetry",icon:"◇",kind:"symmetry",desc:"Reflect and rotate a shape, then compare its size and symmetry.",instruction:"Use the controls to reflect or rotate the blue triangle. Rigid transformations preserve shape and size.",question:"Does a reflection change a shape's side lengths?",answer:["no","nope"],controls:[["rotation","Rotation (degrees)","select",["0","45","90","135","180","270"]],["reflect","Reflect across vertical line","select",["No","Yes"]],["size","Shape size",1,5,3]]},
 {id:11,grade:7,title:"Comparing Quantities and Data",icon:"↗",kind:"finance",desc:"Explore percentage change, profit or loss, and simple interest.",instruction:"Choose a real-world calculation and adjust the amounts. Check whether the result is profit or loss.",question:"An item costs $40 and sells for $50. What is the profit?",answer:["10","$10"],controls:[["mode","Example","select",["Profit or loss","Simple interest"]],["cost","Cost / principal ($)",10,200,40],["selling","Selling price / rate (%)",1,250,50],["time","Time (years)",1,10,2]]},
 {id:12,grade:7,title:"Perimeter, Area, and 3D Shapes",icon:"⬡",kind:"solid",desc:"Adjust a cuboid and compare its volume, surface area, and a foldable net.",instruction:"Change the cuboid dimensions. Its net has matching rectangles and the formulas update live.",question:"What is the volume of a 2 cm × 3 cm × 4 cm cuboid?",answer:["24","24 cm3","24 cm³"],controls:[["length","Length (cm)",1,8,4],["width","Width (cm)",1,8,3],["height","Height (cm)",1,8,2]]},
 {id:13,grade:8,title:"Rational Numbers, Powers, and Squares",icon:"√",kind:"powers",desc:"Explore number operations and visualize squares, roots, cubes, and powers.",instruction:"Choose a positive whole number. Its square is a square area; its cube is a stack of equal layers. The number line below shows an operation with a signed integer.",question:"What is 7²?",answer:["49"],controls:[["number","Number",1,12,5],["power","Explore","select",["Square","Square root","Cube"]],["operand","Number-line operand",-8,8,2],["operation","Number-line operation","select",["Add","Subtract","Multiply"]]]},
 {id:14,grade:8,title:"Linear Equations",icon:"=",kind:"linear",desc:"Solve a one-variable equation step by step, applying each operation to both sides.",instruction:"The equation has the form ax + b = c. Follow the balance steps to isolate x.",question:"Solve x + 4 = 9. What is x?",answer:["5"],controls:[["a","Coefficient a",1,6,2],["b","Added value b",0,12,4],["c","Right side c",2,30,14]]},
 {id:15,grade:8,title:"Proportions, Percentages, and Variation",icon:"⏱",kind:"variation",desc:"Compare direct and inverse variation using speed, time, and an updating table.",instruction:"Choose speed and distance. In this trip, greater speed means less travel time.",question:"At 60 km/h, how long does 120 km take?",answer:["2","2 hours"],controls:[["distance","Distance (km)",30,300,120],["speed","Speed (km/h)",10,120,60]]},
 {id:16,grade:8,title:"Geometry: Polygons and 3D Figures",icon:"⬠",kind:"polygon",desc:"Change a polygon's number of sides and explore angle sums, solids, and coordinates.",instruction:"Choose a regular polygon. Dragging its controls is not required: change the side count and inspect its angles.",question:"What is the sum of the interior angles of a quadrilateral?",answer:["360","360°"],controls:[["sides","Number of sides",3,10,5],["radius","Vertex distance",3,8,5],["solid","Show a solid","select",["Cube net","Triangular prism"]]]},
 {id:17,grade:8,title:"Mensuration",icon:"▱",kind:"mensuration",desc:"Adjust 2D and 3D dimensions and see perimeter, area, surface area, and volume.",instruction:"Choose a shape and change its dimensions. The formula substitutes your values and units.",question:"What is the area of a 4 cm by 6 cm rectangle?",answer:["24","24 cm2","24 cm²"],controls:[["shape","Shape","select",["Rectangle","Circle","Cuboid"]],["length","Length / radius (cm)",1,12,6],["width","Width (cm)",1,10,4],["height","Height (cm)",1,10,3]]},
 {id:18,grade:8,title:"Data Handling and Probability",icon:"◔",kind:"probability",desc:"Generate coin flips or dice rolls and compare experimental results to expectation.",instruction:"Click to collect outcomes. Reset clears the sample. With more trials, relative frequency often approaches expectation.",question:"What is the probability of rolling a 6 on a fair die?",answer:["1/6","one sixth"],controls:[["sample","Generate outcomes","button"],["sampleSize","Outcomes to add",1,20,10],["chance","Experiment","select",["Coin flips","Dice rolls"]],["chart","Chart type","select",["Bar chart","Line graph","Pie chart"]]]}
];
const state={grade:6,activity:1,visited:new Set(),data:[3,5,2,6],outcomes:[],quizByTopic:{},saved:{}};
const $=id=>document.getElementById(id);
function byId(id){return activities.find(a=>a.id===id)}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function fmt(n,d=2){return Number.isInteger(n)?String(n):Number(n.toFixed(d)).toString()}
function renderNav(){
 const host=$("gradeNav");host.innerHTML="";
 [6,7,8].forEach(g=>{
  const btn=document.createElement("button");btn.className="grade-button"+(state.grade===g?" active":"");btn.setAttribute("aria-expanded",state.grade===g);btn.innerHTML=`Class ${g}<span class="grade-count">${activities.filter(a=>a.grade===g).length} topics</span>`;
  btn.onclick=()=>{state.grade=g;state.activity=activities.find(a=>a.grade===g).id;renderAll()};host.append(btn);
  const list=document.createElement("div");list.className="topic-list"+(state.grade===g?" mobile-open":"");list.setAttribute("aria-label",`Class ${g} activities`);
  activities.filter(a=>a.grade===g).forEach(a=>{const b=document.createElement("button");b.className="topic-button"+(state.activity===a.id?" active":"");b.innerHTML=`<span class="num">${String(a.id).padStart(2,"0")}</span><span>${esc(a.title)}</span>`;b.onclick=()=>{state.activity=a.id;renderAll()};list.append(b)});host.append(list);
 });
 const done=state.visited.size;$("progressFill").style.width=(done/18*100)+"%";$("progressText").textContent=`${done} of 18 activities explored`;
}
function defaults(a){const v={};a.controls.forEach(c=>{v[c[0]]=c[2]==="select"?c[3][0]:c[2]==="button"?0:c[4]});if(a.kind==="symmetry")v.reflect="No";if(a.kind==="finance")v.mode="Profit or loss";if(a.kind==="powers"){v.power="Square";v.operation="Add"}if(a.kind==="polygon")v.solid="Cube net";if(a.kind==="mensuration")v.shape="Rectangle";if(a.kind==="probability")v.chance="Coin flips";if(a.kind==="fractions")v.operation="Add";if(a.kind==="integers")v.operation="Addition";return v}
function getValues(a){return Object.fromEntries(a.controls.map(c=>{let e=$("c-"+c[0]);return[c[0],e?(c[2]==="select"?e.value:c[2]==="button"?0:Number(e.value)):c[2]==="select"?c[3][0]:c[2]==="button"?0:c[4]]}))}
function controlMarkup(c,v){const [id,label,min,max,value]=c;const key="c-"+id;if(min==="select"){return `<div class="control"><label for="${key}">${esc(label)}</label><select id="${key}">${max.map(x=>`<option${String(v[id])===String(x)?" selected":""}>${esc(x)}</option>`).join("")}</select></div>`}
 if(min==="button")return `<div class="control"><label for="${key}">${esc(label)}</label><button class="button primary" id="${key}" type="button">${aButtonText(id)}</button></div>`;
 return `<div class="control"><div class="control-top"><label for="${key}">${esc(label)}</label><output id="${key}-out" for="${key}">${esc(v[id])}</output></div><input id="${key}" type="range" min="${min}" max="${max}" step="1" value="${v[id]}" aria-label="${esc(label)}"></div>`
}
function aButtonText(id){return id==="data"?"Add data point":"Add outcomes"}
function svgWrap(body,view="0 0 520 230"){return `<svg viewBox="${view}" role="img" aria-label="Interactive mathematics visual" xmlns="http://www.w3.org/2000/svg">${body}</svg>`}
function textSvg(x,y,t,size=13,color="#56647a",weight=500,anchor="middle"){return `<text x="${x}" y="${y}" fill="${color}" font-size="${size}" font-weight="${weight}" text-anchor="${anchor}" font-family="system-ui,sans-serif">${esc(t)}</text>`}
function lineSvg(x1,y1,x2,y2,color="#cbd3e1",width=2,dash=""){return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${color}" stroke-width="${width}" ${dash?`stroke-dasharray="${dash}"`:""}/>`}
function circle(x,y,r,fill,stroke="none"){return `<circle cx="${x}" cy="${y}" r="${r}" fill="${fill}" stroke="${stroke}" stroke-width="2"/>`}
function round(n){return Math.round((n+Number.EPSILON)*100)/100}
function renderMath(a,v){
 const n=(x)=>Number(x);
 switch(a.kind){
 case"integers":{let start=n(v.start),step=n(v.steps),isCompare=v.operation==="Compare"||v.operation==="Distance",s=n(v.operation==="Subtraction"?-step:step),end=isCompare?step:start+s,lo=Math.min(-8,start,end),hi=Math.max(8,start,end),px=q=>40+(q-lo)/(hi-lo)*440,ticks="";for(let i=lo;i<=hi;i++){let x=px(i);ticks+=lineSvg(x,110,x,119,i===end||i===start?"#4569e8":"#adb8c9",i===end||i===start?3:1.5)+textSvg(x,139,i,10,i===end||i===start?"#4569e8":"#738096",i===end||i===start?800:500)}let x1=px(start),x2=px(end),relation=start<end?"<":start>end?">":"=";let visualLabel=isCompare?"compare":`${Math.abs(s)} ${s<0?"left":"right"}`;return {visual:svgWrap(`${lineSvg(40,114,480,114,"#9eaabc",2)}${ticks}${lineSvg(x1,76,x2,76,"#10a998",4)}${circle(x1,76,6,"#fff","#10a998")}${circle(x2,76,8,"#4569e8")}${textSvg((x1+x2)/2,64,visualLabel,12,"#16897e",700)}${textSvg(x1,55,`first ${start}`,11)}${textSvg(x2,96,`${isCompare?"second":"land"} ${end}`,11,"#4569e8",800)}`),math:isCompare?`<strong>${start} ${relation} ${end}</strong><br>Distance = |${end} − (${start})| = <strong>${Math.abs(end-start)} units</strong>`:`<strong>${start} ${s<0?"−":"+"} ${Math.abs(s)} = ${end}</strong><br>Distance between ${start} and ${end}: |${end} − (${start})| = <strong>${Math.abs(end-start)} units</strong>`,explain:isCompare?`Compare the two positions: ${start} is ${start===end?"equal to":start<end?"to the left of":"to the right of"} ${end}. Distance counts the spaces between them and is never negative.`:`A positive step moves right and a negative step moves left. Distance is always non-negative, so the distance from ${start} to ${end} is ${Math.abs(end-start)}.`}}
 case"fractions":{let aa=n(v.a),bb=n(v.b),cc=n(v.c),dd=n(v.d),x=aa/bb,y=cc/dd,result=v.operation==="Add"?x+y:v.operation==="Subtract"?x-y:null;let bar=(num,den,y,col,label)=>{let parts="",wholeWidth=54,wholeGap=7,height=23,count=Math.ceil(num/den);for(let whole=0;whole<count;whole++){for(let i=0;i<den;i++){let filled=whole*den+i<num,cellWidth=wholeWidth/den;parts+=`<rect x="${160+whole*(wholeWidth+wholeGap)+i*cellWidth}" y="${y}" width="${cellWidth}" height="${height}" fill="${filled?col:"#f1f3f8"}" stroke="#fff" stroke-width="1"/>`}}return parts+textSvg(149,y+16,label,11,"#4d5a70",700,"end")};let bars=bar(aa,bb,45,"#6282ee",`${aa}/${bb}`)+bar(cc,dd,118,"#20b49f",`${cc}/${dd}`),max=Math.max(1,Math.ceil(Math.max(x,y))),lineStart=95,lineWidth=340;let point=(val,col)=>{let px=lineStart+Math.min(val/max,1)*lineWidth;return circle(px,193,6,col)};let cmp;if(v.operation==="Compare"){cmp=`<strong>${aa}/${bb} ${x>y?">":x<y?"<":"="} ${cc}/${dd}</strong><br>${fmt(x)} ${x>y?">":x<y?"<":"="} ${fmt(y)} as decimals.`}else{let numerator=aa*dd+(v.operation==="Add"?1:-1)*cc*bb,denominator=bb*dd,gcd=(u,w)=>w?gcd(w,u%w):Math.abs(u),factor=gcd(numerator,denominator)||1,exactN=numerator/factor,exactD=denominator/factor;cmp=`<strong>${aa}/${bb} ${v.operation==="Add"?"+":"−"} ${cc}/${dd}</strong><br>= ${aa*dd} / ${bb*dd} ${v.operation==="Add"?"+":"−"} ${cc*bb} / ${bb*dd}<br>= <strong>${exactN}/${exactD}</strong> ≈ ${fmt(result)} (rounded to 2 decimal places)`}return{visual:svgWrap(`${textSvg(270,26,"Fraction bars (complete wholes and parts)",12,"#53617a",700)}${bars}${lineSvg(lineStart,193,lineStart+lineWidth,193,"#bdc8d8")}${lineSvg(lineStart,188,lineStart,198,"#8997aa")}${lineSvg(lineStart+lineWidth,188,lineStart+lineWidth,198,"#8997aa")}${textSvg(lineStart,216,"0",9)}${textSvg(lineStart+lineWidth,216,`${max}`,9)}${point(x,"#4569e8")}${point(y,"#10a998")}${textSvg(270,228,`Blue ${aa}/${bb} = ${fmt(x)}  •  Green ${cc}/${dd} = ${fmt(y)}`,10)}`),math:`${cmp}<br>Decimal equivalents: ${aa}/${bb} = <strong>${fmt(x)}</strong>; ${cc}/${dd} = <strong>${fmt(y)}</strong>.`,explain:`A fraction names equal-sized parts. To add or subtract, rewrite fractions with a common denominator; compare their positions and decimal equivalents to order them.`}}
 case"ratio":{let b=n(v.batches),f=n(v.fruit)*b,y=n(v.yoghurt)*b;let items="";for(let i=0;i<Math.min(f,30);i++)items+=circle(130+(i%10)*24,66+Math.floor(i/10)*24,7,"#f4a340");for(let i=0;i<Math.min(y,30);i++)items+=circle(350+(i%10)*24,66+Math.floor(i/10)*24,7,"#6081ec");return{visual:svgWrap(`${textSvg(235,26,`${b} ${b===1?"batch":"batches"} • same recipe ratio`,12,"#53617a",700)}${items}${textSvg(235,159,`${f} cups fruit`,12,"#a16a18",700)}${textSvg(350,184,`${y} cups yoghurt`,12,"#4569e8",700)}`),math:`<strong>${v.fruit} : ${v.yoghurt}</strong> per batch<br>Multiply both parts by ${b}:<br>Fruit = ${v.fruit} × ${b} = <strong>${f} cups</strong><br>Yoghurt = ${v.yoghurt} × ${b} = <strong>${y} cups</strong>`,explain:`An equivalent ratio keeps the same multiplier for both quantities. ${v.fruit} : ${v.yoghurt} becomes ${f} : ${y}, so the recipe tastes the same.`}}
 case"balance":case"algebra":case"linear":{let a=n(v.a),b=n(v.b),c=n(v.total??v.c),x=n(v.x);let isTiles=a.kind==="algebra",sum=isTiles?a*x+b:a*x+b,target=isTiles?sum:c,sol=a?(c-b)/a:0,shown=isTiles?sum:target;let tiles="";for(let i=0;i<Math.min(a,7);i++)tiles+=`<rect x="${60+i*54}" y="66" width="42" height="42" rx="8" fill="#eaf0ff" stroke="#6684ec"/><text x="${81+i*54}" y="93" fill="#4569e8" font-size="18" font-weight="800" text-anchor="middle" font-family="system-ui">x</text>`;return{visual:svgWrap(`${lineSvg(258,80,258,160,"#71809a",4)}${lineSvg(88,160,428,160,"#71809a",4)}${lineSvg(118,161,158,188,"#71809a",3)}${lineSvg(398,161,358,188,"#71809a",3)}<path d="M75 190 Q138 210 181 190 M335 190 Q378 210 441 190" fill="none" stroke="#71809a" stroke-width="3"/>${tiles}${textSvg(390,85,isTiles?`${a}x + ${b}`:`${a}x + ${b} = ${c}`,13,"#4569e8",800)}${textSvg(390,111,isTiles?`x=${x} → ${shown}`:`x = ${fmt(sol)}`,12,"#16897e",700)}${textSvg(126,220,"left side",10)}${textSvg(390,220,"right side",10)}`),math:isTiles?`<strong>${a}x + ${b} = ${a}(${x}) + ${b} = ${sum}</strong><br>${a} variable tiles and ${b} unit tile${b===1?"":"s"}; each x tile is worth ${x}.`:`${a}x + ${b} = ${c}<br>${a}x = ${c} − ${b} = ${c-b}<br><strong>x = (${c} − ${b}) ÷ ${a} = ${fmt(sol)}</strong>`,explain:isTiles?`An expression combines variable tiles and unit tiles. With x = ${x}, ${a} groups of x and ${b} more have a total value of ${sum}.`:`Keep the balance equal by subtracting ${b} from both sides, then divide both sides by ${a}. The solution is x = ${fmt(sol)}.`}}
 case"geometry":case"angles":{let a=n(v.angleA),b=n(v.angleB),size=n(v.length||6),isQuad=v.shape==="Quadrilateral",rad=d=>d*Math.PI/180;if(isQuad){let width=size*23,height=size*13,skewL=(a-80)*.8,skewR=(b-80)*.8,pts=[[260-width/2,65],[260+width/2,65],[260+width/2+skewR,65+height],[260-width/2+skewL,65+height]],path=`<polygon points="${pts.map(p=>p.join(",")).join(" ")}" fill="#e9efff" stroke="#5574e9" stroke-width="3"/>`;return{visual:svgWrap(`${path}${pts.map(p=>circle(p[0],p[1],5,"#4569e8")).join("")}${textSvg(260,214,`Quadrilateral • size ${size} cm • angles reshape the figure`,12,"#53617a",700)}`),math:`A quadrilateral has 4 sides.<br>Interior angle sum = (4 − 2) × 180° = <strong>360°</strong><br>Scale setting = ${size} cm.`,explain:`Changing the size scales the figure; adjusting the angle controls changes its slant. Every quadrilateral's interior angles add to 360°.`}}let c=180-a-b,baseY=190,base=size*24,left=260-base/2,right=260+base/2,tanA=Math.tan(rad(a)),tanB=Math.tan(rad(b)),apexX=left+base*tanB/(tanA+tanB),apexY=baseY-(apexX-left)*tanA,pts=[[apexX,apexY],[left,baseY],[right,baseY]],path=`<polygon points="${pts.map(p=>p.join(",")).join(" ")}" fill="#e9efff" stroke="#5574e9" stroke-width="3"/>`,rayX=260+75*Math.cos(rad(a)),rayY=37+75*Math.sin(rad(a));return{visual:svgWrap(`${lineSvg(90,37,430,37,"#9eaabc",2)}${lineSvg(260,37,rayX,rayY,"#10a998",3)}${textSvg(180,28,`${180-a}°`,10,"#53617a",700)}${textSvg(341,28,`${a}°`,10,"#16897e",700)}${textSvg(260,20,"Adjacent angles on a straight line",10,"#53617a",700)}${path}${circle(apexX,apexY,5,"#4569e8")}${circle(left,baseY,5,"#4569e8")}${circle(right,baseY,5,"#4569e8")}${textSvg(apexX+(apexX<260?20:-20),apexY+20,`${c}°`,12,"#4569e8",800)}${textSvg(left+18,baseY-10,`${a}°`,12,"#4569e8",800)}${textSvg(right-18,baseY-10,`${b}°`,12,"#4569e8",800)}${textSvg(260,221,`A + B + C = ${a}° + ${b}° + ${c}° = 180°`,12,"#53617a",700)}`),math:`Angles: ${a}° + ${b}° + C = 180°<br><strong>C = 180° − ${a}° − ${b}° = ${c}°</strong><br>Straight line: ${a}° + ${180-a}° = <strong>180°</strong><br>Base scale: ${size} cm.`,explain:`The interior angles of every triangle add to 180°. Adjacent angles on a straight line also add to 180°. Changing either base angle reshapes the triangle.`}}
 case"rectangle":{let l=n(v.length),w=n(v.width),area=l*w,per=2*(l+w),d=state.data;let bars=d.map((x,i)=>`<rect x="${80+i*42}" y="${175-x*12}" width="24" height="${x*12}" rx="3" fill="${i===d.length-1?"#10a998":"#8ca2ee"}"/>${textSvg(92+i*42,193,i+1,9)}`).join("");return{visual:svgWrap(`<rect x="${255-l*8}" y="${90-w*5}" width="${l*16}" height="${w*10}" fill="#e9efff" stroke="#5574e9" stroke-width="3" rx="3"/>${textSvg(255,83,`${l} cm`,11,"#4569e8",700)}${textSvg(255+l*8+15,96,`${w} cm`,11,"#4569e8",700,"start")}${textSvg(155,215,"Data points",10,"#53617a",700)}${lineSvg(75,178,250,178,"#bdc8d8")}${bars}`),math:`Perimeter = 2(${l} + ${w}) = <strong>${per} cm</strong><br>Area = ${l} × ${w} = <strong>${area} cm²</strong><br>Collected values: ${d.join(", ")}.`,explain:`Perimeter measures the distance around the rectangle; area counts square centimetres covering it. The small chart records your data points.`,extraData:true}}
 case"percent":{let p=n(v.price),r=n(v.percent),signed=n(v.rational),saved=p*r/100,pay=p-saved,divisor=(u,w)=>w?divisor(w,u%w):Math.abs(u),g=divisor(r,100)||1;return{visual:svgWrap(`<rect x="70" y="58" width="380" height="40" rx="10" fill="#edf0f6"/><rect x="70" y="58" width="${380*r/100}" height="40" rx="10" fill="#10a998"/><text x="260" y="84" text-anchor="middle" font-family="system-ui" font-size="13" font-weight="800" fill="#23314b">${r}% discount</text>${textSvg(150,130,`Was $${fmt(p)}`,13)}${textSvg(370,130,`Now $${fmt(pay)}`,15,"#16897e",800)}${lineSvg(220,116,300,116,"#c4ccd9",2,"4 4")}${textSvg(260,164,`You save $${fmt(saved)}`,13,"#16897e",700)}${lineSvg(70,206,450,206,"#aab5c5")}${[-10,-5,0,5,10].map(q=>lineSvg(70+(q+10)*19,201,70+(q+10)*19,211,"#8997aa")+textSvg(70+(q+10)*19,225,q/10,9)).join("")}${circle(70+(signed+10)*19,206,6,"#4569e8")}${textSvg(260,190,`Rational number line: ${signed}/10`,10,"#53617a",700)}`),math:`Discount = ${r}% × $${p} = <strong>$${fmt(saved)}</strong><br>Sale price = $${p} − $${fmt(saved)} = <strong>$${fmt(pay)}</strong><br>${r}% = ${r}/100 = ${r/g}/${100/g} = ${fmt(r/100)} as a decimal.<br>Signed rational: ${signed}/10 = <strong>${fmt(signed/10)}</strong>.`,explain:`A percentage means “out of 100.” The marked rational value can be positive or negative; its position left or right of zero shows its sign. The sale price is the original price minus the discount.`}}
 case"symmetry":{let size=n(v.size),s=20+size*10,rot=n(v.rotation),reflect=v.reflect==="Yes"?"-1":"1";let points=`${260},${90-s} ${260-s},${95+s} ${260+s},${95+s}`;return{visual:svgWrap(`${lineSvg(260,30,260,204,"#b7c1d0",1.5,"5 5")}<polygon points="${points}" fill="#f3f5f9" stroke="#aab4c4" stroke-width="2" stroke-dasharray="4 3"/><g transform="translate(260 110) rotate(${rot}) scale(${reflect} 1) translate(-260 -110)"><polygon points="${points}" fill="#dfe8ff" stroke="#4569e8" stroke-width="3"/></g>${textSvg(260,218,`Original (outline) • image (blue)`,11,"#53617a",700)}`),math:`Rigid motion: rotation ${rot}°${reflect==="1"?"":" and reflection"}.<br><strong>Side lengths and angles stay the same</strong>, so the image and original are congruent.`,explain:`Compare the blue image with the outlined original. A reflection flips a figure and a rotation turns it; neither stretches or shrinks it, so size and shape are preserved.`}}
 case"finance":{let cost=n(v.cost),input=n(v.selling),time=n(v.time);if(v.mode==="Simple interest"){let interest=cost*input*time/100,total=cost+interest;return{visual:svgWrap(`${circle(255,108,76,"#eff3ff")}${textSvg(255,98,`$${fmt(cost)}`,20,"#4569e8",800)}${textSvg(255,121,"principal",11)}${textSvg(255,208,`+ $${fmt(interest)} interest = $${fmt(total)}`,13,"#16897e",700)}`),math:`Simple interest I = P × R × T / 100<br>I = $${cost} × ${input}% × ${time} / 100 = <strong>$${fmt(interest)}</strong><br>Total = P + I = <strong>$${fmt(total)}</strong>`,explain:`Simple interest is calculated on the original principal only. Rate is percent per year; time is in years.`}}let diff=input-cost,profit=diff>=0;return{visual:svgWrap(`<rect x="90" y="69" width="135" height="96" rx="14" fill="#fff1df"/><rect x="295" y="69" width="135" height="96" rx="14" fill="#e9f8f5"/>${textSvg(157,105,`Cost $${cost}`,13,"#9b6828",700)}${textSvg(157,130,"buy",11)}${textSvg(362,105,`Sell $${input}`,13,"#16897e",700)}${textSvg(362,130,"sell",11)}${lineSvg(225,118,295,118,"#b7c2d2",2,"5 4")}${textSvg(260,202,`${profit?"Profit":"Loss"}: $${fmt(Math.abs(diff))}`,16,profit?"#16897e":"#c75d53",800)}`),math:`${profit?"Profit":"Loss"} = |selling price − cost price|<br>= |$${input} − $${cost}| = <strong>$${fmt(Math.abs(diff))} ${profit?"profit":"loss"}</strong>${profit&&cost?`<br>Profit % = ${fmt(diff)} ÷ ${cost} × 100 = ${fmt(diff/cost*100)}%`:""}`,explain:`Compare the selling price with the cost price. A higher selling price means profit; a lower one means loss.`}}
 case"solid":{let l=n(v.length),w=n(v.width),h=n(v.height),vol=l*w*h,sa=2*(l*w+l*h+w*h),net=`<g fill="#eef2ff" stroke="#8193c5" stroke-width="1.5"><rect x="407" y="126" width="17" height="22"/><rect x="424" y="126" width="17" height="22"/><rect x="441" y="126" width="17" height="22"/><rect x="458" y="126" width="17" height="22"/><rect x="424" y="104" width="17" height="22"/><rect x="424" y="148" width="17" height="22"/></g>`;return{visual:svgWrap(`<g fill="#e5edff" stroke="#5574e9" stroke-width="2"><polygon points="180,76 330,76 370,105 220,105"/><polygon points="180,76 220,105 220,190 180,160"/><polygon points="220,105 370,105 370,190 220,190"/></g>${textSvg(255,60,`${l} cm`,11,"#4569e8",700)}${textSvg(389,149,`${w} cm`,11,"#4569e8",700,"start")}${textSvg(198,180,`${h} cm`,11,"#4569e8",700)}${textSvg(441,88,"Net",11,"#53617a",700)}${net}${textSvg(441,188,"6 faces",10,"#53617a",700)}`),math:`Volume = l × w × h = ${l} × ${w} × ${h} = <strong>${vol} cm³</strong><br>Surface area = 2(lw + lh + wh) = <strong>${sa} cm²</strong>`,explain:`A cuboid's volume counts cubic centimetres inside it. Surface area adds the areas of all 6 rectangular faces. The net shows the six faces laid flat; fold along shared edges to rebuild the solid.`}}
 case"powers":{let x=n(v.number),sq=x*x,cube=x*x*x,body="";for(let i=0;i<x;i++)for(let j=0;j<x;j++)body+=`<rect x="${65+j*17}" y="${45+i*17}" width="16" height="16" fill="${(i+j)%2?"#7f98ed":"#a8b8f5"}" stroke="#fff"/>`;let result=v.power==="Square"?`${x}² = ${sq}`:v.power==="Square root"?`√${sq} = ${x}`:`${x}³ = ${cube}`,operand=n(v.operand),op=v.operation==="Add"?"+":v.operation==="Subtract"?"−":"×",lineResult=v.operation==="Add"?x+operand:v.operation==="Subtract"?x-operand:x*operand,lineX=q=>50+(Math.max(-10,Math.min(10,q))+10)*21.5,axis="";for(let t=-10;t<=10;t+=5)axis+=lineSvg(lineX(t),252,lineX(t),259,"#9ba8ba")+textSvg(lineX(t),276,t,9);return{visual:svgWrap(`${body}${textSvg(315,72,`${x} × ${x} square`,12,"#4569e8",800)}${textSvg(315,98,`Area = ${sq} square units`,11)}${textSvg(315,137,`Cube = ${cube} cubic units`,11,"#16897e",700)}${textSvg(315,163,result,13,"#4569e8",800)}${textSvg(260,207,`Number line: ${x} ${op} (${operand}) = ${lineResult}`,11,"#53617a",700)}${lineSvg(50,252,480,252,"#bdc8d8")}${axis}${lineSvg(lineX(x),238,lineX(lineResult),238,"#10a998",3)}${circle(lineX(x),238,5,"#fff","#10a998")}${circle(lineX(lineResult),238,6,"#4569e8")}`, "0 0 520 290"),math:`Square: ${x} × ${x} = <strong>${sq}</strong><br>Square root: √${sq} = <strong>${x}</strong><br>Cube: ${x} × ${x} × ${x} = <strong>${cube}</strong><br>Selected: <strong>${result}</strong><br>Number-line operation: ${x} ${op} (${operand}) = <strong>${lineResult}</strong>.`,explain:`A square number is the area of a square array. The square root reverses squaring; a cube multiplies the number by itself three times. The lower number line shows the selected operation.`}}
 case"variation":{let d=n(v.distance),s=n(v.speed),time=d/s,rows=[30,60,90].map(speed=>[speed,fmt(d/speed)]),coords=rows.map((r,i)=>[115+i*135,178-(Number(r[1])/Math.max(1,d/30))*110]),curve=coords.map((p,i)=>`${i?"L":"M"}${p[0]} ${p[1]}`).join(" "),points=coords.map((p,i)=>`${circle(p[0],p[1],5,"#4569e8")}${textSvg(p[0],202,`${rows[i][0]} km/h`,10)}${textSvg(p[0],p[1]-10,rows[i][1],9,"#53617a",700)}`).join("");return{visual:svgWrap(`${lineSvg(75,178,455,178,"#aab5c5")}${lineSvg(75,48,75,178,"#aab5c5")}${`<path d="${curve}" fill="none" stroke="#a8b7e5" stroke-width="2"/>`}${points}${textSvg(245,25,"Fixed distance: speed rises, time falls",12,"#53617a",700)}${textSvg(47,65,"time",10)}`),math:`Travel time = distance ÷ speed<br>= ${d} km ÷ ${s} km/h = <strong>${fmt(time)} h</strong><br>Direct: distance = speed × time<br>Inverse (fixed distance): speed × time = ${d}.`,explain:`For the same trip, doubling speed halves travel time: speed and time vary inversely. Units cancel as km ÷ (km/h) = hours.`,table:rows}}
 case"polygon":{let sides=n(v.sides),r=n(v.radius)*12,pts=[];for(let i=0;i<sides;i++){let t=-Math.PI/2+2*Math.PI*i/sides;pts.push([260+r*Math.cos(t),116+r*Math.sin(t)])}let p=pts.map(x=>x.join(",")).join(" "),sum=(sides-2)*180;let lines=pts.map((q,i)=>lineSvg(q[0],q[1],260,116,"#b8c5e0",1,"4 3")).join(""),grid="";for(let gx=140;gx<=380;gx+=30)grid+=lineSvg(gx,20,gx,206,gx===260?"#bac5d7":"#e6eaf1",gx===260?1.5:1);for(let gy=26;gy<=206;gy+=30)grid+=lineSvg(140,gy,380,gy,gy===116?"#bac5d7":"#e6eaf1",gy===116?1.5:1);let net=v.solid==="Cube net"?`<g fill="#e1e9ff" stroke="#7890c8" stroke-width="1.5"><rect x="419" y="78" width="18" height="18"/><rect x="419" y="96" width="18" height="18"/><rect x="401" y="96" width="18" height="18"/><rect x="437" y="96" width="18" height="18"/><rect x="455" y="96" width="18" height="18"/><rect x="419" y="114" width="18" height="18"/></g>`:`<g fill="#e1e9ff" stroke="#7890c8" stroke-width="1.5"><rect x="404" y="91" width="22" height="52"/><rect x="426" y="91" width="22" height="52"/><rect x="448" y="91" width="22" height="52"/><polygon points="404,91 415,72 426,91"/><polygon points="404,143 415,162 426,143"/></g>`;return{visual:svgWrap(`${grid}<polygon points="${p}" fill="#edf1ff" stroke="#4569e8" stroke-width="3"/>${lines}${circle(260,116,4,"#10a998")}${textSvg(260,220,`${sides}-sided polygon • centre shown on coordinate grid`,11,"#53617a",700)}${textSvg(438,54,v.solid,10,"#53617a",700)}${net}`),math:`Interior angle sum = (n − 2) × 180°<br>= (${sides} − 2) × 180° = <strong>${sum}°</strong><br>Regular polygon angle = ${sum}° ÷ ${sides} = <strong>${fmt(sum/sides)}°</strong>`,explain:`Join a polygon's centre to each vertex to split it into triangles. This gives an interior angle sum of (n − 2) × 180°. The selected net can fold into a ${v.solid==="Cube net"?"cube":"triangular prism"}.`}}
 case"mensuration":{let x=n(v.length),w=n(v.width),h=n(v.height),svg,math,explain;if(v.shape==="Circle"){let r=x;svg=svgWrap(`${circle(250,110,r*9,"#edf1ff","#5574e9")}${lineSvg(250,110,250+r*9,110,"#10a998",2)}${textSvg(250+r*4.5,102,`r = ${r} cm`,11,"#16897e",700)}${textSvg(250,210,"Circle",12,"#53617a",700)}`);math=`Circumference = 2πr = 2π(${r}) = <strong>${fmt(2*Math.PI*r)} cm</strong> (rounded)<br>Area = πr² = π(${r})² = <strong>${fmt(Math.PI*r*r)} cm²</strong> (rounded)`;explain="For a circle, π is approximately 3.14159. These decimal measurements are rounded to 2 decimal places."}else if(v.shape==="Cuboid"){let vol=x*w*h,sa=2*(x*w+x*h+w*h);svg=svgWrap(`<polygon points="170,72 315,72 360,104 215,104" fill="#eef2ff" stroke="#5574e9" stroke-width="2"/><polygon points="170,72 215,104 215,185 170,153" fill="#dce6ff" stroke="#5574e9" stroke-width="2"/><polygon points="215,104 360,104 360,185 215,185" fill="#e8efff" stroke="#5574e9" stroke-width="2"/>${textSvg(260,60,`${x} × ${w} × ${h} cm`,12,"#4569e8",700)}`);math=`Volume = lwh = ${x} × ${w} × ${h} = <strong>${vol} cm³</strong><br>Surface area = 2(lw + lh + wh) = <strong>${sa} cm²</strong>`;explain="Volume is measured in cubic units; surface area is measured in square units. A cuboid has three pairs of equal rectangular faces."}else{svg=svgWrap(`<rect x="${260-x*10}" y="${110-w*8}" width="${x*20}" height="${w*16}" rx="2" fill="#eaf0ff" stroke="#5574e9" stroke-width="3"/>${textSvg(260,81,`${x} cm`,11,"#4569e8",700)}${textSvg(260+x*10+12,115,`${w} cm`,11,"#4569e8",700,"start")}`);math=`Perimeter = 2(l + w) = 2(${x} + ${w}) = <strong>${2*(x+w)} cm</strong><br>Area = l × w = ${x} × ${w} = <strong>${x*w} cm²</strong>`;explain="A rectangle's perimeter adds its four side lengths; its area multiplies length by width."}return{visual:svg,math,explain}}
 case"probability":{let c=v.chance,counts=c==="Coin flips"?[state.outcomes.filter(x=>x===1).length,state.outcomes.filter(x=>x===0).length]:[1,2,3,4,5,6].map(i=>state.outcomes.filter(x=>x===i).length),labels=c==="Coin flips"?["Heads","Tails"]:["1","2","3","4","5","6"],max=Math.max(1,...counts),total=state.outcomes.length,colors=["#10a998","#8199eb","#f4a340","#eb7184","#9673dc","#51a1ce"];let chart;if(v.chart==="Bar chart"){chart=counts.map((x,i)=>`<rect x="${60+i*(400/counts.length)}" y="${174-x/max*105}" width="${Math.min(38,360/counts.length)}" height="${x/max*105}" rx="3" fill="${colors[i]}"/>${textSvg(78+i*(400/counts.length),195,labels[i],10)}${textSvg(78+i*(400/counts.length),Math.max(62,164-x/max*105),x,9,"#52617a",700)}`).join("")+lineSvg(47,175,472,175,"#b5bfce")}else if(v.chart==="Line graph"){let pts=counts.map((x,i)=>[70+i*(380/Math.max(1,counts.length-1)),170-x/max*110]),d=pts.map((p,i)=>`${i?"L":"M"}${p[0]} ${p[1]}`).join(" ");chart=lineSvg(48,175,474,175,"#b5bfce")+lineSvg(48,55,48,175,"#b5bfce")+`<path d="${d}" fill="none" stroke="#4569e8" stroke-width="3"/>`+pts.map((p,i)=>circle(p[0],p[1],5,colors[i])+textSvg(p[0],195,labels[i],10)+textSvg(p[0],p[1]-10,counts[i],9,"#53617a",700)).join("")}else if(total){let angle=-Math.PI/2,cx=260,cy=118,r=74;chart=counts.map((count,i)=>{if(!count)return"";let next=angle+count/total*Math.PI*2,x1=cx+r*Math.cos(angle),y1=cy+r*Math.sin(angle),x2=cx+r*Math.cos(next),y2=cy+r*Math.sin(next),large=next-angle>Math.PI?1:0,d=counts[i]===total?`M${cx-r} ${cy} A${r} ${r} 0 1 0 ${cx+r} ${cy} A${r} ${r} 0 1 0 ${cx-r} ${cy}`:`M${cx} ${cy} L${x1} ${y1} A${r} ${r} 0 ${large} 1 ${x2} ${y2} Z`;let mid=(angle+next)/2,labelX=cx+(r+19)*Math.cos(mid),labelY=cy+(r+19)*Math.sin(mid);angle=next;return`<path d="${d}" fill="${colors[i]}" stroke="#fff" stroke-width="2"/>${textSvg(labelX,labelY,`${labels[i]} ${fmt(count/total*100,0)}%`,9,"#4d5a70",700)}`}).join("")}else chart=textSvg(260,120,"Add outcomes to build the chart",13,"#66748b",700);return{visual:svgWrap(`${chart}${textSvg(260,28,`${c} • ${total} outcomes • ${v.chart}`,12,"#53617a",700)}`),math:total?`Outcomes collected: <strong>${total}</strong><br>${c==="Coin flips"?`Heads: ${counts[0]}/${total} = ${fmt(counts[0]/total*100,1)}% (expected 50%)`:`Sixes: ${counts[5]}/${total} = ${fmt(counts[5]/total*100,1)}% (expected about 16.7%)`}<br>Expected chance: ${c==="Coin flips"?"1/2 = 50%":"1/6 ≈ 16.7%"}`:`Expected: ${c==="Coin flips"?"Heads = 1/2 = 50%":"A six = 1/6 ≈ 16.7%"}<br>Add outcomes to compare experimental and expected probability.`,explain:`${v.chart} displays observed frequencies in different ways. Expected probability describes the long-run chance. A small sample may vary; with more independent trials, relative frequency often gets closer to the expected probability.`,counts,labels}}
 default:return{visual:"",math:"",explain:""}
 }
}
function randomInt(min,max){return min+Math.floor(Math.random()*(max-min+1))}
function numericQuestion(prompt,answer,hint,explanation){
 answer=round(answer);let options=[answer];
 while(options.length<4){let offset=randomInt(1,Math.max(3,Math.ceil(Math.abs(answer)*.35)+2));let candidate=round(answer+(Math.random()<.5?-offset:offset));if(!options.includes(candidate))options.push(candidate)}
 return choiceQuestion(prompt,fmt(answer),options.slice(1).map(x=>fmt(x)),hint,explanation);
}
function choiceQuestion(prompt,correct,distractors,hint,explanation){
 const options=[String(correct)];
 distractors.forEach(option=>{option=String(option);if(!options.includes(option))options.push(option)});
 ["None of these","All are correct","0","100%"].forEach(option=>{if(options.length<4&&!options.includes(option))options.push(option)});
 for(let i=options.length-1;i>0;i--){let j=randomInt(0,i);[options[i],options[j]]=[options[j],options[i]]}
 return{prompt,options,answer:options.indexOf(String(correct)),hint,explanation};
}
function makeTopicQuestion(activity,level){
 const r=(lo,hi)=>randomInt(lo,hi),a=activity.id;let x,y,z,prompt,answer,hint,explanation;
 switch(a){
 case 1:
  if(level<=5){x=r(-level,level);y=r(-level,level);let sub=Math.random()<.5;answer=sub?x-y:x+y;prompt=`Calculate ${x} ${sub?"−":"+"} (${y}).`;hint="On a number line, addition moves right for a positive number and left for a negative number.";explanation=`Starting at ${x}, ${sub?"subtracting":"adding"} ${y} gives ${answer}.`}
  else if(level<=8){x=r(-12,12);y=r(-12,12);answer=Math.abs(x-y);prompt=`What is the distance between ${x} and ${y} on a number line?`;hint="Distance is the absolute value of the difference between the two positions.";explanation=`|${x} − (${y})| = ${answer} units.`}
  else{x=r(-15,15);y=r(-15,15);answer=Math.max(x,y);prompt=`Which is greater: ${x} or ${y}?`;hint="The number farther to the right on a number line is greater.";explanation=`${answer} is farther right, so it is the greater number.`}
  return numericQuestion(prompt,answer,hint,explanation);
 case 2:{
  let denoms=[2,4,5,10],d1=denoms[r(0,3)],d2=denoms[r(0,3)],n1=r(1,d1),n2=r(1,d2),f1=n1/d1,f2=n2/d2;
  if(level<=3){let greater=f1>=f2?`${n1}/${d1}`:`${n2}/${d2}`;return choiceQuestion(`Which fraction is greater: ${n1}/${d1} or ${n2}/${d2}?`,greater,[`${n1}/${d1} + ${n2}/${d2}`,`${Math.min(f1,f2).toFixed(2)}`,"They are always equal"],"Compare the fractions by making equivalent fractions or converting each to a decimal.",`${fmt(f1)} and ${fmt(f2)} are their decimal values; ${greater} is greater.`)}
  let add=level<=6,ans=add?f1+f2:f1-f2;return numericQuestion(`Find ${n1}/${d1} ${add?"+":"−"} ${n2}/${d2}. Give a decimal to two places.`,ans,"Use a common denominator, then convert the result to a decimal if needed.",`${n1}/${d1} ${add?"+":"−"} ${n2}/${d2} = ${fmt(ans)} (rounded to 2 decimal places).`);
 }
 case 3:{
  let one=r(2,7),mult=r(2,level+1),target=one*mult;answer=target;prompt=`A recipe uses ${one} cups of flour for 1 batch. How many cups are needed for ${mult} batches?`;hint="Multiply the amount for one batch by the number of batches.";explanation=`${one} × ${mult} = ${answer} cups. Both recipe quantities scale by the same factor.`;return numericQuestion(prompt,answer,hint,explanation);
 }
 case 4:{
  let coef=r(1,Math.min(7,level+1)),solution=r(1,level+3),extra=level<4?0:r(1,12),total=coef*solution+extra;prompt=extra?`Solve ${coef}x + ${extra} = ${total}.`:`Solve ${coef}x = ${total}.`;hint=extra?`Subtract ${extra} from both sides, then divide by ${coef}.`:`Divide both sides by ${coef}.`;explanation=`${coef}x = ${total-extra}; x = (${total-extra}) ÷ ${coef} = ${solution}.`;return numericQuestion(prompt,solution,hint,explanation);
 }
 case 5:{
  if(level<=5){x=r(25,95);y=r(20,150-x);answer=180-x-y;prompt=`A triangle has angles ${x}° and ${y}°. Find its third angle.`;hint="The three interior angles in a triangle add to 180°.";explanation=`180° − ${x}° − ${y}° = ${answer}°.`}
  else{x=r(55,125);y=r(45,130);z=r(40,Math.max(40,300-x-y));answer=360-x-y-z;prompt=`Three angles of a quadrilateral are ${x}°, ${y}°, and ${z}°. Find the fourth.`;hint="A quadrilateral's interior angles add to 360°.";explanation=`360° − ${x}° − ${y}° − ${z}° = ${answer}°.`}
  return numericQuestion(prompt,answer,hint,explanation);
 }
 case 6:{
  if(level<=3){x=r(2,level+3);y=r(2,level+2);answer=x*y;prompt=`A rectangle is ${x} cm long and ${y} cm wide. What is its area in cm²?`;hint="Multiply length by width for area.";explanation=`${x} × ${y} = ${answer} cm².`}
  else if(level<=6){x=r(4,level+4);y=r(3,level+3);answer=2*(x+y);prompt=`A rectangle is ${x} cm long and ${y} cm wide. What is its perimeter in cm?`;hint="Add all four sides, or use 2 × (length + width), for perimeter.";explanation=`2 × (${x} + ${y}) = ${answer} cm.`}
  else if(level<=8){x=r(5,level+5);y=r(3,level+3);answer=y;prompt=`A rectangle has area ${x*y} cm² and length ${x} cm. What is its width in cm?`;hint="Area = length × width, so divide the area by the known length.";explanation=`${x*y} ÷ ${x} = ${answer} cm.`}
  else{x=r(5,level+5);y=r(4,level+4);answer=y;prompt=`A rectangle's perimeter is ${2*(x+y)} cm and its length is ${x} cm. What is its width?`;hint="First halve the perimeter to get length + width, then subtract the length.";explanation=`${2*(x+y)} ÷ 2 − ${x} = ${answer} cm.`}
  return numericQuestion(prompt,answer,hint,explanation);
 }
 case 7:{
  let base=r(20,200),pct=level<=3?[10,20][r(0,1)]:[15,25,30,50][r(0,3)];let saved=base*pct/100;
  if(level<=6){answer=saved;prompt=`A ${pct}% discount is taken off $${base}. How many dollars are saved?`;hint=`Find ${pct}/100 of $${base}. Convert the percent to a decimal and multiply.`;explanation=`${pct}% of $${base} = ${pct}/100 × ${base} = $${fmt(answer)}.`}
  else{answer=level%2===0?base-saved:pct;prompt=level%2===0?`A ${pct}% discount is taken off $${base}. What is the sale price?`:`A $${fmt(saved)} discount is given on an item priced at $${base}. What percent is saved?`;hint=level%2===0?"Find the discount amount, then subtract it from the original price.":"Divide the savings by the original price, then multiply by 100%.";explanation=level%2===0?`Discount = ${pct}% of $${base} = $${fmt(saved)}; sale price = $${base} − $${fmt(saved)} = $${fmt(answer)}.`:`$${fmt(saved)} ÷ $${base} × 100% = ${pct}%.`}
  return numericQuestion(prompt,answer,hint,explanation);
 }
 case 8:{
  let coef=r(1,Math.min(level+1,8)),value=r(1,level+2),constant=r(0,level+2);
  if(level<=4){answer=coef*value+constant;prompt=`If x = ${value}, evaluate ${coef}x + ${constant}.`;hint=`Substitute ${value} for x, multiply first, then add the constant.`;explanation=`${coef}(${value}) + ${constant} = ${answer}.`}
  else{answer=value;let total=coef*value+constant;prompt=`Solve ${coef}x + ${constant} = ${total}.`;hint=`Undo the constant first, then divide by the coefficient of x.`;explanation=`${coef}x = ${total} − ${constant} = ${coef*value}; x = ${value}.`}
  return numericQuestion(prompt,answer,hint,explanation);
 }
 case 9:{
  if(level<=5){x=r(25,155);answer=180-x;prompt=`One angle on a straight line is ${x}°. What is the adjacent angle?`;hint="Angles forming a straight line are supplementary: together they make 180°.";explanation=`180° − ${x}° = ${answer}°.`}
  else{x=r(25,120);y=r(25,150-x);answer=180-x-y;prompt=`A triangle has angles ${x}° and ${y}°. Find the third angle.`;hint="The interior angles in a triangle add to 180°.";explanation=`180° − ${x}° − ${y}° = ${answer}°.`}
  return numericQuestion(prompt,answer,hint,explanation);
 }
 case 10:{
  let pool=[
   ["What does a line of symmetry do to a figure?","It divides it into matching mirror halves",["It doubles its area","It changes all side lengths","It turns it into a circle"],"Imagine folding the figure along the line; the two halves should match.","A line of symmetry divides a figure into two matching mirror-image halves."],
   ["A reflection changes a triangle's side lengths. True or false?","False",["True","Only the longest side","Only when reflected twice"],"A reflection flips a figure but does not stretch it.","Reflections preserve every side length and angle."],
   ["How many lines of symmetry does a square have?","4",["1","2","8"],"Count the vertical, horizontal, and two diagonal mirror lines.","A square has 4 lines of symmetry."],
   ["A rectangle that is not a square has how many lines of symmetry?","2",["1","3","4"],"Its vertical and horizontal midlines are mirror lines; the diagonals are not.","A non-square rectangle has 2 lines of symmetry."],
   ["A shape is turned 90° without stretching or resizing. Is the image congruent to the original?","Yes",["No","Only if it is a square","Only if it is not reflected"],"A rotation is a rigid transformation; it preserves lengths and angles.","A rotation changes orientation but not size or shape, so the figures are congruent."],
   ["A triangle is reflected across a line. Which property is preserved?","All side lengths and angles",["Only its area","Only one side length","No measurements"],"A reflection is a rigid movement, not a resize.","Reflections preserve the triangle's side lengths and angle measures."],
   ["An image is rotated and then reflected. What happens to its size?","It stays the same",["It doubles","It becomes half as large","It depends on the angle"],"Both operations are rigid transformations.","Rotations and reflections preserve size, so the figures remain congruent."],
   ["Two triangles have matching corresponding side lengths and angles. What is true?","They are congruent",["They must have different areas","They are only similar","They cannot be rotated"],"Congruent figures have the same shape and size; corresponding measurements match.","Matching corresponding sides and angles means the triangles are congruent."],
   ["A triangle is translated, rotated, and reflected. Which statement must be true?","It remains congruent to its original",["Its side lengths change","Its area doubles","It loses its vertices"],"Translation, rotation, and reflection are rigid motions.","A sequence of rigid motions preserves size and shape."],
   ["A shape is enlarged so its side lengths are twice as long. Is the image congruent to the original?","No; its side lengths changed",["Yes; every enlargement is congruent","Yes; its angles changed","No; it has fewer angles"],"Congruent figures must have equal corresponding side lengths as well as the same shape.","The enlargement changes size, so the image is not congruent even though it keeps the same shape."]
  ];let q=pool[level-1];return choiceQuestion(q[0],q[1],q[2],q[3],q[4]);
 }
 case 11:{
  if(level<=5){let cost=r(15,100),delta=r(5,Math.max(6,Math.floor(cost*.4))),profit=Math.random()<.65;answer=delta;prompt=profit?`An item costs $${cost} and sells for $${cost+delta}. Find the profit in dollars.`:`An item costs $${cost+delta} and sells for $${cost}. Find the loss in dollars.`;hint="Profit or loss is the difference between the selling price and cost price.";explanation=`The difference is $${delta}, so the ${profit?"profit":"loss"} is $${delta}.`}
  else{let principal=r(100,1200),rate=r(2,10),time=r(1,5);answer=principal*rate*time/100;prompt=`Find the simple interest on $${principal} at ${rate}% per year for ${time} years.`;hint="Use I = P × R × T / 100, with time in years.";explanation=`I = ${principal} × ${rate} × ${time} ÷ 100 = $${answer}.`}
  return numericQuestion(prompt,answer,hint,explanation);
 }
 case 12:{
  let l=r(2,level+3),w=r(2,level+2),h=r(2,level+1);
  if(level<=4){answer=l*w*h;prompt=`A cuboid is ${l} cm × ${w} cm × ${h} cm. What is its volume in cm³?`;hint="Volume of a cuboid = length × width × height.";explanation=`${l} × ${w} × ${h} = ${answer} cm³.`}
  else{answer=2*(l*w+l*h+w*h);prompt=`A cuboid is ${l} cm × ${w} cm × ${h} cm. What is its surface area in cm²?`;hint="Add the areas of all 3 pairs of equal faces: 2(lw + lh + wh).";explanation=`2(${l}×${w} + ${l}×${h} + ${w}×${h}) = ${answer} cm².`}
  return numericQuestion(prompt,answer,hint,explanation);
 }
 case 13:{
  if(level<=3){x=r(2,10);answer=x*x;prompt=`What is ${x}²?`;hint="A square means multiply the number by itself once.";explanation=`${x} × ${x} = ${answer}.`}
  else if(level<=5){x=r(2,10);answer=x;prompt=`What is √${x*x}?`;hint="A square root asks which positive number multiplied by itself gives the number under the root.";explanation=`${x} × ${x} = ${x*x}, so √${x*x} = ${answer}.`}
  else if(level<=8){x=r(2,7);answer=x*x*x;prompt=`What is ${x}³?`;hint="A cube means multiply the number by itself three times.";explanation=`${x} × ${x} × ${x} = ${answer}.`}
  else{x=r(-10,10);y=r(-8,8);answer=level===9?x+y:x-y;prompt=`Calculate ${x} ${level===9?"+":"−"} (${y}).`;hint="Use integer sign rules or move along a number line.";explanation=`${x} ${level===9?"+":"−"} (${y}) = ${answer}.`}
  return numericQuestion(prompt,answer,hint,explanation);
 }
 case 14:{
  let coef=r(1,Math.min(9,level+1)),solution=r(1,level+4),constant=level<3?0:r(1,15),right=coef*solution+constant;prompt=`Solve ${coef}x + ${constant} = ${right}.`;hint=`Apply the same inverse operations to both sides: subtract ${constant}, then divide by ${coef}.`;explanation=`${coef}x = ${right} − ${constant} = ${coef*solution}; x = ${solution}.`;return numericQuestion(prompt,solution,hint,explanation);
 }
 case 15:{
  if(level<=5){let speed=r(20,100),time=r(1,6),distance=speed*time;answer=level%2===1?distance/speed:distance/time;prompt=level%2===1?`A trip is ${distance} km at ${speed} km/h. How many hours does it take?`:`A trip is ${distance} km and takes ${time} hours. What is the speed in km/h?`;hint=level%2===1?"For a fixed trip, time = distance ÷ speed.":"Speed = distance ÷ time.";explanation=level%2===1?`${distance} ÷ ${speed} = ${answer} hours.`:`${distance} ÷ ${time} = ${answer} km/h.`}
  else{let workers=r(2,10),days=r(2,12),newWorkers=workers+r(1,workers);answer=workers*days/newWorkers;prompt=`${workers} workers finish a job in ${days} days. At the same rate, how many days for ${newWorkers} workers? Give a decimal to 2 places.`;hint="For a fixed job, workers × days stays constant.";explanation=`${workers} × ${days} ÷ ${newWorkers} = ${fmt(answer)} days.`}
  return numericQuestion(prompt,answer,hint,explanation);
 }
 case 16:{
  let sides=r(3,Math.min(10,level+3)),sum=(sides-2)*180;
  if(level<=6){answer=sum;prompt=`What is the interior angle sum of a ${sides}-sided polygon?`;hint="Split the polygon into triangles: angle sum = (number of sides − 2) × 180°.";explanation=`(${sides} − 2) × 180° = ${answer}°.`}
  else{answer=sum/sides;prompt=`A regular ${sides}-sided polygon has equal interior angles. How large is each angle in degrees?`;hint="First find the interior angle sum, then divide by the number of equal angles.";explanation=`(${sides} − 2) × 180° ÷ ${sides} = ${fmt(answer)}°.`}
  return numericQuestion(prompt,answer,hint,explanation);
 }
 case 17:{
  if(level<=2){x=r(2,8);y=r(2,7);answer=x*y;prompt=`Find the area of a ${x} cm by ${y} cm rectangle, in cm².`;hint="Rectangle area = length × width.";explanation=`${x} × ${y} = ${answer} cm².`}
  else if(level<=4){x=r(4,12);y=r(3,10);answer=2*(x+y);prompt=`Find the perimeter of a ${x} cm by ${y} cm rectangle, in cm.`;hint="Rectangle perimeter = 2 × (length + width).";explanation=`2(${x} + ${y}) = ${answer} cm.`}
  else if(level<=6){x=r(2,8);y=r(2,7);z=r(2,6);answer=x*y*z;prompt=`Find the volume of a ${x} cm × ${y} cm × ${z} cm cuboid, in cm³.`;hint="Multiply length × width × height.";explanation=`${x} × ${y} × ${z} = ${answer} cm³.`}
  else if(level<=8){x=r(2,8);y=r(2,7);z=r(2,6);answer=2*(x*y+x*z+y*z);prompt=`Find the surface area of a ${x} cm × ${y} cm × ${z} cm cuboid, in cm².`;hint="Use 2(lw + lh + wh) for the six faces.";explanation=`2(${x*y} + ${x*z} + ${y*z}) = ${answer} cm².`}
  else{x=r(2,10);let area=level===9;answer=area?3.14*x*x:2*3.14*x;prompt=area?`A circle has radius ${x} cm. Find its area using π ≈ 3.14, in cm².`:`A circle has radius ${x} cm. Find its circumference using π ≈ 3.14, in cm.`;hint=area?"Circle area = πr².":"Circle circumference = 2πr.";explanation=area?`3.14 × ${x}² ≈ ${fmt(answer)} cm² (rounded to 2 decimal places).`:`2 × 3.14 × ${x} = ${fmt(answer)} cm.`}
  return numericQuestion(prompt,answer,hint,explanation);
 }
 case 18:{
  let flips=r(8,30);if(flips%2)flips++;let heads=r(1,flips-1),chartA=r(2,9),chartB=r(2,9),chartC=r(2,9),rolls=6*r(2,8),f=r(2,6),sampleSize=20*f,percentHeads=5*r(2,17),evenRolls=2*r(8,25),sector=[10,20,25,50,75][r(0,4)],gcd=(m,n)=>n?gcd(n,m%n):m;
  let pool=[
   ["What is the probability of heads on a fair coin?","1/2",["1/4","1/3","1"],"There are 2 equally likely sides, and 1 is heads.","Favourable outcomes ÷ total outcomes = 1 ÷ 2 = 1/2."],
   [`A fair coin is flipped ${flips} times. About how many heads are expected?`,String(flips/2),[String(flips),String(Math.floor(flips/4)),String(flips/2+2)],"Expected heads are about half the flips for a fair coin.",`Half of ${flips} is ${flips/2}; this is an expectation, not a guarantee.`],
   ["What is the probability of rolling a 6 on a fair six-sided die?","1/6",["1/2","1/3","5/6"],"Only one of the six equally likely faces is a 6.","There is one favourable face out of six, so the probability is 1/6."],
   [`A bar chart shows ${chartA} red and ${chartB} blue counters. How many counters are there altogether?`,String(chartA+chartB),[String(Math.abs(chartA-chartB)),String(chartA*chartB),String(chartA+chartB+2)],"Add the counts shown by both bars.",`${chartA} + ${chartB} = ${chartA+chartB} counters.`],
   [`In ${flips} coin flips, heads appeared ${heads} times. What fraction of the flips were heads?`,`${heads/gcd(heads,flips)}/${flips/gcd(heads,flips)}`,["1/2","1/3","3/4"],"Write heads divided by all flips, then simplify the fraction.",`${heads}/${flips} simplifies to ${heads/gcd(heads,flips)}/${flips/gcd(heads,flips)}.`],
   [`For a fair die, what is the expected number of sixes in ${rolls} rolls?`,String(rolls/6),[String(rolls/3),String(rolls/2),String(Math.max(1,rolls/6-1))],"A six has probability 1/6, so take one sixth of the number of rolls.",`${rolls} × 1/6 = ${rolls/6} expected sixes.`],
   [`A chart records ${chartA}, ${chartB}, and ${chartC} outcomes in three categories. What is the experimental percentage for the first category?`,`${fmt(chartA/(chartA+chartB+chartC)*100,1)}%`,[`${fmt(chartB/(chartA+chartB+chartC)*100,1)}%`,`${fmt(chartC/(chartA+chartB+chartC)*100,1)}%`,"50%"],"Divide the first category's frequency by the total, then multiply by 100%.",`${chartA} ÷ (${chartA} + ${chartB} + ${chartC}) × 100% = ${fmt(chartA/(chartA+chartB+chartC)*100,1)}%.`],
   [`Heads occurred ${percentHeads} times in ${sampleSize} fair coin flips. What is the experimental percentage of heads?`,`${fmt(percentHeads/sampleSize*100,0)}%`,[`${fmt(percentHeads/sampleSize*100+10,0)}%`,`${fmt(percentHeads/sampleSize*100-10,0)}%`,"50%"],"Divide the number of heads by the total flips, then multiply by 100%.",`${percentHeads} ÷ ${sampleSize} × 100% = ${fmt(percentHeads/sampleSize*100,0)}%.`],
   [`A fair die is rolled ${evenRolls} times. About how many even results are expected?`,String(evenRolls/2),[String(evenRolls/6),String(evenRolls/3),String(evenRolls)],"Three of a fair die's six faces are even, so the probability is 1/2.",`${evenRolls} × 1/2 = ${evenRolls/2} expected even outcomes.`],
   [`A pie-chart sector represents ${sector}% of a circle. What is its central angle?`,`${sector*360/100}°`,[`${sector*3}°`,`${100-sector}°`,`${sector*2}°`],"A full circle is 360°. Multiply the percentage (as a decimal) by 360°.",`${sector}/100 × 360° = ${sector*360/100}°.`]
  ];let q=pool[level-1];return choiceQuestion(q[0],q[1],q[2],q[3],q[4]);
 }
 default:return choiceQuestion("What is the main idea in this activity?","Explore the model",["Skip the model","Ignore the values","Change nothing"],"Use the controls and inspect the visual.","The model connects the quantities and calculations.");
 }
}
function createTopicQuiz(activity){return{questions:Array.from({length:10},(_,i)=>makeTopicQuestion(activity,i+1)),index:0,score:0,complete:false}}
function quizFor(activity){if(!state.quizByTopic[activity.id])state.quizByTopic[activity.id]=createTopicQuiz(activity);return state.quizByTopic[activity.id]}
function answerTopicQuiz(choice){
 const activity=byId(state.activity),quiz=quizFor(activity),q=quiz.questions[quiz.index];if(!q||q.done)return;
 q.selected=choice;
 if(choice===q.answer){q.done=true;q.correct=true;if(!q.missed)quiz.score++;q.feedback=q.missed?"Correct after using the hint. This question was not counted as a first-try point.":"Correct!"; }
 else{q.missed=true;q.correct=false;q.feedback="Not quite. Here’s a hint; try another choice or continue when ready."}
 renderQuiz(activity);
}
function advanceTopicQuiz(){
 const activity=byId(state.activity),quiz=quizFor(activity),q=quiz.questions[quiz.index];if(q&&!q.done)q.done=true;
 if(quiz.index===quiz.questions.length-1)quiz.complete=true;else quiz.index++;
 renderQuiz(activity);
}
function retryTopicQuiz(){
 const activity=byId(state.activity);state.quizByTopic[activity.id]=createTopicQuiz(activity);renderQuiz(activity);
}
function renderQuiz(activity){
 const quiz=quizFor(activity),host=$("topicQuiz");
 if(quiz.complete){
  host.innerHTML=`<div class="card quiz-summary" style="display:block"><strong>Quiz complete · ${quiz.score} / 10 first-try points</strong><p>You answered all 10 questions for Class ${activity.grade} · ${esc(activity.title)}. ${quiz.score>=8?"Excellent work!":quiz.score>=5?"Good effort—review the hints and try again.":"Keep practising; the activity model can help."}</p><button class="button primary" id="retryQuiz" type="button">Retry with new questions</button></div>`;
  $("retryQuiz").onclick=retryTopicQuiz;return;
 }
 const q=quiz.questions[quiz.index],done=quiz.index+1,level=done<=3?"Getting started":done<=6?"Building skills":done<=8?"Stretch": "Challenge";
 host.innerHTML=`<article class="card quiz-card topic-quiz-card"><div class="quiz-progress-row"><div><div class="qnum">Class ${activity.grade} · ${esc(activity.title)}</div><strong>Question ${done} of 10 <span class="difficulty">· ${level} ${done}/10</span></strong></div><div class="score" aria-live="polite">Score ${quiz.score}/10</div></div><div class="progress-track" role="progressbar" aria-label="Topic quiz progress" aria-valuemin="0" aria-valuemax="10" aria-valuenow="${done-1}"><div class="progress-fill" style="width:${(done-1)*10}%"></div></div><p class="topic-question">${esc(q.prompt)}</p><div class="quiz-options topic-options">${q.options.map((o,i)=>`<button type="button" data-choice="${i}" class="${q.selected===i?(q.correct?"correct":"incorrect"):""}" ${q.done?"disabled":""}>${esc(o)}</button>`).join("")}</div><div class="quiz-feedback ${q.correct===false?"wrong":""}" aria-live="polite">${q.feedback?`${esc(q.feedback)} ${q.correct?esc(q.explanation):""}`:"Choose the best answer."}</div>${q.missed?`<div class="quiz-hint"><strong>Hint:</strong> ${esc(q.hint)}<br><strong>Think it through:</strong> ${esc(q.explanation)}</div>`:""}<div class="topic-quiz-actions">${q.done||q.missed?`<button type="button" class="button primary" id="continueQuiz">${quiz.index===9?"See results":"Continue"}</button>`:""}<span>First-try score: ${quiz.score} / 10</span></div></article>`;
 host.querySelectorAll("button[data-choice]").forEach(button=>button.onclick=()=>answerTopicQuiz(Number(button.dataset.choice)));
 const next=$("continueQuiz");if(next)next.onclick=advanceTopicQuiz;
}
function renderAll(){
 renderNav();const a=byId(state.activity);if(!a)return;state.grade=a.grade;state.visited.add(a.id);$("crumb").textContent=`Class ${a.grade}`;
 const v=defaults(a);const prev=state.saved&&state.saved[a.id];if(prev)Object.assign(v,prev);
 const view=renderMath(a,v);
 const root=$("activityRoot");root.innerHTML=`<div class="activity-head"><div class="activity-title"><div class="topic-icon" aria-hidden="true">${a.icon}</div><div><h2>${esc(a.title)}</h2><p>${esc(a.desc)}</p></div></div><span class="topic-tag">CLASS ${a.grade} • ACTIVITY ${String(a.id).padStart(2,"0")}</span></div><div class="steps" aria-label="Learning steps"><span class="step"><b>1</b> Predict</span><span class="step"><b>2</b> Explore</span><span class="step"><b>3</b> Observe</span><span class="step"><b>4</b> Explain</span><span class="step"><b>5</b> Try again</span></div><section class="lab-grid"><div class="card visual-card"><div class="card-heading"><h3>Explore the model</h3><span>Live visual</span></div><div class="visual" id="visual">${view.visual}</div></div><div class="right-stack"><section class="card controls-card"><h3>Your controls</h3><div class="instruction">${esc(a.instruction)}</div><div class="prediction">Before you explore: what do you predict?</div><div id="controls">${a.controls.map(c=>controlMarkup(c,v)).join("")}</div><div class="button-row"><button class="button" id="resetBtn" type="button">↺ Reset</button><button class="button primary" id="tryBtn" type="button">Try another setting</button></div></section><section class="card explain-card"><h3>What is happening?</h3><div class="calc" id="math">${view.math}</div><p class="explanation" id="explanation">${view.explain}</p></section><section class="card thinking-card"><h3>Quick check</h3><p class="question">${esc(a.question)}</p><div class="answer-row"><input id="answerInput" type="text" aria-label="Your answer" placeholder="Type your answer"><button class="button primary" id="checkBtn" type="button">Check</button></div><div class="feedback" id="feedback" aria-live="polite"></div></section></div></section><section class="quiz-section"><div class="section-title"><h2>Topic quiz</h2></div><div id="topicQuiz" aria-live="polite"></div></section>`;
 if(view.table){$("math").innerHTML+=`<br><br><table class="data-table"><thead><tr><th>Speed (km/h)</th><th>Time (h)</th></tr></thead><tbody>${view.table.map(r=>`<tr><td>${r[0]}</td><td>${r[1]}</td></tr>`).join("")}</tbody></table>`}
 if(view.extraData){$("math").innerHTML+=`<br><button class="button" type="button" id="chartReset">Clear data</button>`}
 if(a.kind==="probability"){const btn=$("c-sample");btn.onclick=()=>{let count=Number($("c-sampleSize").value),dice=$("c-chance").value==="Dice rolls";for(let i=0;i<count;i++)state.outcomes.push(dice?Math.ceil(Math.random()*6):Math.floor(Math.random()*2));updateActivity()}}
 bindControls(a);$("resetBtn").onclick=()=>{if(a.kind==="probability")state.outcomes=[];if(a.kind==="rectangle")state.data=[3,5,2,6];state.saved=state.saved||{};delete state.saved[a.id];renderAll()};
 $("tryBtn").onclick=()=>{state.saved=state.saved||{};let current=getValues(a);a.controls.forEach(c=>{if(c[2]==="select"){let opts=c[3],i=opts.indexOf(String(current[c[0]]));current[c[0]]=opts[(i+1)%opts.length]}else if(c[2]!=="button"){let lo=c[2],hi=c[3],range=hi-lo;current[c[0]]=lo+((Number(current[c[0]])-lo+Math.max(1,Math.floor(range/3)))%(range+1))}});state.saved[a.id]=current;renderAll()};
 $("checkBtn").onclick=()=>{let answer=$("answerInput").value.trim().toLowerCase(),good=a.answer.some(x=>x.toLowerCase()===answer);$("feedback").textContent=good?"That’s right! Nice reasoning. Try changing a setting and see if you can explain why.":"Not quite yet. Use the live model and calculation as a clue, then try again."; $("feedback").className="feedback"+(good?"":" wrong")};
 $("answerInput").addEventListener("keydown",e=>{if(e.key==="Enter")$("checkBtn").click()});
 if($("c-data"))$("c-data").onclick=()=>{state.data.push(1+Math.floor(Math.random()*8));if(state.data.length>8)state.data.shift();updateActivity()};
 if($("chartReset"))$("chartReset").onclick=()=>{state.data=[3,5,2,6];updateActivity()};
 renderQuiz(a);renderNav();
}
function bindControls(a){if(a.kind==="geometry"||a.kind==="angles"){let angleA=$("c-angleA"),angleB=$("c-angleB");if(angleA&&angleB){angleB.max=String(160-Number(angleA.value));angleA.max=String(160-Number(angleB.value))}}a.controls.forEach(c=>{const el=$("c-"+c[0]);if(!el||c[2]==="button")return;const handler=()=>{if(c[2]!=="select")$("c-"+c[0]+"-out").textContent=el.value;if(a.kind==="geometry"||a.kind==="angles"){let angleA=$("c-angleA"),angleB=$("c-angleB");if(c[0]==="angleA"){angleB.max=String(160-Number(angleA.value));if(Number(angleB.value)>Number(angleB.max)){angleB.value=angleB.max;$("c-angleB-out").textContent=angleB.value}}else if(c[0]==="angleB"){angleA.max=String(160-Number(angleB.value));if(Number(angleA.value)>Number(angleA.max)){angleA.value=angleA.max;$("c-angleA-out").textContent=angleA.value}}}state.saved=state.saved||{};state.saved[a.id]=getValues(a);updateActivity()};el.addEventListener("input",handler);el.addEventListener("change",handler)})}
function updateActivity(){const a=byId(state.activity),v=getValues(a),view=renderMath(a,v);$("visual").innerHTML=view.visual;$("math").innerHTML=view.math;if(view.table)$("math").innerHTML+=`<br><br><table class="data-table"><thead><tr><th>Speed (km/h)</th><th>Time (h)</th></tr></thead><tbody>${view.table.map(r=>`<tr><td>${r[0]}</td><td>${r[1]}</td></tr>`).join("")}</tbody></table>`;if(view.extraData)$("math").innerHTML+=`<br><button class="button" type="button" id="chartReset">Clear data</button>`;$("explanation").textContent=view.explain;if($("chartReset"))$("chartReset").onclick=()=>{state.data=[3,5,2,6];updateActivity()}}
renderAll();
})();
</script>
</body>
</html>
