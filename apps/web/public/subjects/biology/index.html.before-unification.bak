<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101923">
<title>Biology Virtual Lab</title>
<style>
:root{color-scheme:dark;--bg:#101923;--panel:#17232e;--panel2:#1d2b37;--line:#30404c;--text:#eef4f3;--muted:#a2b1b8;--teal:#69e0c1;--orange:#ffb66d;--blue:#8ebcff;--red:#ff8c82;--radius:16px;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
*{box-sizing:border-box}body{margin:0;min-width:320px;min-height:100vh;background:radial-gradient(ellipse at 70% -14%,rgba(55,113,107,.2),transparent 40rem),var(--bg);color:var(--text)}button,input,select{font:inherit}button{color:inherit}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #f6c97b;outline-offset:3px}button:disabled{opacity:.5;cursor:not-allowed}
.shell{width:min(1420px,100%);margin:auto;padding:22px 30px 36px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:14px;padding-bottom:24px}.brand{display:flex;align-items:center;gap:12px}.brand-icon{display:grid;place-items:center;width:40px;height:40px;border:1px solid #38645e;border-radius:13px;background:#19342f;color:var(--teal);font-size:22px}.brand-title{font-size:14px;font-weight:800;letter-spacing:.04em}.brand-sub{margin-top:3px;color:var(--muted);font-size:11px}.offline{display:flex;align-items:center;gap:8px;color:#c0cbc9;font-size:11px}.offline-dot{width:7px;height:7px;border-radius:50%;background:var(--teal);box-shadow:0 0 10px #69e0c177}
.welcome{margin:3px 0 22px}.eyebrow{color:var(--teal);font-size:10px;font-weight:800;letter-spacing:.17em;text-transform:uppercase}.welcome h1{margin:7px 0 7px;font-size:clamp(28px,4vw,43px);letter-spacing:-.05em;line-height:1.08}.welcome p{max-width:680px;margin:0;color:var(--muted);font-size:14px;line-height:1.65}
.main-nav{display:flex;gap:7px;overflow:auto;padding:5px;border:1px solid var(--line);border-radius:14px;background:#17232ebd;scrollbar-width:thin}.nav-button{display:flex;align-items:center;justify-content:center;gap:8px;min-height:41px;padding:0 15px;border:1px solid transparent;border-radius:10px;background:transparent;color:#b1bec3;font-size:12px;font-weight:700;white-space:nowrap;cursor:pointer}.nav-button:hover{background:#ffffff08;color:var(--text)}.nav-button[aria-current="page"]{border-color:#69e0c133;background:#69e0c115;color:var(--teal)}.nav-count{display:inline-grid;place-items:center;min-width:20px;height:20px;padding:0 5px;border-radius:7px;background:#ffffff0c;color:#bcc8cb;font-size:10px}
.subject-switch{display:flex;gap:8px;margin:12px 0 4px}.subject-button{min-height:37px;padding:0 14px;border:1px solid var(--line);border-radius:10px;background:#17232e;color:#b8c5c8;font-size:11px;font-weight:750;cursor:pointer}.subject-button:hover{border-color:#536873;color:var(--text)}.subject-button[aria-pressed="true"]{border-color:#69e0c155;background:#69e0c118;color:var(--teal)}
.top-actions{display:flex;align-items:center;gap:9px}.plain-button,.primary-button,.secondary-button{min-height:39px;padding:0 13px;border:1px solid var(--line);border-radius:10px;background:var(--panel2);font-size:11px;font-weight:700;cursor:pointer}.plain-button:hover,.secondary-button:hover{border-color:#536873;background:#263743}.primary-button{border-color:transparent;background:var(--teal);color:#10221f}.primary-button:hover{background:#8aecd5}.small-button{min-height:34px;padding:0 11px;font-size:10px}
.home-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin-top:18px}.grade-card,.panel,.module-card,.quiz-box{border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(150deg,#1c2a36f5,#15212bf5);box-shadow:0 14px 40px #00000012}.grade-card{padding:21px;cursor:pointer;transition:transform .16s ease,border-color .16s ease}.grade-card:hover{transform:translateY(-2px);border-color:#56867e}.grade-card:focus-visible{outline:3px solid #f6c97b;outline-offset:3px}.grade-card-head{display:flex;align-items:center;justify-content:space-between}.grade-badge{display:grid;place-items:center;width:41px;height:41px;border-radius:13px;background:#69e0c11a;color:var(--teal);font-size:12px;font-weight:800}.grade-card h2{margin:15px 0 5px;font-size:19px;letter-spacing:-.03em}.grade-card p{min-height:42px;margin:0;color:var(--muted);font-size:11px;line-height:1.6}.card-bottom{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:18px;color:#ced8d8;font-size:10px}.progress-track{height:5px;flex:1;overflow:hidden;border-radius:6px;background:#354550}.progress-fill{height:100%;border-radius:6px;background:var(--teal);transition:width .2s ease}.module-count{color:#a7b5ba;font-size:10px;white-space:nowrap}
.grade-view{margin-top:18px}.grade-header{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:14px}.grade-kicker{color:var(--teal);font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.grade-header h2{margin:5px 0 3px;font-size:23px;letter-spacing:-.04em}.grade-header p{margin:0;color:var(--muted);font-size:11px}.grade-progress{display:flex;align-items:center;gap:9px;color:#c5d0d2;font-size:10px;white-space:nowrap}.grade-progress .progress-track{width:100px}
.grade-layout{display:grid;grid-template-columns:245px minmax(0,1fr);align-items:start;gap:15px}.topic-list{display:grid;gap:6px;padding:11px;border:1px solid var(--line);border-radius:14px;background:#17232eaf}.topic-link{display:flex;align-items:center;gap:9px;min-height:43px;padding:7px 9px;border:1px solid transparent;border-radius:9px;background:transparent;color:#c1cdd0;text-align:left;cursor:pointer}.topic-link:hover{background:#ffffff07}.topic-link[aria-current="true"]{border-color:#69e0c12b;background:#69e0c113;color:var(--teal)}.topic-number{display:grid;place-items:center;flex:0 0 24px;height:24px;border-radius:8px;background:#ffffff0b;color:#aab8bd;font-size:10px;font-weight:700}.topic-link[aria-current="true"] .topic-number{background:#69e0c11c;color:var(--teal)}.topic-text{font-size:10px;font-weight:650;line-height:1.35}
.module-card{min-width:0;overflow:hidden}.module-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:19px 20px 15px}.module-number{color:var(--teal);font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.module-head h3{margin:5px 0 6px;font-size:21px;letter-spacing:-.035em}.module-intro{max-width:800px;margin:0;color:#bdc9cd;font-size:12px;line-height:1.65}.simulation-tag{display:inline-flex;align-items:center;gap:6px;flex:0 0 auto;padding:7px 9px;border:1px solid #ffc16b2c;border-radius:8px;background:#ffc16b0b;color:#ffcc8d;font-size:9px;font-weight:700;white-space:nowrap}
.prediction-box{margin:0 15px 14px;padding:14px;border:1px solid #5b6548;border-radius:12px;background:linear-gradient(130deg,#293126,#202b2c)}.prediction-box h4{margin:0 0 6px;color:#ffe1a0;font-size:12px}.prediction-box p{margin:0;color:#cbd4ce;font-size:11px;line-height:1.55}.prediction-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:10px 0}.prediction-choice{min-height:38px;padding:8px 10px;border:1px solid #536050;border-radius:8px;background:#1a2828;color:#d4ded7;text-align:left;font-size:10px;cursor:pointer}.prediction-choice:hover{border-color:#e4c47f}.prediction-choice[aria-pressed=true]{border-color:#f0cb78;background:#f0cb7817}.prediction-submit{min-height:35px;padding:0 12px;border:0;border-radius:8px;background:#f0cb78;color:#20251d;font-size:10px;font-weight:750;cursor:pointer}.prediction-submit:disabled{opacity:.45;cursor:not-allowed}.prediction-saved{color:#a7ead5!important}.simulation-content[hidden]{display:none}
.canvas-shell{position:relative;height:clamp(265px,36vw,385px);min-height:240px;margin:0 15px;overflow:hidden;border:1px solid #293b45;border-radius:13px;background-color:#111d26;background-image:linear-gradient(#8ba8b10b 1px,transparent 1px),linear-gradient(90deg,#8ba8b10b 1px,transparent 1px);background-size:32px 32px}.canvas-shell canvas{display:block;width:100%;height:100%}.canvas-hint{position:absolute;top:10px;left:11px;padding:6px 8px;border:1px solid #80939b26;border-radius:7px;background:#101923d9;color:#b3c1c4;font-size:9px;pointer-events:none}.sim-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 19px 0;color:#9eafb4;font-size:9px;line-height:1.5}.sim-disclaimer{color:#ffcb90;text-align:right}
.module-lower{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,.8fr);gap:13px;padding:15px 15px 17px}.control-box,.observation-box{padding:13px;border:1px solid #30404c;border-radius:12px;background:#111b24a3}.box-title{margin:0 0 11px;color:#e3ebea;font-size:11px;font-weight:750}.control-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px 15px}.control-item{min-width:0}.control-line{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:7px}.control-label{color:#c3ced1;font-size:10px;font-weight:600}.control-value{color:var(--teal);font-size:10px;font-weight:750;font-variant-numeric:tabular-nums;white-space:nowrap}.control-item select{width:100%;min-height:34px;padding:5px 28px 5px 9px;border:1px solid #354650;border-radius:8px;background:#1a2934;color:var(--text);font-size:10px}.control-item input[type=range]{width:100%;height:4px;margin:6px 0 3px;appearance:none;border-radius:9px;background:linear-gradient(90deg,var(--teal) var(--pct,50%),#394a55 var(--pct,50%));cursor:pointer}.control-item input[type=range]::-webkit-slider-thumb{width:14px;height:14px;appearance:none;border:3px solid #15232b;border-radius:50%;background:var(--teal);box-shadow:0 0 0 1px var(--teal)}.control-item input[type=range]::-moz-range-thumb{width:10px;height:10px;border:3px solid #15232b;border-radius:50%;background:var(--teal);box-shadow:0 0 0 1px var(--teal)}.range-minmax{display:flex;justify-content:space-between;color:#809198;font-size:8px}.toggle-row{display:flex;align-items:center;gap:9px;min-height:32px;color:#cbd5d6;font-size:10px}.toggle-row input{width:17px;height:17px;accent-color:var(--teal)}
.measurements{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}.measure-chip{display:flex;align-items:center;gap:5px;padding:7px 9px;border:1px solid #30414b;border-radius:8px;background:#192731;color:#aab9bd;font-size:9px}.measure-chip strong{color:#edf4f2;font-size:10px;font-variant-numeric:tabular-nums}.control-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.comparison-status{align-self:center;margin:0;color:#a9babd;font-size:9px;line-height:1.4}.comparison-results{margin-top:11px;padding:10px;border:1px solid #38534d;border-radius:9px;background:#142421}.comparison-results h5{margin:0 0 8px;color:#bcebdc;font-size:10px}.comparison-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.comparison-side{padding:8px;border:1px solid #304d46;border-radius:7px;background:#192b28}.comparison-side strong{color:#d8e9e3;font-size:9px}.comparison-side p{margin:5px 0 0;color:#b4c6bf;font-size:9px;line-height:1.5}.observation-box{display:flex;flex-direction:column;justify-content:space-between}.observation-box p{margin:0;color:#c3ced0;font-size:11px;line-height:1.65}.observation-box details{margin-top:9px;color:#aebdc0;font-size:10px}.observation-box summary{color:#8fe5cd;font-weight:650;cursor:pointer}.observation-box details p{margin-top:7px;font-size:10px}.what-happening{padding:10px;border:1px solid #30404c;border-radius:9px;background:#182630}.what-happening p{color:#c6d2d3}.what-values{margin-top:8px!important;color:#94e5ce!important;font-size:9px!important}.observation-check{margin-top:10px}.observation-check h5{margin:0 0 6px;color:#e3ebea;font-size:10px}.observation-check p{font-size:10px}.observation-options{display:grid;gap:6px;margin-top:8px}.observation-choice{padding:8px 9px;border:1px solid #3a4b56;border-radius:8px;background:#182630;color:#cbd5d6;text-align:left;font-size:9px;line-height:1.4;cursor:pointer}.observation-choice:hover:not(:disabled){border-color:#76baa9}.observation-choice:disabled{opacity:.52;cursor:not-allowed}.observation-choice[aria-pressed=true]{border-color:#69e0c1;background:#69e0c116}.observation-choice.is-correct{border-color:#69e0c1;color:#baf3df}.observation-choice.is-incorrect{border-color:#ff8c82;color:#ffd2cd}.observation-feedback{min-height:16px;margin-top:7px!important;color:#a9babd;font-size:9px!important}.observation-feedback.good{color:#8ce4c5}.observation-feedback.bad{color:#ffb0a7}
.formula-panel{grid-column:1/-1;padding:14px;border:1px solid #3a5360;border-radius:12px;background:linear-gradient(135deg,#1b2a34,#17242e)}.formula-panel h4{margin:0 0 11px;color:#c1e6dc;font-size:12px}.formula-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.formula-item{min-width:0;padding:9px 10px;border:1px solid #30434e;border-radius:9px;background:#13202a}.formula-item.settings{grid-column:1/-1}.formula-label{display:block;margin-bottom:4px;color:#9eb5bc;font-size:9px;font-weight:750;letter-spacing:.04em;text-transform:uppercase}.formula-value{margin:0;color:#e0e9e8;font-size:10px;line-height:1.55;white-space:pre-line;overflow-wrap:anywhere}.formula-item.result .formula-value{color:#9de8d2;font-weight:700}.formula-item.example .formula-value{color:#f0d39d}.formula-item.limit .formula-value{color:#bdc9cb}
.quiz-page{margin-top:18px}.quiz-top{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:14px}.quiz-top h2{margin:4px 0;font-size:24px}.quiz-top p{margin:0;color:var(--muted);font-size:11px}.quiz-box{padding:18px;margin-bottom:12px}.quiz-box h3{margin:0 0 12px;font-size:13px;line-height:1.5}.quiz-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.quiz-option{min-height:38px;padding:8px 10px;border:1px solid #3a4b56;border-radius:9px;background:#182630;color:#cbd5d6;text-align:left;font-size:10px;cursor:pointer}.quiz-option:hover:not(:disabled){border-color:#76baa9}.quiz-option[aria-pressed=true]{border-color:#69e0c1;background:#69e0c116;color:#e9f4f1}.quiz-option.correct{border-color:#69e0c1;background:#69e0c11c;color:#baf3df}.quiz-option.incorrect{border-color:#ff8c82;background:#ff8c8217;color:#ffd2cd}.answer-feedback{min-height:18px;margin-top:9px;color:#a9babd;font-size:10px;line-height:1.5}.answer-feedback.good{color:#8ce4c5}.answer-feedback.bad{color:#ffb0a7}.quiz-final{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px;border:1px solid #438174;border-radius:12px;background:#69e0c10d;color:#d4e4df;font-size:12px;font-weight:700}
.home-tip{margin-top:15px;padding:13px 15px;border:1px solid #30404c;border-radius:12px;background:#17232ebf;color:#afbdc0;font-size:11px;line-height:1.6}.home-tip strong{color:#e1e9e7}
.empty{padding:25px;text-align:center;color:var(--muted)}.biology-diagram-caption{margin:0 15px;padding:10px 13px;border:1px solid #30404c;border-radius:0 0 11px 11px;background:#17232e;color:#b9c9c8;font-size:10px;line-height:1.55}.biology-stage{display:flex;align-items:center;justify-content:center;min-height:100%;padding:20px}.biology-stage canvas{width:100%;height:100%;display:block}.topic-quiz-status{color:#a7ead5;font-size:10px}.quiz-progress{display:flex;align-items:center;gap:8px;margin:12px 0;color:#aab9bd;font-size:10px}.quiz-progress .progress-track{max-width:180px}.quiz-hint{margin:9px 0;padding:10px;border:1px solid #695940;border-radius:9px;background:#2b281f;color:#f0d39d;font-size:10px;line-height:1.5}.quiz-next-row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px}.biology-flow-label{font-size:10px;color:#a9babd}.sort-activity{margin-top:13px;padding:11px;border:1px solid #30404c;border-radius:10px;background:#182630}.sort-activity h5{margin:0 0 4px;color:#d9e7e2;font-size:10px}.sort-activity p{margin:0 0 9px;color:#a9babd;font-size:9px}.sort-groups{display:grid;grid-template-columns:repeat(auto-fit,minmax(125px,1fr));gap:7px}.sort-group{padding:8px;border:1px solid #354650;border-radius:8px;background:#111b24}.sort-group strong{display:block;margin-bottom:6px;color:#9be0ca;font-size:9px}.sort-organism{display:inline-block;margin:2px;padding:4px 6px;border-radius:6px;background:#25343b;color:#dce7e3;font-size:9px}
@media(max-width:950px){.shell{padding:19px 20px 30px}.grade-layout{grid-template-columns:205px minmax(0,1fr)}.module-lower{grid-template-columns:1fr}.observation-box{min-height:130px}.home-grid{gap:10px}.grade-card{padding:16px}}
@media(max-width:680px){.shell{padding:15px 13px 26px}.topbar{padding-bottom:18px}.top-actions .plain-button{min-height:35px;padding:0 9px;font-size:10px}.subject-button{flex:1;padding:0 9px}.home-grid{grid-template-columns:1fr}.grade-card p{min-height:0}.grade-card h2{margin-top:10px}.grade-card{padding:15px}.grade-layout{grid-template-columns:1fr}.topic-list{display:flex;gap:6px;overflow-x:auto;padding:8px;scroll-snap-type:x mandatory}.topic-link{flex:0 0 180px;scroll-snap-align:start}.grade-header{align-items:flex-start;flex-direction:column}.grade-progress{width:100%}.grade-progress .progress-track{flex:1}.module-head{padding:15px}.module-head h3{font-size:18px}.canvas-shell{height:310px;margin:0 10px}.module-lower{padding:11px}.sim-footer{padding:8px 13px 0}.control-grid{gap:12px}.formula-grid{grid-template-columns:1fr}.quiz-options{grid-template-columns:1fr}.quiz-top{align-items:flex-start;flex-direction:column}}
@media(max-width:390px){.shell{padding:12px 10px 20px}.offline{font-size:9px}.nav-button{padding:0 11px;font-size:11px}.module-head{flex-direction:column}.simulation-tag{align-self:flex-start}.canvas-shell{height:270px;min-height:240px}.control-grid{grid-template-columns:1fr}.home-grid{margin-top:12px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition-duration:.01ms!important}}
</style>
</head>
<body>
<main class="shell">
  <header class="topbar">
    <div class="brand"><div class="brand-icon" aria-hidden="true">✿</div><div><div class="brand-title">BIOLOGY VIRTUAL LAB</div><div class="brand-sub">Explore · Observe · Learn</div></div></div>
    <div class="top-actions"><span class="offline"><span class="offline-dot" aria-hidden="true"></span>Offline · virtual models</span><button class="plain-button" id="home-button" type="button">⌂ Home</button></div>
  </header>
  <section class="welcome" aria-labelledby="page-title"><div class="eyebrow">A little curiosity goes a long way</div><h1 id="page-title">Biology Virtual Lab</h1><p>Explore Biology in separate Class 6, 7 and 8 sections. Predict, investigate, observe and explain with safe, interactive models.</p></section>
  <nav class="main-nav" id="grade-nav" aria-label="Choose a class">
    <button class="nav-button" type="button" data-grade="home" aria-current="page">⌂ Home</button>
    <button class="nav-button" type="button" data-grade="6">Class 6 <span class="nav-count">6</span></button>
    <button class="nav-button" type="button" data-grade="7">Class 7 <span class="nav-count">6</span></button>
    <button class="nav-button" type="button" data-grade="8">Class 8 <span class="nav-count">5</span></button>
  </nav>
  <section id="home-view" aria-label="Choose a class"></section>
  <section id="grade-view" class="grade-view" hidden></section>
  <section id="quiz-view" class="quiz-page" hidden></section>
</main>
<script>
(() => {
"use strict";
const modules = [
  {id:"motion-distance",grade:6,title:"Motion and Measurement of Distances",short:"Motion & measuring distance",intro:"Motion is a change in an object's position. Explore a straight track, a circular path and a repeating back-and-forth journey; use the marks to compare distance.",observation:"How does the marked distance change when you change the speed or choose a different kind of path?",note:"A diagrammatic model: the moving marker stands for an object. A metre (m) is the SI unit of length.",controls:[{key:"path",label:"Type of motion",type:"select",value:"Straight line",options:["Straight line","Circular path","Back and forth"]},{key:"speed",label:"Speed",min:1,max:8,step:1,value:3,unit:"m/s"},{key:"distance",label:"Track length",min:2,max:12,step:1,value:8,unit:"m"}],learn:"A ruler is useful for short lengths; a measuring tape can follow curves; a metre scale is one metre long. Smaller lengths may be written in centimetres (cm) or millimetres (mm).",metrics:()=>{const v=vals("motion-distance");return [["Distance travelled",`${v.distance.toFixed(0)} m`],["Speed setting",`${v.speed.toFixed(0)} m/s`],["Path",v.path]]}},
  {id:"light-shadow",grade:6,title:"Light, Shadows and Reflections",short:"Light, shadows & reflection",intro:"Luminous objects make their own light. We see non-luminous objects when light reflects from them. Try different materials and follow how light forms a shadow.",observation:"What happens to the shadow when the object moves closer to the screen? What changes with each material?",note:"Light rays are drawn as straight lines. This simplified sketch is not to scale.",controls:[{key:"demo",label:"Light activity",type:"select",value:"Shadow",options:["Shadow","Pinhole camera","Plane mirror"]},{key:"material",label:"Material",type:"select",value:"Opaque",options:["Transparent","Translucent","Opaque"]},{key:"position",label:"Object position",min:1,max:9,step:1,value:5,unit:"steps"}],learn:"Transparent materials let most light pass through; translucent materials scatter some light; opaque materials block light. A pinhole camera forms an upside-down image. A plane mirror makes an upright virtual image with left and right reversed (lateral inversion).",metrics:()=>{const v=vals("light-shadow");return [["Demo",v.demo],["Material",v.material],["Light source","Luminous"]]}},
  {id:"electric-circuits",grade:6,title:"Electricity and Circuits",short:"Electricity & circuits",intro:"A bulb lights when it is connected in a complete, closed circuit. Explore a virtual cell, wires, bulb and switch; then test which sample materials conduct electricity.",observation:"Does the bulb glow when the switch is open? Which tested materials complete the virtual path?",note:"This is a low-voltage diagram, not a real wiring activity. Never experiment with mains electricity.",controls:[{key:"closed",label:"Switch",type:"toggle",value:true,on:"Closed",off:"Open"},{key:"material",label:"Test material",type:"select",value:"Copper",options:["Copper","Iron","Aluminium","Rubber","Plastic","Wood"]}],learn:"A cell provides electrical energy, connecting wires make a path, the bulb changes electrical energy to light, and a switch opens or closes the path. Metals usually conduct; rubber and many plastics are insulators.",metrics:()=>{const v=vals("electric-circuits");const conducts=["Copper","Iron","Aluminium"].includes(v.material);return [["Circuit",v.closed&&conducts?"Closed":"Incomplete"],["Bulb",v.closed&&conducts?"On":"Off"],[v.material,conducts?"Conductor":"Insulator"]]}},
  {id:"magnets",grade:6,title:"Fun with Magnets",short:"Fun with magnets",intro:"Magnets may occur naturally or be made by people. Explore poles, test familiar materials, and see how a compass needle responds to a nearby magnet.",observation:"Which materials are attracted? What happens when like poles face, compared with unlike poles?",note:"The magnetic field lines in this picture are a simplified drawing; a compass aligns with the field.",controls:[{key:"material",label:"Test material",type:"select",value:"Iron nail",options:["Iron nail","Steel paper clip","Wood","Plastic","Copper coin"]},{key:"poles",label:"Facing poles",type:"select",value:"North + South",options:["North + South","North + North","South + South"]},{key:"care",label:"Care tip",type:"select",value:"Store with keepers",options:["Store with keepers","Keep dry","Avoid repeated dropping"]}],learn:"Like poles repel and unlike poles attract. A compass needle is a small magnet. Natural lodestone is magnetic; bar magnets and horseshoe magnets are made in many shapes. Keep magnets away from delicate electronics and magnetic cards; store suitable bar magnets in pairs with soft-iron keepers.",metrics:()=>{const v=vals("magnets");const magnetic=["Iron nail","Steel paper clip"].includes(v.material);return [["Material",magnetic?"Magnetic":"Not magnetic"],["Poles",v.poles.includes("North + South")?"Attract":"Repel"],["Magnet care",v.care]]}},
  {id:"heat",grade:7,title:"Heat",short:"Heat",intro:"Temperature tells us how hot or cold something is, measured here in degrees Celsius (°C). Compare safe, virtual examples of heat transfer—no real hot objects are used.",observation:"How does the transfer pattern differ for conduction, convection and radiation? Which surface absorbs more radiation?",note:"The animation is conceptual. It does not show real temperatures or require touching hot objects.",controls:[{key:"transfer",label:"Heat transfer",type:"select",value:"Conduction",options:["Conduction","Convection","Radiation"]},{key:"temperature",label:"Warm sample",min:20,max:80,step:5,value:50,unit:"°C"},{key:"surface",label:"Surface colour",type:"select",value:"Dark",options:["Dark","Light"]}],learn:"A clinical thermometer is designed to measure body temperature; a laboratory thermometer measures temperatures in experiments and should be read while its bulb is in the sample. Conduction transfers heat through touching particles, convection by moving fluids, and radiation by waves. Dark surfaces absorb more radiant energy than light ones.",metrics:()=>{const v=vals("heat");return [["Cool reference","20 °C"],["Warm sample",`${v.temperature} °C`],["Transfer",v.transfer]]}},
  {id:"motion-time",grade:7,title:"Motion and Time",short:"Motion & time",intro:"Speed compares distance with time: speed = distance ÷ time. Change the values and compare the slopes on a distance–time graph. A simple pendulum also shows repeating motion.",observation:"How does the graph's slope change when speed increases? What happens to a pendulum's period when its length increases?",note:"The pendulum uses a small-angle model. The distance–time graph assumes steady speed.",controls:[{key:"distance",label:"Distance",min:10,max:100,step:10,value:60,unit:"m"},{key:"time",label:"Time taken",min:2,max:20,step:1,value:10,unit:"s"},{key:"length",label:"Pendulum length",min:.3,max:2,step:.1,value:1,unit:"m"}],learn:"Time is measured in seconds (s), minutes (min) or hours (h). Speed is often measured in metres per second (m/s) or kilometres per hour (km/h). For a small swing, a longer pendulum takes more time for one complete oscillation: T ≈ 2π√(L/g).",metrics:()=>{const v=vals("motion-time");return [["Speed",`${(v.distance/v.time).toFixed(2)} m/s`],["Pendulum period",`${(2*Math.PI*Math.sqrt(v.length/9.8)).toFixed(2)} s`],["Graph slope",`${(v.distance/v.time).toFixed(2)} m/s`]]}},
  {id:"current-effects",grade:7,title:"Electric Current and Its Effects",short:"Current & its effects",intro:"Current can heat a wire and create a magnetic effect. Explore familiar circuit symbols, a conceptual fuse, an electromagnet and an electric bell—entirely in simulation.",observation:"What changes when more current flows? How does the electromagnet change when the coil has more turns?",note:"Virtual low-voltage model only. A fuse is a safety device; never connect this diagram to a mains supply.",controls:[{key:"effect",label:"Demonstration",type:"select",value:"Heating effect",options:["Heating effect","Electromagnet","Electric bell","Circuit symbols"]},{key:"current",label:"Current setting",min:1,max:8,step:1,value:3,unit:"A"},{key:"turns",label:"Coil turns",min:5,max:30,step:5,value:15,unit:"turns"}],learn:"A fuse melts and breaks a circuit if excessive current flows. An electromagnet is a coil carrying current, often wrapped around an iron core. In an electric bell, an electromagnet attracts a moving arm, repeatedly making and breaking contact.",metrics:()=>{const v=vals("current-effects");return [["Demo",v.effect],["Current setting",`${v.current} A`],["Coil turns",`${v.turns}`]]}},
  {id:"light",grade:7,title:"Light",short:"Light",intro:"Light reflects from mirrors and bends when it passes between materials. Explore a ray sketch for mirrors and lenses, or split white light into the colours of a rainbow.",observation:"How does the image differ when you switch the optical element? What do the prism colours tell you about white light?",note:"Ray diagrams are simplified and not to scale; curved optical surfaces are drawn schematically.",controls:[{key:"element",label:"Optical element",type:"select",value:"Plane mirror",options:["Plane mirror","Concave mirror","Convex mirror","Convex lens","Concave lens","Prism"]},{key:"object",label:"Object distance",min:1,max:8,step:1,value:4,unit:"units"},{key:"size",label:"Object height",min:1,max:4,step:1,value:2,unit:"units"}],learn:"A plane mirror forms an upright virtual image of the same size, apparently as far behind the mirror as the object is in front. A concave mirror or convex lens can form a real image when the object is beyond the focus; a convex mirror and concave lens form upright, smaller virtual images. A prism separates white light into a spectrum of seven colours.",metrics:()=>{const v=vals("light");const virtual=["Plane mirror","Convex mirror","Concave lens"].includes(v.element)||v.element==="Prism";return [["Element",v.element],["Image (typical)",virtual?"Virtual":"Can be real"],["Object distance",`${v.object} units`]]}},
  {id:"electric-effects",grade:8,title:"Electricity: Heating, Magnetic, and Chemical Effects",short:"Electricity: three effects",intro:"Electric current can produce heating, magnetic and chemical effects. Explore a virtual circuit and see how a conducting liquid can support electroplating.",observation:"Which sample liquid allows current in this model? What changes on the object when the electroplating activity is selected?",note:"Conceptual simulation only. Do not handle real electricity or chemicals. Sample results are simplified examples.",controls:[{key:"demo",label:"Effect",type:"select",value:"Heating",options:["Heating","Magnetic","Liquid conduction","Electroplating"]},{key:"liquid",label:"Sample liquid",type:"select",value:"Salt solution",options:["Salt solution","Lemon solution","Distilled water","Vegetable oil"]},{key:"closed",label:"Virtual switch",type:"toggle",value:true,on:"Closed",off:"Open"}],learn:"Some liquids conduct because they contain charged particles. When current passes through a suitable solution, chemical changes can happen. In electroplating, a thin metal coating is deposited on an object. The model shows the idea only; real electroplating requires trained supervision and safe equipment.",metrics:()=>{const v=vals("electric-effects");const conducts=["Salt solution","Lemon solution"].includes(v.liquid);return [["Selected effect",v.demo],["Liquid",conducts?"Conducting model":"Poor conductor model"],["Coating",v.demo==="Electroplating"&&v.closed&&conducts?"Depositing":"Not depositing"]]}},
  {id:"forces",grade:8,title:"Exploring Forces",short:"Exploring forces",intro:"A force is a push or pull. It can change an object's motion or shape. Compare contact forces, such as a push or friction, with forces that act without touching.",observation:"Which forces need touching? Which can act across a gap? How does friction change the moving object's motion?",note:"Arrows show force direction and relative size, not exact measured forces.",controls:[{key:"force",label:"Force example",type:"select",value:"Muscular push",options:["Muscular push","Friction","Magnetic","Electrostatic","Gravitational"]},{key:"strength",label:"Force strength",min:1,max:10,step:1,value:5,unit:"N"},{key:"surface",label:"Surface",type:"select",value:"Rough",options:["Rough","Smooth"]}],learn:"Muscular force and friction are contact forces. Magnetic, electrostatic and gravitational forces are non-contact forces. Friction usually opposes sliding; a rougher surface often creates more friction. Gravity pulls objects towards Earth.",metrics:()=>{const v=vals("forces");const contact=["Muscular push","Friction"].includes(v.force);return [["Force",v.force],["Type",contact?"Contact":"Non-contact"],["Strength",`${v.strength} N`]]}},
  {id:"pressure-weather",grade:8,title:"Pressure, Winds, Storms, and Cyclones",short:"Pressure, wind & cyclones",intro:"Pressure is force spread over an area: pressure = force ÷ area. Explore surface pressure, fluid pressure, wind currents and a conceptual cyclone.",observation:"How does pressure change when you spread the same force over a larger area? How does fluid pressure change with depth?",note:"Weather drawings are simplified learning models, not forecasts or warnings. Follow local emergency guidance in real storms.",controls:[{key:"demo",label:"Model",type:"select",value:"Surface pressure",options:["Surface pressure","Fluid pressure","Wind currents","Cyclone"]},{key:"force",label:"Force",min:10,max:100,step:10,value:50,unit:"N"},{key:"area",label:"Area",min:1,max:10,step:1,value:5,unit:"cm²"},{key:"depth",label:"Fluid depth",min:1,max:10,step:1,value:4,unit:"m"}],learn:"For the same force, a smaller area means greater pressure. Air around us also exerts atmospheric pressure. Fluids exert pressure in all directions, and pressure increases with depth. Uneven heating of air can create convection currents and winds. A cyclone is a rotating storm around a low-pressure centre; this model does not predict weather. During severe weather, shelter indoors and follow official local advice.",metrics:()=>{const v=vals("pressure-weather");return [["Surface pressure",`${(v.force/v.area).toFixed(1)} N/cm²`],["Depth setting",`${v.depth} m`],["Wind model",v.demo==="Cyclone"?"Low-pressure centre":"Conceptual"]]}},
  {id:"sound",grade:8,title:"Sound",short:"Sound",intro:"Sound begins with vibrations and travels through a medium such as air, water or a solid. Adjust frequency and amplitude to explore pitch and loudness.",observation:"How does frequency affect pitch? How does amplitude affect loudness? What happens to sound when there is no medium?",note:"Wave shape and loudness are illustrative, not calibrated sound measurements. Keep real listening volumes comfortable.",controls:[{key:"medium",label:"Medium",type:"select",value:"Air (gas)",options:["Air (gas)","Water (liquid)","Solid","No medium"]},{key:"frequency",label:"Frequency",min:5,max:30000,step:5,value:440,unit:"Hz"},{key:"amplitude",label:"Amplitude",min:1,max:10,step:1,value:5,unit:"relative"},{key:"soundtype",label:"Compare",type:"select",value:"Music",options:["Music","Noise"]}],learn:"Frequency is the number of vibrations each second; higher frequency usually means higher pitch. Larger amplitude usually means louder sound. The voice box (larynx) vibrates to make voice. The outer ear collects sound; the eardrum vibrates and the tiny middle-ear bones pass that motion to the inner ear (cochlea), which sends signals along the auditory nerve. Sound cannot travel through a vacuum. Human hearing is roughly 20 Hz to 20,000 Hz; infrasound is below that range and ultrasound is above it. Very loud noise can harm hearing.",metrics:()=>{const v=vals("sound");return [["Pitch",v.frequency>1000?"High":v.frequency<200?"Low":"Mid-range"],["Loudness",v.amplitude>6?"Louder":"Softer"],["Hearing range",v.frequency<20?"Infrasound":v.frequency>20000?"Ultrasound":"Audible range"]]}},
  {id:"reflection-eye",grade:8,title:"Light: Reflection and the Human Eye",short:"Reflection & the human eye",intro:"Smooth surfaces reflect light in an orderly way; rough surfaces scatter it. Explore two mirrors and see a simple diagram of how the eye focuses light.",observation:"What happens to the number of reflected images as the mirror angle gets smaller? How does roughness change reflection?",note:"Mirror-image counts are ideal geometry; eye diagram is simplified and not to scale.",controls:[{key:"surface",label:"Reflecting surface",type:"select",value:"Smooth mirror",options:["Smooth mirror","Rough surface"]},{key:"mirrorAngle",label:"Angle between mirrors",min:20,max:180,step:10,value:90,unit:"°"},{key:"rays",label:"Incoming rays",min:1,max:5,step:1,value:3,unit:"rays"}],learn:"The cornea and lens bend light to focus an image on the retina. The iris controls pupil size; the optic nerve carries signals to the brain. Read in good light, take screen breaks, and never look directly at the Sun or bright lasers. Regular reflection comes from a smooth surface; a rough surface scatters reflected rays.",metrics:()=>{const v=vals("reflection-eye");return [["Surface",v.surface],["Mirror angle",`${v.mirrorAngle}°`],["Reflection",v.surface==="Rough surface"?"Scattered":"Regular"]]}},
  {id:"natural-phenomena",grade:8,title:"Some Natural Phenomena",short:"Some natural phenomena",intro:"Rubbing can transfer electric charge; charge interactions and lightning can be modelled safely here. Earthquakes begin when parts of Earth's crust move, sending waves from an underground focus.",observation:"How do like and unlike charges interact? Where do earthquake waves begin, and where is the epicentre?",note:"Lightning and earthquake drawings are conceptual—not forecasts, warnings or safety substitutes.",controls:[{key:"demo",label:"Explore",type:"select",value:"Charging by rubbing",options:["Charging by rubbing","Charge interaction","Lightning","Earthquake waves"]},{key:"charge",label:"Charge amount",min:1,max:8,step:1,value:4,unit:"units"},{key:"relation",label:"Charge pair",type:"select",value:"Unlike (+ / −)",options:["Unlike (+ / −)","Like (+ / +)"]}],learn:"Rubbing can transfer electrons between some materials, leaving opposite charges. Unlike charges attract; like charges repel. Lightning is a huge electrical discharge—during a storm go indoors, away from windows, and avoid open areas, tall isolated objects and water. During an earthquake: Drop, Cover and Hold On; if outside, move to an open area away from buildings and wires. Follow local authorities.",metrics:()=>{const v=vals("natural-phenomena");return [["Model",v.demo],["Charges",v.relation.startsWith("Unlike")?"Attract":"Repel"],["Earthquake origin","Underground focus"]]}},
];
const quizzes={
6:[
{q:"What is the SI unit of length?",options:["Metre (m)","Litre (L)","Second (s)","Kilogram (kg)"],answer:0,why:"The metre, symbol m, is the SI base unit for length."},
{q:"When does a bulb in a simple circuit light?",options:["When the circuit path is closed","When one wire is disconnected","Only when the switch is open","Whenever a cell is nearby"],answer:0,why:"Current can flow around a complete, closed path."},
{q:"Which statement about a plane mirror image is correct?",options:["It is virtual and upright","It is always upside-down","It makes its own light","It is always smaller"],answer:0,why:"A plane mirror forms an upright virtual image and reverses left and right."}
],
7:[
{q:"Which heat transfer can travel through empty space?",options:["Radiation","Conduction","Convection","None of these"],answer:0,why:"Radiation transfers energy by waves and does not need a material medium."},
{q:"A learner travels 60 m in 10 s. What is the average speed?",options:["6 m/s","50 m/s","0.6 m/s","600 m/s"],answer:0,why:"Speed = distance ÷ time = 60 ÷ 10 = 6 m/s."},
{q:"What can a fuse do if too much current flows?",options:["Melt and break the circuit","Make current unlimited","Turn current into sound","Store extra current"],answer:0,why:"A fuse is designed to melt and interrupt a circuit when current is excessive."}
],
8:[
{q:"A force of 20 N acts over 2 cm². What is the pressure?",options:["10 N/cm²","40 N/cm²","22 N/cm²","0.1 N/cm²"],answer:0,why:"Pressure = force ÷ area = 20 ÷ 2 = 10 N/cm²."},
{q:"Which is a non-contact force?",options:["Magnetic force","Friction","A hand pushing a box","A rope pulling a sled"],answer:0,why:"Magnetic force can act without the objects touching."},
{q:"What should you do during earthquake shaking indoors?",options:["Drop, Cover and Hold On","Run to a window","Use a lift","Stand under a doorway window"],answer:0,why:"Drop, Cover and Hold On helps protect you from falling objects. Follow local safety guidance."}
]};
const gradeInfo={6:{name:"Class 6",description:"Discover motion, light, simple circuits and magnets.",ids:["motion-distance","light-shadow","electric-circuits","magnets"]},7:{name:"Class 7",description:"Explore heat, motion and time, current effects and light.",ids:["heat","motion-time","current-effects","light"]},8:{name:"Class 8",description:"Investigate electricity, forces, weather, sound, light and natural phenomena.",ids:["electric-effects","forces","pressure-weather","sound","reflection-eye","natural-phenomena"]}};
const chemistryModules=[
 {id:"chem-materials",grade:6,title:"Materials Around Us",short:"Materials around us",intro:"Compare familiar natural and man-made materials. Virtual tests help describe how a material looks and behaves.",note:"Virtual observations only. Do not taste, touch or test real samples.",controls:[{key:"material",label:"Material sample",type:"select",value:"Salt crystals",options:["Wood block","Iron nail","Glass pane","Plastic ruler","Salt crystals","Sand grains"]},{key:"property",label:"Property to notice",type:"select",value:"Solubility",options:["Appearance","Lustre","Hardness","Transparency","Solubility"]}],prediction:{question:"Which virtual test can show whether salt dissolves in water?",options:["Observe the salt in a water sample","Look only at its color"]},challenge:{text:"Choose salt crystals and the solubility test. What do you notice?",values:{material:"Salt crystals",property:"Solubility"}},check:{question:"What does a solubility test show?",options:["Whether a material dissolves in a particular liquid","How shiny a material is","Whether it is transparent"],answer:0,hint:"Think about what happens to a sample placed in water.",why:"Solubility describes whether a material dissolves in a particular liquid."}},
 {id:"chem-temperature",grade:6,title:"Temperature and Its Measurement",short:"Temperature",intro:"Read a virtual thermometer and compare Celsius and Fahrenheit. A thermometer measures temperature—not heat.",note:"This is a virtual scale. Never touch or heat real substances for this activity.",controls:[{key:"temperature",label:"Sample temperature",min:-20,max:120,step:5,value:20,unit:"°C"},{key:"scale",label:"Scale",type:"select",value:"Celsius",options:["Celsius","Fahrenheit"]}],prediction:{question:"If the sample cools, what will happen to its thermometer reading?",options:["The reading will go down","The reading will go up"]},challenge:{text:"Set the sample to 20°C and read it on the Fahrenheit scale.",values:{temperature:20,scale:"Fahrenheit"}},check:{question:"What does a thermometer measure?",options:["Temperature","The total amount of heat in a sample","How heavy a sample is"],answer:0,hint:"Look at the number and unit shown by the thermometer.",why:"A thermometer measures temperature. Temperature tells how hot or cold something is."}},
 {id:"chem-water-states",grade:6,title:"A Journey Through States of Water",short:"States of water",intro:"Explore ice, liquid water and water vapour, or follow water through a simplified cycle.",note:"State-change temperatures are approximate for pure water near ordinary air pressure. The water-cycle animation is simplified.",controls:[{key:"mode",label:"Explore",type:"select",value:"Heating",options:["Heating","Cooling","Water cycle"]},{key:"temperature",label:"Temperature",min:-10,max:110,step:10,value:20,unit:"°C"}],prediction:{question:"What do you predict happens to ice as its temperature rises above its melting point?",options:["It melts to liquid water","It turns directly into soil"]},challenge:{text:"Choose Heating and set the sample near 100°C. What state does the model show?",values:{mode:"Heating",temperature:100}},check:{question:"What is condensation?",options:["Liquid water changing to water vapour","Water vapour cooling into liquid droplets","Liquid water becoming ice"],answer:1,hint:"Think about how clouds or droplets form as water vapour cools.",why:"Condensation happens when water vapour cools and becomes liquid droplets."}},
 {id:"chem-separation",grade:6,title:"Methods of Separation in Everyday Life",short:"Separation methods",intro:"Choose a mixture and compare handpicking, winnowing and filtration. Each method uses a different property.",note:"These are safe virtual demonstrations. Do not handle or prepare real mixtures.",controls:[{key:"method",label:"Method",type:"select",value:"Handpicking",options:["Handpicking","Winnowing","Filtration"]},{key:"mixture",label:"Mixture",type:"select",value:"Rice and small stones",options:["Rice and small stones","Grain and chaff","Sand and water"]},{key:"airflow",label:"Moving air",min:1,max:10,step:1,value:6,unit:"strength"},{key:"pieces",label:"Visible pieces",min:2,max:8,step:1,value:6,unit:"pieces"},{key:"filter",label:"Filter",type:"select",value:"Filter paper",options:["Filter paper","Fine mesh"]}],prediction:{question:"Which method should work best for removing visible stones from rice?",options:["Handpicking","Filtration"]},challenge:{text:"Use handpicking on rice and small stones. Remove one visible stone.",values:{method:"Handpicking",mixture:"Rice and small stones"}},check:{question:"Why can filtration separate sand from water?",options:["Sand dissolves in water","The filter holds back insoluble sand while water passes","The water becomes a gas"],answer:1,hint:"Look at what stays on the filter and what passes through.",why:"Filtration works when an insoluble solid is trapped by the filter while liquid passes through."}},
 {id:"chem-nature",grade:6,title:"Nature’s Treasures",short:"Nature’s treasures",intro:"Explore the air around us, water, soil, rocks, minerals and energy resources.",note:"Air percentages are approximate for dry air. Diagrams simplify natural layers and resource examples.",controls:[{key:"explore",label:"Explore",type:"select",value:"Air composition",options:["Air composition","Water resources","Soil layers","Granite (rock)","Quartz (mineral)","Renewable: solar","Renewable: wind","Renewable: water power","Non-renewable: coal","Non-renewable: petroleum"]}],prediction:{question:"Which gas do you predict makes up the largest part of dry air?",options:["Nitrogen","Oxygen"]},challenge:{text:"Inspect the air chart. Which gas makes up most of dry air?",values:{explore:"Air composition"}},check:{question:"Which resource is renewable in the model?",options:["Coal","Petroleum","Sunlight"],answer:2,hint:"Choose the source that nature continually replenishes.",why:"Sunlight is renewable because it is naturally replenished. Coal and petroleum take a very long time to form."}},
 {id:"chem-indicators",grade:7,title:"Exploring Substances: Acidic, Basic, and Neutral",short:"Acids, bases & neutral",intro:"Use virtual indicators to classify familiar example substances without touching or tasting them.",note:"All samples are virtual examples. Never taste, touch or mix real substances.",controls:[{key:"substance",label:"Example substance",type:"select",value:"Lemon juice",options:["Lemon juice","Vinegar","Water","Baking soda solution","Soap solution"]},{key:"indicator",label:"Indicator",type:"select",value:"Universal indicator",options:["Universal indicator","Litmus"]}],prediction:{question:"What color do you predict universal indicator shows for neutral water?",options:["Green","Red"]},challenge:{text:"Test water with universal indicator. What color and class should appear?",values:{substance:"Water",indicator:"Universal indicator"}},check:{question:"What does an indicator help us find out?",options:["Whether a substance is acidic, basic or neutral","How heavy the substance is","Whether the substance is a metal"],answer:0,hint:"Look at the color key beside the indicator.",why:"An indicator changes color to help classify an example as acidic, basic or neutral."}},
 {id:"chem-metals",grade:7,title:"The World of Metals and Non-metals",short:"Metals & non-metals",intro:"Compare example materials and properties. Then inspect common alloys and why people use them.",note:"Examples show common tendencies, not rules for every metal or non-metal. The tests are virtual.",controls:[{key:"sample",label:"Material",type:"select",value:"Copper wire",options:["Iron nail","Copper wire","Aluminium foil","Sulfur","Graphite"]},{key:"test",label:"Property test",type:"select",value:"Electrical conductivity",options:["Lustre","Hardness","Malleability","Ductility","Electrical conductivity"]},{key:"alloy",label:"Alloy example",type:"select",value:"None",options:["None","Steel (iron + carbon)","Brass (copper + zinc)","Bronze (copper + tin)"]}],prediction:{question:"Which example non-metal can conduct electricity?",options:["Graphite","Sulfur"]},challenge:{text:"Choose graphite and test electrical conductivity. Notice that some non-metals are exceptions.",values:{sample:"Graphite",test:"Electrical conductivity",alloy:"None"}},check:{question:"What is an alloy?",options:["A mixture of a metal with other element(s), chosen for useful properties","A pure non-metal","A material that always dissolves in water"],answer:0,hint:"Look at the ingredient labels for steel, brass and bronze.",why:"An alloy is a mixture containing a metal and other element(s), made to give useful properties."}},
 {id:"chem-changes",grade:7,title:"Changes Around Us: Physical and Chemical",short:"Physical & chemical changes",intro:"Compare changes that keep the same substance with changes that form new substances.",note:"All changes are virtual. Combustion is shown as a safe diagram—never start a fire or handle chemicals.",controls:[{key:"change",label:"Example",type:"select",value:"Cutting paper",options:["Cutting paper","Melting ice","Rusting iron","Combustion"]},{key:"air",label:"Air / oxygen",type:"toggle",value:true,on:"Available",off:"Limited"},{key:"water",label:"Water exposure",type:"toggle",value:true,on:"Present",off:"Absent"},{key:"progress",label:"Change progress",min:0,max:100,step:10,value:50,unit:"%"}],prediction:{question:"Which example do you predict forms a new substance?",options:["Rusting iron","Cutting paper"]},challenge:{text:"For the rust model, compare air and water present with one missing.",values:{change:"Rusting iron",air:true,water:true,progress:80}},check:{question:"Which example forms a new substance?",options:["Cutting paper","Melting ice","Rusting iron"],answer:2,hint:"Look for the example that forms iron oxide.",why:"Rusting is a chemical change because iron reacts with oxygen and water to form rust."}},
 {id:"chem-particles",grade:8,title:"Particulate Nature of Matter",short:"Particles of matter",intro:"Matter is made of tiny particles too small to see directly. Explore their spacing, movement and spreading.",note:"Particle diagrams are simplified and not to scale. The dots are not atoms drawn at their real size.",controls:[{key:"mode",label:"Model",type:"select",value:"Particle states",options:["Particle states","Diffusion"]},{key:"state",label:"State of matter",type:"select",value:"Liquid",options:["Solid","Liquid","Gas"]},{key:"temperature",label:"Temperature setting",min:1,max:10,step:1,value:5,unit:"relative"}],prediction:{question:"In which state do you predict particles are farthest apart?",options:["Gas","Solid"]},challenge:{text:"Choose gas and run the model. Compare its particle spacing with a solid.",values:{mode:"Particle states",state:"Gas",temperature:7}},check:{question:"In which state are particles usually closest together and fixed in place?",options:["Solid","Liquid","Gas"],answer:0,hint:"Look for the arrangement that stays in an orderly group.",why:"In a solid, particles are close together and vibrate around fixed positions."}},
 {id:"chem-mixtures",grade:8,title:"Elements, Compounds, and Mixtures",short:"Elements, compounds & mixtures",intro:"Inspect particle diagrams to see how atoms can be separate, joined, or mixed together.",note:"Particles are enlarged symbols, not to scale. Bonds and spacing are simplified diagrams.",controls:[{key:"kind",label:"Particle model",type:"select",value:"Element",options:["Element","Compound","Uniform mixture","Non-uniform mixture"]}],prediction:{question:"Which model do you predict shows different atoms chemically joined?",options:["Compound","Uniform mixture"]},challenge:{text:"Switch between a compound and a uniform mixture. How does the joining differ?",values:{kind:"Compound"}},check:{question:"What makes a compound different from a mixture?",options:["Its different atoms are chemically joined in a fixed arrangement","It always has only one kind of atom","Its substances are never mixed together"],answer:0,hint:"Look for pairs of different colored atoms joined as repeating groups.",why:"A compound has different atoms chemically joined in a fixed arrangement. A mixture contains substances together without all being chemically joined."}},
 {id:"chem-solutions",grade:8,title:"Solutes, Solvents, and Solutions",short:"Solutions & dissolving",intro:"Choose a solute and solvent, then explore stirring, temperature and a simplified saturation demonstration.",note:"Animated particles are simplified models. Do not handle or mix real substances.",controls:[{key:"solute",label:"Solute",type:"select",value:"Salt",options:["Salt","Sugar","Sand","Chalk powder"]},{key:"solvent",label:"Solvent",type:"select",value:"Water",options:["Water","Vegetable oil"]},{key:"stir",label:"Stirring",type:"toggle",value:true,on:"On",off:"Off"},{key:"temperature",label:"Temperature",type:"select",value:"Room",options:["Cool","Room","Warm"]},{key:"amount",label:"Solute added",min:1,max:8,step:1,value:4,unit:"spoon units"}],prediction:{question:"Which pair do you predict will form a solution in this model?",options:["Salt and water","Sand and water"]},challenge:{text:"Compare salt in cool water and warm water. Add more than the model’s saturation limit.",values:{solute:"Salt",solvent:"Water",stir:true,temperature:"Warm",amount:7}},check:{question:"What does saturation mean in this model?",options:["The solvent has dissolved as much solute as it can under these conditions","Every solid dissolves in every liquid","Stirring makes unlimited solute dissolve"],answer:0,hint:"Check whether any solid remains after the model reaches its limit.",why:"A saturated solution has dissolved as much solute as it can under the stated conditions; extra solute remains undissolved."}}
];
const chemistryGradeInfo={6:{name:"Class 6",description:"Explore materials, temperature, water, separation and natural resources.",ids:["chem-materials","chem-temperature","chem-water-states","chem-separation","chem-nature"]},7:{name:"Class 7",description:"Investigate indicators, materials and everyday changes.",ids:["chem-indicators","chem-metals","chem-changes"]},8:{name:"Class 8",description:"Explore particles, mixtures, solutions and dissolving.",ids:["chem-particles","chem-mixtures","chem-solutions"]}};
const chemistryQuizzes={
 6:[{q:"Which property tells whether salt dissolves in water?",options:["Solubility","Lustre","Hardness"],answer:0,why:"Solubility describes whether a material dissolves in a liquid."},{q:"What does a thermometer measure?",options:["Temperature","Heat energy directly","Mass"],answer:0,why:"A thermometer measures temperature, which tells how hot or cold something is."},{q:"What process forms clouds from cooled water vapour?",options:["Condensation","Filtration","Winnowing"],answer:0,why:"Condensation changes water vapour into tiny liquid droplets."}],
 7:[{q:"What color does universal indicator usually show for a neutral solution?",options:["Green","Red","Purple"],answer:0,why:"Green is the usual universal-indicator color near pH 7."},{q:"Which example is an electrical-conducting non-metal?",options:["Graphite","Sulfur","Wood"],answer:0,why:"Graphite is a non-metal that conducts electricity."},{q:"Which is a chemical change?",options:["Rusting iron","Cutting paper","Melting ice"],answer:0,why:"Rusting forms a new substance, iron oxide."}],
 8:[{q:"How are particles arranged in a gas compared with a solid?",options:["Usually farther apart and moving freely","Fixed in an ordered pattern","All chemically bonded together"],answer:0,why:"Gas particles are usually farther apart and move freely."},{q:"What is a compound?",options:["Different atoms chemically joined in a fixed arrangement","Any substances placed together","Only one kind of atom"],answer:0,why:"A compound contains different atoms chemically joined in a fixed arrangement."},{q:"What remains when a solution is saturated?",options:["Extra undissolved solute","No solvent","Unlimited dissolved solid"],answer:0,why:"At saturation, extra solute cannot dissolve under those conditions."}]
};
const biologyModules=[
 {id:"bio-plant-world",grade:6,title:"The Wonderful World of Plants",short:"Plant parts & functions",kind:"plant",intro:"Explore how roots, stems, leaves, flowers, fruits and seeds work together in a flowering plant.",note:"A simplified flowering-plant model; parts vary across plant species and are not drawn to scale.",controls:[{key:"part",label:"Inspect a plant part",type:"select",value:"Leaf",options:["Root","Stem","Leaf","Flower","Fruit","Seed"]},{key:"plant",label:"Example plant",type:"select",value:"Bean plant",options:["Bean plant","Sunflower","Mango tree"]}],explain:"",predict:"Which part usually absorbs water from soil?",predictOptions:["Roots","Flowers"],observe:"Which part mainly makes food using light?",choices:["Leaves","Roots","Seeds"],answer:0,hint:"Look for the broad green part that receives light.",learn:"Roots anchor many plants and absorb water and minerals; stems support the plant and move materials; leaves make sugars using light; flowers help reproduction; fruits protect seeds; seeds can grow into new plants.",diagram:["Roots · anchor & absorb","Stem · support & transport","Leaves · make sugars","Flower · reproduction","Fruit · protects seeds","Seed · can grow"],quiz:[
 ["Which part commonly absorbs water from soil?","Roots","Flowers","Fruits","Roots absorb water and minerals from the soil.","Think about the part in contact with soil."],
 ["What is one job of a stem?","Support the plant and move materials","Make seeds inside the soil","Absorb light through the roots","Stems support many plant parts and transport water and sugars.","Look at the part joining roots and leaves."],
 ["Which plant part usually makes sugars using light?","Leaves","Roots","Fruits","Leaves use light, water and carbon dioxide to make sugars.","Which part is broad and green on many plants?"],
 ["What is a common role of a flower?","Help the plant reproduce","Absorb most water from soil","Store all the plant's minerals","Flowers contain structures involved in plant reproduction.","Which part can later form a fruit?"],
 ["What does a fruit commonly do?","Protect seeds","Anchor the plant in soil","Carry water up the stem","Fruits often protect seeds as they develop or disperse.","Seeds are commonly found inside or on a fruit."],
 ["What can a seed do when conditions are suitable?","Germinate and grow into a young plant","Turn into a flower without growing","Absorb sunlight for the whole adult plant","A seed can germinate and begin a new plant's life.","Think about how a new plant starts."],
 ["A plant's leaves are shaded for a while. Which function is affected most directly?","Making sugars using light","Anchoring roots","Protecting seeds inside fruit","Leaves need light to make sugars.","Choose the leaf's main food-making role."],
 ["Which pair correctly matches a part and its common job?","Root — anchor and absorb water","Flower — absorb water from soil","Seed — support all leaves","Roots anchor plants and absorb water.","Match the underground part to its role."],
 ["Which sequence best describes a seed becoming a fruit-bearing plant?","Seed germinates, plant grows, flowers may form fruit","Fruit becomes soil, then a flower appears","Roots turn directly into seeds","Seeds germinate and plants may later flower and form fruit.","Put early growth before flowering."],
 ["Why is it useful to study how plant parts work together?","Different parts perform linked jobs that support plant life","Every plant part does exactly the same job","Plants can live without any water-absorbing part","Plant structures have different but connected functions.","Think about how water, support, food and seeds are linked."]
 ]},
 {id:"bio-diversity",grade:6,title:"Diversity in the Living World",short:"Living things & habitats",kind:"diversity",intro:"Sort familiar organisms by observable features and habitats, then compare what makes living things alike and different.",note:"Organism cards are examples for learning, not a complete picture of biodiversity.",controls:[{key:"feature",label:"Sort by feature",type:"select",value:"Body covering",options:["Body covering","Number of legs","Where it lives","How it moves"]},{key:"habitat",label:"Habitat",type:"select",value:"All habitats",options:["All habitats","Land","Water","Air and land","Land and water"]}],explain:"",predict:"Which feature helps sort a bird from a fish?",predictOptions:["Body covering and body features","Their names only"],observe:"Why can two organisms belong to different groups?",choices:["They have different observable features or needs","They are both alive","They are the same size"],answer:0,hint:"Compare how they look, move, and where they live.",learn:"Living things share processes such as growth and needing resources, but vary in body features, life cycles and habitats. Biodiversity means the variety of living things in an area or on Earth.",diagram:["Bird · feathers · air/land","Fish · fins · water","Frog · moist skin · land/water","Tree · leaves · land","Butterfly · six legs · air/land"],quiz:[
 ["What does biodiversity mean?","The variety of living things","Only the number of trees","The weather in a habitat","Biodiversity is the variety of organisms in an area or on Earth.","Think of the word 'diversity'."],
 ["Which is an observable feature useful for sorting animals?","Body covering","A guessed name","A made-up story","Body coverings such as feathers, scales or fur can be observed.","Choose something you can see."],
 ["Which feature best distinguishes a fish from a bird?","Fins and gills compared with feathers and wings","Both are the same color","Their names have different letters","Fish commonly have fins and gills; birds have feathers and wings.","Compare body parts, not names."],
 ["Why might a frog be grouped with land-and-water habitat examples?","Many frogs use both land and water during their lives","Frogs live only in the open air","Frogs do not need a habitat","Many frogs use aquatic and terrestrial habitats at different life stages.","Think about where frogs can live and develop."],
 ["What is a habitat?","A place where an organism lives and meets its needs","An organism's body covering","A list of animal names","A habitat provides living things with conditions and resources they need.","Think about an organism's home environment."],
 ["Two animals have different body coverings. What can we conclude?","They have an observable difference, but may share other features","They cannot both be animals","One must not be living","Organisms can differ in one feature and share others.","One difference does not erase every similarity."],
 ["A student sorts organisms by number of legs. What makes this a useful method?","It uses a feature that can be observed and compared","It groups organisms by favorite food","It proves all organisms with the same legs are identical","A useful sorting rule uses observable characteristics.","Choose a measurable, visible feature."],
 ["Why can organisms in the same habitat still look very different?","A habitat can support many kinds of organisms with different features","Every habitat contains one kind of living thing","Habitat makes all organisms identical","Different organisms can share an environment while having different adaptations.","Separate shared location from shared appearance."],
 ["Which is the best way to compare two organisms fairly?","Use the same observable features for both","Use a different rule for each organism","Compare only their names","Using the same features makes a comparison consistent.","Apply one rule to both examples."],
 ["Why is biodiversity valuable to learn about?","It helps us understand the variety and relationships of life","It shows that all living things are interchangeable","It means habitats never change","Learning about biodiversity helps describe life's variety and connections.","Think about what comparisons across organisms reveal."]
 ]},
 {id:"bio-plant-exploring",grade:6,title:"Exploring the World of Plants",short:"Compare plant structures",kind:"plant-compare",intro:"Compare root, stem, leaf, flower, fruit and seed examples from different plants. Look for variation as well as shared functions.",note:"The examples are simplified drawings. Real plant structures vary and are not to scale.",controls:[{key:"structure",label:"Structure to compare",type:"select",value:"Leaves",options:["Roots","Stems","Leaves","Flowers","Fruits","Seeds"]},{key:"example",label:"Example pair",type:"select",value:"Bean and grass",options:["Bean and grass","Sunflower and rose","Mango and pea"]}],explain:"",predict:"Will every plant have identical-looking leaves?",predictOptions:["No, leaves can vary in shape and size","Yes, all leaves look exactly alike"],observe:"Why compare structures from different plants?",choices:["To notice variation and relate form to function","To prove all plants are identical","To find which plant is best"],answer:0,hint:"Compare shape, size or position and consider what the part does.",learn:"Plant parts can look different while performing similar jobs. For example, leaves vary in shape but commonly capture light; roots vary but often anchor plants and take up water. Models show selected examples, not every species.",diagram:["Bean leaf · broad leaflet","Grass leaf · narrow blade","Taproot · main root","Fibrous roots · many fine roots","Variation · shared roles"],quiz:[
 ["How can leaves of different plants vary?","In shape and size","Only in their names","They must all be broad and round","Leaves show variation in size, shape and arrangement.","Picture two different plants."],
 ["What can roots of different plants have in common?","They often anchor the plant and absorb water","They all make flowers","They all grow above the soil","Different root forms can share jobs such as anchoring and absorption.","Compare the job rather than appearance."],
 ["Why compare a bean leaf and a grass leaf?","To notice different forms that can both be leaves","To show one is not a plant part","To decide which plant is more valuable","Comparisons reveal both variation and shared function.","Look for similarities and differences together."],
 ["A plant has many thin roots instead of one large main root. What can we infer?","Root systems can vary in structure","It cannot absorb water","It must be a flower","Plants have varied root structures that still support uptake and anchoring.","Different shape does not mean no function."],
 ["What does 'variation' mean when comparing plants?","Differences among examples of a kind of structure","Every example is identical","A plant changing into an animal","Variation means that examples differ in features.","Think about differences in shape or size."],
 ["A broad leaf may capture light across a wide surface. What should we remember?","This is a useful model, but leaf forms and roles vary","All broad leaves belong to one species","A leaf never exchanges gases","The diagram connects form and function but does not represent every plant.","Keep the model's limits in mind."],
 ["Which statement best compares a flower and a fruit?","They are different structures with different roles in reproduction","They are the same structure","Both mainly absorb water from soil","Flowers support reproduction; fruits commonly protect developing seeds.","Compare each structure's role."],
 ["A seed is smaller than a fruit. What is a reasonable conclusion?","Plant structures vary in size and have different functions","Size alone tells whether something is living","Seeds and fruits have identical jobs","Size is one feature; structure and function also matter.","Do not infer function from size alone."],
 ["Why do scientists compare several examples rather than one?","Several examples show which features vary and which are shared","One example proves every plant is identical","More examples remove all differences","Multiple examples reveal patterns more reliably.","Look for repeated patterns across examples."],
 ["Which explanation best links plant structure and function?","Different forms can help plant parts do their jobs in different settings","Every structure has no relationship to its role","A structure's appearance tells the whole story","Structure can support function, while many forms can perform similar roles.","Connect form to job without overgeneralizing."]
 ]},
 {id:"bio-movement",grade:6,title:"Body Systems and Movement",short:"Skeleton, joints & movement",kind:"movement",intro:"Explore a simplified skeleton and major joints. Animate how muscles pull on bones to bend and straighten a limb.",note:"A simplified educational model—not a medical diagram. Muscles pull on bones across joints; this animation is not to scale.",controls:[{key:"joint",label:"Joint to explore",type:"select",value:"Elbow",options:["Elbow","Knee","Shoulder"]},{key:"motion",label:"Movement",type:"select",value:"Bend",options:["Bend","Straighten"]}],explain:"",predict:"What do muscles do to move many bones?",predictOptions:["Pull on bones","Push bones from both ends"],observe:"What allows a limb to bend?",choices:["A joint lets bones move relative to one another","Bones melt and reform","Muscles turn into bones"],answer:0,hint:"Find the place where two bones meet.",learn:"The skeleton supports the body and protects some organs. Joints are places where bones meet. Skeletal muscles contract and pull on bones; muscles often work in pairs to bend and straighten a joint.",diagram:["Skull · protects brain","Rib cage · protects chest organs","Spine · support","Elbow/knee · hinge-like joint","Muscle · pulls on bone"],quiz:[
 ["What is a joint?","A place where bones meet","A type of muscle","A part of the skin","Joints are places where two or more bones meet.","Look for the meeting point between bones."],
 ["How do many skeletal muscles move bones?","They contract and pull on bones","They push bones from both ends","They turn into joints","Skeletal muscles contract and pull on bones.","Think about the direction a muscle can apply force."],
 ["What does the skeleton help do?","Support the body and protect some organs","Digest all food","Make the lungs breathe by itself","The skeleton supports the body and protects organs such as the brain and chest organs.","Recall what bones surround the brain and chest."],
 ["Which structure lets the elbow bend?","A joint between bones","A leaf-like tendon in the lung","The skull","The elbow joint allows the forearm and upper arm to move relative to each other.","Which place connects the two arm bones?"],
 ["Why do muscles often work in pairs around a joint?","One muscle can pull to bend while another helps straighten","Muscles push bones in opposite directions from outside","Pairs make bones grow instantly","Opposing muscle actions can move a joint in different directions.","Consider bending and then straightening."],
 ["When a muscle contracts, what usually happens to its length?","It shortens and pulls","It stretches bones longer","It becomes a joint","A contracting skeletal muscle shortens and pulls on its attachment.","Think of a muscle tightening."],
 ["What does the rib cage help protect?","Organs in the chest","The toes","The contents of a seed","The rib cage surrounds and helps protect organs in the chest.","Find the bones around the chest."],
 ["A simplified animation shows a hinge-like elbow. What should students remember?","Real bodies are more complex than the model","Every joint moves in exactly one way","Muscles do not attach to bones","The drawing simplifies real anatomy and movement.","Models show a few important ideas, not every detail."],
 ["Why can bones move relative to one another at joints?","Muscles pull on bones around movable joints","Bones are not connected in a body","The skeleton has no joints","Muscle action and joint structure allow controlled movement.","Link muscles with the joint."],
 ["Which explanation best describes a bend-and-straighten cycle?","Different muscles pull on bones to change the joint angle","Bones shorten to make the limb bend","A joint disappears and returns","Muscle contractions change the angle between bones at a joint.","Focus on the changing angle."]
 ]},
 {id:"bio-classification",grade:6,title:"How Scientists Organize Life",short:"Classification & grouping",kind:"classification",intro:"Group organisms by shared observable characteristics. Try more than one grouping rule and compare what each helps us notice.",note:"These are simplified example groups. Scientific classification uses many characteristics and evidence.",controls:[{key:"rule",label:"Grouping rule",type:"select",value:"Has a backbone",options:["Has a backbone","Body covering","Makes its own food","Lives mostly in water"]},{key:"organism",label:"Inspect organism",type:"select",value:"Frog",options:["Frog","Bird","Fish","Butterfly","Oak tree","Mushroom"]}],explain:"",predict:"Why do scientists classify organisms?",predictOptions:["To organize and compare living things","To say all organisms are the same"],observe:"What is a useful way to group organisms?",choices:["By shared observable characteristics","By favorite color guessed by a person","By the first letter of an invented name"],answer:0,hint:"A helpful group rule describes a feature organisms share.",learn:"Classification organizes living things into groups based on shared characteristics. It helps scientists identify, compare and communicate about organisms. Groups depend on the features and evidence used.",diagram:["Backbone · fish, frog, bird","Makes own food · oak tree","No backbone · butterfly","Decomposer · mushroom","Groups help compare life"],quiz:[
 ["What is classification?","Organizing organisms into groups using shared characteristics","Naming every organism after a color","Putting all living things into one group","Classification groups organisms according to shared features.","Think about the word 'class'."],
 ["Which feature can help classify a bird?","Feathers","Its favorite weather","A guessed personality","Feathers are an observable characteristic of birds.","Choose a feature you can see."],
 ["Why do scientists classify organisms?","It helps organize, compare and communicate about life","It makes every organism identical","It prevents organisms from changing","Classification helps people study and discuss organisms systematically.","Think of how groups help with comparisons."],
 ["A student groups fish and birds because both have backbones. What is this an example of?","Grouping by a shared characteristic","Grouping by habitat only","Grouping without a rule","Both groups share a backbone, an observable characteristic.","Identify the rule being used."],
 ["Could an organism fit different groups when the rule changes?","Yes, different characteristics can be used for grouping","No, every organism can belong to only one group ever","Only plants can be grouped","Different classification questions can focus on different characteristics.","The grouping rule matters."],
 ["Which rule is most useful for a scientific grouping?","A clear feature that can be observed or supported by evidence","A person's favorite organism","A random word","Clear, evidence-based criteria make groups useful and repeatable.","Choose a rule another student can apply."],
 ["Why is a mushroom not grouped as a green plant just because it stays in one place?","Classification uses important characteristics, not one superficial similarity","Everything that stays still is a plant","Mushrooms make food like green leaves","Shared location alone does not determine an organism's group.","Compare how organisms get food."],
 ["What should students do if one grouping rule does not answer their question?","Choose another relevant characteristic and compare again","Change the organisms' features","Stop observing","Different questions may require different useful characteristics.","Match the rule to the question."],
 ["How can classification improve communication?","People can use shared group names and criteria","It removes the need to observe organisms","It makes local species disappear","Shared criteria help people discuss the same organism groups.","Think about how a common system helps others understand."],
 ["Which statement about scientific groups is best?","Groups are tools for organizing life using evidence and characteristics","Groups prove organisms never share features across groups","A single feature always explains every relationship","Classification is a useful way to organize and compare evidence about life.","Avoid treating one simple model as the whole story."]
 ]},
 {id:"bio-characteristics",grade:6,title:"Living Creatures: Exploring Their Characteristics",short:"Characteristics & life cycles",kind:"life-cycle",intro:"Explore growth, nutrition, respiration, response to surroundings, reproduction and life cycles using familiar, age-appropriate examples.",note:"Life-cycle drawings are simplified examples; organisms differ and not every life cycle follows the same pattern.",controls:[{key:"process",label:"Life process",type:"select",value:"Growth",options:["Growth","Nutrition","Respiration","Response","Reproduction","Life cycle"]},{key:"example",label:"Example",type:"select",value:"Butterfly",options:["Butterfly","Plant","Human","Bird"]}],explain:"",predict:"Which observation is evidence that a young living thing grows?",predictOptions:["It changes in size as it develops","A rock changes position when pushed"],observe:"What is a life cycle?",choices:["Stages in an organism's life from beginning through growth and reproduction","A list of habitats only","A single movement"],answer:0,hint:"Think of the stages an organism passes through over time.",learn:"Living things grow, need nutrition, carry out respiration to release energy from food, respond to surroundings, and reproduce. A life cycle describes stages across an organism's life; details differ among organisms.",diagram:["Growth · changes over time","Nutrition · obtains materials","Respiration · releases energy","Response · reacts to surroundings","Reproduction · new generation","Life cycle · stages"],quiz:[
 ["What does growth mean in living things?","A change in size or development over time","A rock rolling downhill","A shadow changing shape","Living things grow and develop during their lives.","Think about how a seedling changes."],
 ["What is nutrition?","Obtaining or making materials needed for life","The movement of a shadow","A type of weather","Living things need nutrients and materials to grow and function.","Which process supplies useful materials?"],
 ["What is respiration in living things?","A process that releases energy from food","Only the movement of air in and out of lungs","The act of growing taller","Respiration releases usable energy from food in living organisms.","Think about a life process organisms use to release energy."],
 ["What does responding to surroundings mean?","Reacting to a change or stimulus","Never changing behavior","Making a habitat","Living things can respond to changes in their surroundings.","A plant bending toward light is one example."],
 ["What does reproduction allow a species to do?","Produce new organisms of the same kind","Make every individual live forever","Stop all growth","Reproduction produces new individuals and helps continue a species.","Think beyond one individual's lifetime."],
 ["What is a life cycle?","Stages an organism passes through during its life","A daily weather forecast","A list of body parts","Life cycles describe stages such as beginning, growth and reproduction.","Think of stages over time."],
 ["Which is an example of responding to surroundings?","A plant shoot grows toward light","A stone remains on a shelf","A cloud is named","Plants can respond to light by growing toward it.","Choose a living thing reacting to a condition."],
 ["Do plants carry out respiration?","Yes, plants also release energy from food","No, only animals respire","Only at night","Plants are living organisms and carry out respiration.","Plants are living things too."],
 ["Why might butterfly and plant life cycles look different?","Different kinds of organisms pass through different stages","All living things have the same stages","Plants do not grow","Life-cycle stages vary among organisms.","Compare a seedling with a butterfly's stages."],
 ["Which combination best describes many characteristics of living things?","Growth, nutrition, respiration, response and reproduction","Only movement from place to place","Only having a visible shape","Living things show several life processes; examples vary among organisms.","Look for a collection of life processes."]
 ]},
 {id:"bio-photosynthesis",grade:7,title:"Nutrition in Plants",short:"Photosynthesis",kind:"photosynthesis",intro:"Animate a simplified photosynthesis model: leaves use light energy, water and carbon dioxide to make glucose; oxygen is released.",note:"Conceptual model only—not to scale. Chlorophyll absorbs light; it is not shown at real size or as a separate green liquid.",controls:[{key:"light",label:"Light level",min:0,max:10,step:1,value:7,unit:"model units"},{key:"water",label:"Water supply",min:0,max:10,step:1,value:6,unit:"model units"},{key:"carbon",label:"Carbon dioxide",min:0,max:10,step:1,value:6,unit:"model units"},{key:"leaf",label:"Leaf condition",type:"select",value:"Green leaf with chlorophyll",options:["Green leaf with chlorophyll","Leaf with little chlorophyll"]}],explain:"",predict:"Which set does a leaf need for photosynthesis?",predictOptions:["Light, water and carbon dioxide","Oxygen, soil and glucose"],observe:"Which products are shown in this simplified model?",choices:["Glucose and oxygen","Water and soil"],answer:0,hint:"Look at the arrows leaving the leaf.",learn:"In photosynthesis, chlorophyll in leaves absorbs light energy. Plants use carbon dioxide and water to make glucose, releasing oxygen. The diagram does not show real sizes or every step of the process.",diagram:["Sunlight → leaf","Carbon dioxide → leaf","Water → leaf","Glucose → plant","Oxygen → air"],quiz:[
 ["What does a plant use as an energy source for photosynthesis?","Light energy","Sound energy","Energy from soil alone","Chlorophyll absorbs light energy for photosynthesis.","Look at the energy arrow in the model."],
 ["Which gas is used in photosynthesis?","Carbon dioxide","Oxygen only","Nitrogen as the food source","Plants use carbon dioxide during photosynthesis.","Which gas arrow points into the leaf?"],
 ["Where does much photosynthesis happen in a plant?","Leaves","Roots only","Flowers only","Leaves contain chlorophyll and are major sites of photosynthesis.","Look for the green part that captures light."],
 ["What role does chlorophyll have?","It absorbs light energy","It carries seeds through soil","It releases oxygen by breathing","Chlorophyll absorbs light energy used in photosynthesis.","Think about how light energy enters the process."],
 ["Which products are shown in the simplified photosynthesis model?","Glucose and oxygen","Soil and carbon dioxide","Water and sunlight","Photosynthesis makes glucose and releases oxygen in this model.","Look at the arrows leaving the leaf."],
 ["Which inputs combine in the model to make glucose?","Water and carbon dioxide, using light energy","Oxygen and soil, using sound","Seeds and minerals only","Plants use water and carbon dioxide with light energy to make glucose.","Trace the arrows into the leaf."],
 ["A leaf receives very little light. What is likely to happen to photosynthesis in this model?","It slows because less light energy is available","It makes unlimited glucose","It changes glucose into soil","Light energy is needed, so less available light limits the model process.","Which input was reduced?"],
 ["Why is chlorophyll shown as a label rather than a giant green object?","The diagram is conceptual and not to scale","Chlorophyll is larger than a leaf","Chlorophyll is the plant's fruit","Chlorophyll is a pigment in cells, not a giant visible object like the drawing might imply.","Remember the model scale note."],
 ["Which equation best summarizes the simplified process?","Carbon dioxide + water + light → glucose + oxygen","Oxygen + glucose → soil + sunlight","Water + soil → carbon dioxide only","This summarizes the main inputs and outputs, while omitting many biochemical steps.","Check which substances enter and leave."],
 ["Why does photosynthesis matter to plants and other life?","It stores light energy in food and releases oxygen","It turns all plants into animals","It removes every gas from air","Photosynthesis makes energy-rich food for the plant and releases oxygen.","Consider both the food and gas output."]
 ]},
 {id:"bio-digestion",grade:7,title:"Nutrition in Animals",short:"Human digestive system",kind:"digestion",intro:"Follow food through the mouth, food pipe, stomach, small intestine and large intestine. Explore each organ's role.",note:"Simplified digestive-system diagram; organs are not drawn to scale. This is educational, not medical advice.",controls:[{key:"organ",label:"Inspect organ",type:"select",value:"Small intestine",options:["Mouth","Food pipe","Stomach","Small intestine","Large intestine"]},{key:"food",label:"Food journey",type:"select",value:"Start at mouth",options:["Start at mouth","Show digestion","Show absorption"]}],explain:"",predict:"Where does food first enter the digestive system?",predictOptions:["Mouth","Stomach"],observe:"Where are most digested nutrients absorbed?",choices:["Small intestine","Food pipe"],answer:0,hint:"Choose the long, coiled organ after the stomach.",learn:"Food is chewed in the mouth, moves through the food pipe to the stomach, then into the small intestine where digestion continues and nutrients are absorbed. The large intestine absorbs much water and forms waste.",diagram:["Mouth · chewing & saliva","Food pipe · carries food","Stomach · churns food","Small intestine · digestion & absorption","Large intestine · absorbs water"],quiz:[
 ["Where does food enter the digestive system?","Mouth","Stomach","Large intestine","Food enters through the mouth, where chewing begins.","Think about where a meal starts."],
 ["What does the food pipe do?","Carries food from the mouth toward the stomach","Absorbs most nutrients","Makes bile","The food pipe moves swallowed food to the stomach.","Follow the route after swallowing."],
 ["What happens in the stomach?","Food is churned and mixed with digestive juices","All nutrients enter the blood there","Food becomes oxygen","The stomach churns food and mixes it with digestive juices.","Which organ is a muscular mixing chamber?"],
 ["Where are most digested nutrients absorbed?","Small intestine","Food pipe","Mouth","The small intestine absorbs most digested nutrients.","Look at the long coiled organ after the stomach."],
 ["What is one role of the large intestine?","Absorb much of the remaining water","Chew food","Carry food from mouth to stomach","The large intestine absorbs water and helps form waste.","Which organ comes after the small intestine?"],
 ["Which path correctly follows food?","Mouth → food pipe → stomach → small intestine","Stomach → mouth → lungs → small intestine","Mouth → heart → food pipe → stomach","Food travels from the mouth through the food pipe, stomach and intestines.","Put organs in the order food passes through them."],
 ["Why is digestion needed?","It breaks food into smaller substances the body can absorb","It turns food directly into bones","It prevents nutrients from entering the body","Digestion breaks food down so nutrients can be absorbed.","Think about what must happen before absorption."],
 ["What is absorbed from the small intestine into the body?","Digested nutrients","Whole pieces of food","Air from the lungs","The small intestine absorbs digested nutrients.","Choose the products of digestion, not intact food."],
 ["How is the food pipe different from the windpipe?","The food pipe carries food; the windpipe carries air","Both carry food to the stomach","The food pipe absorbs most nutrients","The food pipe is part of digestion; the windpipe carries air to the lungs.","Compare their different pathways."],
 ["Why is the digestive diagram labeled simplified and not to scale?","It clarifies the route without showing real organ sizes or positions exactly","Organs are all the same size","Digestion happens outside the body","The diagram is an educational overview, not an exact anatomical map.","Think about what a simple diagram leaves out."]
 ]},
 {id:"bio-respiration",grade:7,title:"Respiration in Organisms",short:"Breathing & respiration",kind:"respiration",intro:"Compare breathing with cellular respiration. Trace oxygen entering the body and see how cells release energy from food.",note:"Simplified body-and-cell model; it does not show every gas exchange or chemical step.",controls:[{key:"organism",label:"Example organism",type:"select",value:"Human",options:["Human","Fish","Plant"]},{key:"activity",label:"Activity level",type:"select",value:"Resting",options:["Resting","Moving"]}],explain:"",predict:"What does cellular respiration release from food?",predictOptions:["Usable energy","Sunlight"],observe:"How are breathing and cellular respiration different?",choices:["Breathing exchanges gases; cellular respiration releases energy in cells","They are exactly the same event","Breathing makes glucose"],answer:0,hint:"One moves air or gases; the other happens inside cells.",learn:"Breathing is the movement of air in and out of lungs for gas exchange. Cellular respiration happens in cells: oxygen helps release energy from glucose, producing carbon dioxide and water. Different organisms exchange gases in different ways.",diagram:["Air → lungs (human example)","Oxygen → blood → cells","Glucose + oxygen → energy","Carbon dioxide → out"],quiz:[
 ["What is breathing?","Movement of air in and out of lungs in humans","Energy release from glucose in every cell","Making sunlight","Breathing moves air and supports gas exchange.","Choose the process involving air movement."],
 ["Where does cellular respiration occur?","In cells","Only in the nose","Only in plant roots","Cellular respiration occurs in cells.","Think about the name: cellular."],
 ["What does cellular respiration release from food?","Usable energy","Sunlight","Soil","Cellular respiration releases usable energy from food molecules.","Which output helps cells do work?"],
 ["Which gas is used in the simplified human-cellular respiration model?","Oxygen","Only nitrogen","Helium","Oxygen is used in aerobic cellular respiration.","Trace the gas entering the body."],
 ["Which gas is produced by cellular respiration?","Carbon dioxide","Oxygen only","Hydrogen as the only product","Carbon dioxide is produced during cellular respiration.","Look at the gas leaving the cells in the model."],
 ["How are breathing and cellular respiration related?","Breathing brings in oxygen that cells can use in respiration","Breathing and respiration are identical","Cellular respiration moves air through the nose","Breathing supports gas exchange; cells use oxygen in respiration.","Separate the whole-body process from the cell process."],
 ["A person begins moving more. What may change?","The body may need more oxygen and release more carbon dioxide","Cells stop using energy","Breathing becomes photosynthesis","More activity can increase energy needs and gas exchange.","Think about the energy needed for movement."],
 ["Do plants carry out cellular respiration?","Yes, plant cells also release energy from food","No, only animals have cells","Only leaves respire in sunlight","Plant cells carry out cellular respiration as well as photosynthesis.","Remember that plants are living organisms too."],
 ["How do fish obtain oxygen for respiration?","They exchange dissolved oxygen from water using gills","They breathe through leaves","They make oxygen from soil","Many fish use gills to take oxygen from water.","Compare the habitat and gas-exchange organ."],
 ["Why should a diagram not call breathing and cellular respiration the same thing?","They are connected but describe different processes at different scales","Both happen only outside the body","One is not part of life","Breathing exchanges gases; cellular respiration releases energy inside cells.","Think about whole organism versus cells."]
 ]},
 {id:"bio-transport",grade:7,title:"Transportation in Plants and Animals",short:"Circulation & plant transport",kind:"transport",intro:"Animate a simplified blood-circulation loop and compare it with water and dissolved mineral movement through a plant.",note:"Conceptual diagrams are not to scale and do not show every vessel, tissue or transport mechanism.",controls:[{key:"system",label:"Transport model",type:"select",value:"Animal circulation",options:["Animal circulation","Plant transport"]},{key:"route",label:"Inspect route",type:"select",value:"Heart to body",options:["Heart to body","Body to heart","Roots to leaves"]},{key:"pulse",label:"Animation speed",min:1,max:8,step:1,value:4,unit:"model speed"}],explain:"",predict:"Which organ pumps blood around the human body?",predictOptions:["Heart","Stomach"],observe:"In the plant model, where does water enter before moving upward?",choices:["Roots","Flowers"],answer:0,hint:"Choose the part that takes up water from the soil.",learn:"The heart pumps blood through vessels around the body. Blood carries materials such as oxygen and nutrients. In plants, xylem carries water and minerals from roots toward leaves; phloem transports sugars to parts that need or store them.",diagram:["Heart · pumps blood","Arteries · away from heart","Veins · toward heart","Roots → xylem → leaves","Phloem · moves sugars"],quiz:[
 ["What does the heart do in circulation?","Pumps blood through the body","Digests food","Makes oxygen in leaves","The heart pumps blood through blood vessels.","Which organ acts as the pump?"],
 ["What do arteries generally carry?","Blood away from the heart","Blood only toward the heart","Water from roots to leaves","Arteries carry blood away from the heart.","Follow the direction leaving the heart."],
 ["What do veins generally do?","Carry blood toward the heart","Carry air to the stomach","Carry sugars in plants","Veins return blood toward the heart.","Think about the return route."],
 ["What does blood help transport?","Materials such as oxygen and nutrients","Only bones","Sunlight directly","Blood transports materials including oxygen and nutrients.","Look at what body cells need."],
 ["Which plant tissue carries water and minerals upward from roots?","Xylem","Phloem","Bark only","Xylem carries water and dissolved minerals from roots toward other plant parts.","Which tissue is linked with water movement?"],
 ["What does phloem transport?","Sugars made by plants","Only soil particles","Blood cells","Phloem transports sugars to parts of the plant that need or store them.","Think about where leaf-made food must go."],
 ["Which route best describes water movement in a plant?","Roots → xylem → stem → leaves","Leaves → heart → roots","Flower → lungs → stem","Water is taken up by roots and moves through xylem toward leaves.","Follow the plant, not the animal route."],
 ["Why is circulation described as a loop?","Blood travels from the heart through the body and returns","Blood flows out of the body and disappears","The heart only pumps once","Blood circulation travels out from and back toward the heart.","Compare the outgoing and returning pathways."],
 ["How are plant and animal transport alike?","Both move materials to parts of the organism","Both use the same organs","Plants have a heart","Both systems move needed materials, but their structures differ.","Look for the shared job, not identical structures."],
 ["Why is the circulation drawing not to scale?","It highlights flow direction and key structures, not exact sizes","Blood vessels are all straight lines","The heart is outside the body","The model simplifies complex pathways to make transport easier to follow.","Think about what a diagram is designed to show."]
 ]},
 {id:"bio-plant-repro",grade:7,title:"Reproduction in Plants",short:"Pollination to seed dispersal",kind:"plant-reproduction",intro:"Follow pollination, fertilization, seed and fruit formation, then explore how seeds can disperse safely.",note:"Simplified flowering-plant model. No real flowers, pollen or organisms are used.",controls:[{key:"stage",label:"Life-cycle stage",type:"select",value:"Pollination",options:["Pollination","Fertilization","Seed formation","Seed dispersal"]},{key:"dispersal",label:"Dispersal example",type:"select",value:"Wind",options:["Wind","Water","Animal"]}],explain:"",predict:"What is pollination?",predictOptions:["Pollen reaching a flower's stigma","A seed absorbing water to sprout"],observe:"What can form after fertilization in a flower?",choices:["Seeds","A new root system immediately"],answer:0,hint:"Look at the stage that follows the joining of reproductive cells.",learn:"Pollination is pollen transfer to a flower's stigma. Fertilization occurs when male and female reproductive cells join. Seeds develop from ovules, and the ovary may develop into a fruit. Seeds disperse by wind, water or animals.",diagram:["Pollen → stigma · pollination","Fertilization · cells join","Ovule → seed","Ovary → fruit","Wind / water / animals disperse seeds"],quiz:[
 ["What is pollination?","Transfer of pollen to a flower's stigma","A seed growing roots","A fruit absorbing water","Pollination is the transfer of pollen to a stigma.","Which stage involves pollen reaching a flower part?"],
 ["What happens during fertilization?","Male and female reproductive cells join","A fruit falls from a tree","A leaf makes oxygen only","Fertilization is the joining of reproductive cells.","Think of the stage after pollination."],
 ["What can an ovule develop into after fertilization?","A seed","A leaf","A root hair","Ovules develop into seeds after fertilization.","Look at the seed-forming structure."],
 ["What can the ovary of a flower develop into?","A fruit","A stem","A pollen grain","The ovary commonly develops into a fruit.","Which structure may enclose seeds?"],
 ["Which example describes seed dispersal by wind?","Light seeds carried away by moving air","Seeds carried inside a water pipe","Roots pulling seeds underground","Some light or winged seeds can be carried by wind.","Choose the dispersal agent that moves through air."],
 ["Why is seed dispersal helpful?","It can reduce crowding near the parent plant and help seeds reach new places","It prevents seeds from growing","It turns seeds into flowers immediately","Dispersal can move seeds away from the parent plant.","Think about space and new places to grow."],
 ["Which sequence is in the correct order?","Pollination → fertilization → seed formation → dispersal","Dispersal → seed formation → pollination → fertilization","Fertilization → pollination → seed disappears","Pollen transfer precedes fertilization and seed development; seeds may then disperse.","Put the flower processes in order."],
 ["How might water disperse a seed?","A floating seed can be carried to another place","Water changes every seed into pollen","Water moves pollen only into the sky","Some seeds can float and travel in water.","Think of seeds suited to wet environments."],
 ["How can animals help disperse some seeds?","Seeds may attach to fur or be carried after fruit is eaten","Animals make all seeds using leaves","Seeds turn into animals","Animals can carry seeds externally or move them after eating fruit.","Choose a way an animal can transport a seed."],
 ["Why is the model labeled simplified?","Real plant reproduction has more structures and varied strategies","All plants reproduce in exactly this one way","Pollination is not a real process","The model focuses on common flowering-plant steps; plant reproduction varies.","Remember this example focuses on flowering plants."]
 ]},
 {id:"bio-forest",grade:7,title:"Forests: Our Lifeline",short:"Forest food web",kind:"forest",intro:"Build a simple forest food web and explore how plants, animals, decomposers, soil, water and air depend on one another.",note:"Simplified example food web; arrows show energy or matter relationships, not every feeding interaction.",controls:[{key:"change",label:"Ecosystem change",type:"select",value:"Balanced forest",options:["Balanced forest","Fewer plants","Fewer decomposers","Less water"]},{key:"organism",label:"Inspect organism",type:"select",value:"Decomposer",options:["Tree","Deer","Fox","Fungi and bacteria","Soil"]}],explain:"",predict:"What happens if producers such as plants become scarce?",predictOptions:["Food and shelter may become less available","Every animal gets more food"],observe:"What do decomposers do in a forest?",choices:["Break down dead matter and return nutrients","Make sunlight","Stop plants growing"],answer:0,hint:"Think about how nutrients can return to soil.",learn:"Plants use sunlight and resources to grow. Herbivores feed on plants, predators may feed on animals, and decomposers break down dead matter, returning nutrients to soil. Water, air and soil support the web of life.",diagram:["Sun → plants → herbivores","Herbivores → predators","Dead matter → decomposers","Decomposers → soil nutrients → plants","Water & air support life"],quiz:[
 ["What is a producer in a forest food web?","A plant that makes food using light","A predator that hunts animals","A rock that stores water","Green plants are producers because they make food using light.","Look for the organism that starts many food chains."],
 ["What role can a deer have in a forest food web?","Herbivore that eats plants","Decomposer that breaks down dead matter","Producer that makes its own food","Deer can act as herbivores by eating plants.","Think about what a deer commonly eats."],
 ["What do decomposers do?","Break down dead matter and return nutrients","Make sunlight","Remove all soil","Decomposers break down dead organisms and waste, returning nutrients.","Which organisms recycle nutrients?"],
 ["Why are plants important to many forest animals?","They provide food and can provide shelter","They remove every source of water","They are all predators","Plants support food webs and habitats in many ways.","Think of direct and indirect support."],
 ["What may happen if a forest has fewer plants?","Some animals may have less food and shelter","Every food web becomes larger","Decomposers stop needing matter","Fewer plants can reduce resources for organisms that depend on them.","Follow the producer link in the web."],
 ["How do decomposers connect to soil?","They return nutrients to soil as they break down matter","They turn soil into sunlight","They remove all nutrients","Decomposition helps recycle nutrients into the soil.","Think about what happens to dead leaves."],
 ["Why is a food web more than one food chain?","Organisms can have several feeding relationships","Every organism eats one thing only","A web has no plants","A food web shows many connected feeding relationships.","Look for multiple links between species."],
 ["How can less water affect a forest?","Plants and animals may have difficulty meeting their needs","Only rocks are affected","It always creates more food","Water is an important resource for forest organisms.","Think beyond just plants."],
 ["What do arrows in a simple food web usually show?","The direction of energy transfer from food to consumer","Which animal is largest","The direction of wind only","Arrows commonly point from food toward the organism that eats it.","Follow energy from food to eater."],
 ["Why can a change to one population affect others?","Food-web relationships connect organisms and resources","All organisms live independently","Only predators need plants","Changes can affect connected food, shelter and nutrient relationships.","Trace more than one link."]
 ]},
 {id:"bio-cell",grade:8,title:"The Cell",short:"Virtual microscope: cells",kind:"cell",intro:"Use a virtual microscope to compare plant and animal cells. Inspect the membrane, cytoplasm, nucleus and other structures.",note:"Illustrative cell models, not to scale. Cells vary; the drawings show selected structures and do not represent every cell.",controls:[{key:"cell",label:"Cell type",type:"select",value:"Plant cell",options:["Plant cell","Animal cell"]},{key:"zoom",label:"Microscope view",type:"select",value:"Whole cell",options:["Whole cell","Nucleus","Chloroplast","Mitochondrion"]},{key:"label",label:"Show labels",type:"toggle",value:true,on:"On",off:"Off"}],explain:"",predict:"Which structure is found in typical plant cells but not animal cells?",predictOptions:["Cell wall","Cell membrane"],observe:"Which structure contains genetic material and helps control cell activities?",choices:["Nucleus","Cytoplasm"],answer:0,hint:"Look for the labeled central structure in both cell models.",learn:"Cells are the basic units of living organisms. Both plant and animal cells have a cell membrane, cytoplasm and nucleus. Typical plant cells also have a cellulose cell wall, a large vacuole and chloroplasts in many green tissues. Cell structures are not to scale.",diagram:["Cell membrane · boundary","Cytoplasm · cell contents","Nucleus · genetic material","Plant: cell wall, vacuole, chloroplasts","Both: mitochondria"],quiz:[
 ["What is a cell?","A basic unit of living organisms","A type of organ","A small organism in every case","Cells are the basic structural and functional units of living organisms.","Think about the building blocks of life."],
 ["Which structure forms a boundary around both plant and animal cells?","Cell membrane","Cell wall in every animal cell","Chloroplast only","Both cell types have a cell membrane.","Look for the shared boundary."],
 ["What is the cytoplasm?","Material inside the cell where many processes occur","The hard outer layer of every animal","The plant's seed","Cytoplasm is the material inside the cell surrounding structures.","It lies inside the membrane."],
 ["What is one role of the nucleus?","Contains genetic material and helps control cell activities","Makes sunlight","Forms the cell wall in animals","The nucleus contains genetic material and helps direct cell activities.","Look for the structure labeled nucleus."],
 ["Which structure is typical of plant cells but not animal cells?","Cell wall","Cell membrane","Cytoplasm","Plant cells typically have a cellulose cell wall; animal cells do not.","Compare the plant and animal diagrams."],
 ["What is a common role of chloroplasts in green plant cells?","They carry out photosynthesis","They digest all food in animals","They form the nucleus","Chloroplasts contain chlorophyll and are sites of photosynthesis in green plant cells.","Look for the structure associated with chlorophyll."],
 ["Why is the plant cell wall useful?","It supports and strengthens the cell","It replaces the cell membrane","It makes every cell move","The cell wall supports and helps protect plant cells.","Think of the firm outer layer."],
 ["Which structures occur in both typical plant and animal cells?","Cell membrane, cytoplasm and nucleus","Cell wall and chloroplast only","Roots and leaves","Both cell types have a membrane, cytoplasm and nucleus.","Find the structures shared in both diagrams."],
 ["What should a student remember about the microscope drawings?","They are illustrative and not to scale","All cells have identical shapes and sizes","Organelles are visible to the naked eye","The diagrams simplify cells, which vary and are far too small to see unaided.","Check the model disclaimer."],
 ["A cell is compared to a whole organism. Which statement is accurate?","A cell is a basic unit; many organisms contain many cells","Every cell is a whole animal","Only plants are made of cells","Many organisms are multicellular, and all living things are made of cells.","Separate a building block from a whole organism."]
 ]},
 {id:"bio-microbes",grade:8,title:"Microorganisms",short:"Microorganisms & health",kind:"microbes",intro:"Explore illustrative models of helpful and harmful microorganisms in food production, decomposition and health.",note:"Illustrative models only. Do not culture, collect or handle microorganisms. Disease prevention includes hygiene, safe food practices and appropriate health care.",controls:[{key:"example",label:"Example role",type:"select",value:"Helpful: yeast in bread",options:["Helpful: yeast in bread","Helpful: bacteria in yoghurt","Helpful: decomposers","Harmful: disease-causing microbe","Preventing spread"]},{key:"view",label:"Model view",type:"select",value:"Illustration",options:["Illustration","Magnified model"]}],explain:"",predict:"Can microorganisms be helpful as well as harmful?",predictOptions:["Yes, many are helpful and some can cause disease","No, all microorganisms cause disease"],observe:"What is a safe way to reduce the spread of some infectious diseases?",choices:["Wash hands with soap and water","Try to grow microbes at home"],answer:0,hint:"Choose an everyday hygiene action recommended to reduce germs.",learn:"Microorganisms include bacteria, fungi and other tiny forms of life. Some help make foods, decompose matter or support health; some cause disease. Handwashing, safe food handling, vaccination where recommended, and medical guidance help prevent illness. Never culture or handle microbes.",diagram:["Yeast · helps dough rise","Some bacteria · food production","Decomposers · recycle matter","Some microbes · cause disease","Handwashing · helps prevent spread"],quiz:[
 ["What are microorganisms?","Very small organisms, often seen only with a microscope","Animals that are always large","Non-living rocks","Many microorganisms are too small to see without magnification.","Think about the prefix 'micro-'."],
 ["How can yeast help make bread?","It releases gas that helps dough rise","It turns bread into soil","It acts as a plant root","Yeast fermentation releases carbon dioxide that makes dough rise.","Look at the helpful food-production example."],
 ["Are all microorganisms harmful?","No; many are useful and some can cause disease","Yes; every microbe causes illness","No microorganism affects people or nature","Microorganisms have many roles; some are helpful and some harmful.","Compare food-making and disease examples."],
 ["How can decomposer microorganisms help ecosystems?","They break down dead matter and recycle nutrients","They stop all decay","They make rocks reproduce","Microorganisms help decompose matter and recycle nutrients.","Think about nutrient cycling."],
 ["Which action helps reduce the spread of many germs?","Wash hands with soap and water","Share unwashed food","Touch your face with dirty hands","Handwashing with soap and water helps remove germs.","Choose a safe everyday prevention habit."],
 ["What is a safe approach to learning about microbes?","Use prepared illustrations and never try to culture or handle them","Grow unknown organisms at home","Collect samples from drains","Illustrative models are safe; culturing or handling unknown microbes is not appropriate.","Choose the no-contact learning method."],
 ["Why are some bacteria useful in food production?","They can help make foods such as yoghurt","All bacteria make food spoil","They are plant leaves","Some bacteria are used to produce foods such as yoghurt.","Remember the helpful bacteria example."],
 ["What should someone do if they are worried about an illness?","Talk with a trusted adult and appropriate health professional","Try to identify microbes by growing them","Stop all hygiene practices","Health concerns should be discussed with a trusted adult and qualified health professional.","Choose a safe source of help."],
 ["Why is a magnified microbe drawing not to scale?","It enlarges tiny forms to show illustrative shapes","Microbes are larger than people","Every microbe is the same size","Magnification makes tiny organisms visible in a model; size and shape vary.","Look at the word 'magnified'."],
 ["Which statement best summarizes microorganisms?","They are diverse; some help people and ecosystems, while some cause disease","All microbes have the same role","Microbes only live in food","Microorganisms have varied roles in health, food and ecosystems.","Consider several roles, not just one."]
 ]},
 {id:"bio-animal-reproduction",grade:8,title:"Reproduction in Animals",short:"Animal reproduction & life cycles",kind:"animal-reproduction",intro:"Explore animal reproduction and life cycles with respectful, age-appropriate examples such as birds, frogs and mammals.",note:"Simplified life-cycle diagrams. Human reproduction is not described here; examples focus on general animal life cycles.",controls:[{key:"animal",label:"Example life cycle",type:"select",value:"Frog",options:["Frog","Bird","Mammal"]},{key:"stage",label:"Inspect stage",type:"select",value:"Young",options:["Egg","Young","Adult","Reproduction"]}],explain:"",predict:"What does reproduction enable a species to do?",predictOptions:["Produce new individuals","Make every individual live forever"],observe:"How can a young animal differ from an adult?",choices:["It can grow and change through life stages","It is always a different species","It never needs food"],answer:0,hint:"Compare the young and adult stages in the selected life cycle.",learn:"Animals reproduce to produce new individuals. Many animals have young that grow into adults; some life cycles include major changes in form, such as a tadpole becoming a frog. Animal life cycles vary.",diagram:["Egg / early stage","Young animal","Growth & development","Adult","Life cycle varies by species"],quiz:[
 ["What is reproduction?","A process that produces new individuals","A process that makes an animal live forever","A kind of movement only","Reproduction produces new individuals and supports continuation of a species.","Think about how a new generation begins."],
 ["What is a life cycle?","Stages an organism passes through as it develops","A list of animal habitats","A single meal","Life cycles describe stages from early development through growth and reproduction.","Think about stages across time."],
 ["What happens to many young animals as they develop?","They grow and become adults","They remain exactly the same size","They change into plants","Many young animals grow and develop into adults.","Compare young and adult stages."],
 ["Which change occurs in a frog's life cycle?","A tadpole develops into a frog","An adult frog becomes a bird","Eggs change directly into soil","Frogs develop through stages including tadpole and adult.","Think of the familiar frog stages."],
 ["How is a bird's early life stage commonly shown?","An egg hatches and a young bird grows","A seed grows into a chick","A tadpole grows feathers","Birds develop from eggs and young birds grow toward adulthood.","Choose the bird life-cycle example."],
 ["Do all animal life cycles look identical?","No, stages vary among kinds of animals","Yes, all animals hatch from eggs","No, animals do not grow","Animal life cycles vary; some hatch from eggs and others develop differently.","Compare a frog, bird and mammal."],
 ["Why do young animals need food as they grow?","They need materials and energy for growth and life processes","Food changes them into another species","Only adult animals need energy","Young animals need nutrients and energy to grow and develop.","Think about what growth requires."],
 ["What does a life-cycle diagram help show?","The order of developmental stages","The exact size of every animal","All behavior in the wild","A life-cycle model summarizes developmental stages and their order.","Focus on stages and sequence."],
 ["Why use respectful, age-appropriate examples in this topic?","They explain biological ideas clearly while respecting learners","To hide that animals are living things","To suggest all species reproduce identically","Careful examples teach life science accurately and respectfully.","Think about clarity and differences among organisms."],
 ["Which statement about animal reproduction is accurate?","It supports continuation of a species, but life cycles differ","Every animal has exactly the same young","All animals reproduce in the same way","Reproduction produces new individuals; processes and life cycles vary.","Avoid assuming one example represents every animal."]
 ]},
 {id:"bio-adolescence",grade:8,title:"Reaching the Age of Adolescence",short:"Puberty & growing up",kind:"adolescence",intro:"Learn about puberty as a normal stage of growth. People develop at different rates; questions can be discussed with a trusted adult or health professional.",note:"Sensitive, scientific overview for middle-school learners. Everyone develops differently; this is general information, not personal medical advice.",controls:[{key:"topic",label:"Explore",type:"select",value:"Growth",options:["Growth","Body changes","Emotions","Healthy routines","Getting support"]},{key:"view",label:"Information view",type:"select",value:"Everyone",options:["Everyone","Some changes vary"]}],explain:"",predict:"Do all people begin and experience puberty at exactly the same age and pace?",predictOptions:["No, timing and pace vary","Yes, everyone follows the same schedule"],observe:"What is a good choice if a body or health question worries you?",choices:["Talk with a trusted adult or health professional","Compare yourself unkindly with others"],answer:0,hint:"Choose a respectful and reliable source of support.",learn:"Puberty is a normal part of growing up. Bodies change at different times and rates; changes can include growth and development of reproductive systems. Feelings may also change. Respect privacy, avoid comparisons, and seek trusted adult or health-professional support for concerns.",diagram:["Puberty · normal development","Growth rate · differs by person","Body changes · vary in timing","Feelings · support can help","Questions · trusted adult / clinician"],quiz:[
 ["What is puberty?","A normal stage of growth and development","An illness that everyone gets","A change that happens at exactly the same time for everyone","Puberty is a normal part of growing up.","Think about how children develop into adults."],
 ["Do all people experience puberty at the same age and pace?","No, timing and pace differ among people","Yes, every person follows the same exact schedule","Only one body type experiences puberty","People begin and move through puberty at different times and rates.","Remember that development varies."],
 ["Which can happen during puberty?","Growth and changes in body development","Everyone becomes the same height","A person's identity disappears","Puberty can include growth and physical development.","Choose a normal development change."],
 ["Can emotions change while someone is growing up?","Yes, feelings can change and support can help","No one ever has changing feelings","Feelings prove a person is ill","Emotional experiences can change; trusted support can be helpful.","Choose the kind, realistic statement."],
 ["What should students do if a health question worries them?","Talk with a trusted adult or health professional","Rely on rumors","Feel ashamed and stay silent","A trusted adult or qualified health professional can provide support.","Choose a reliable and safe source."],
 ["Why is comparing bodies unkind or unhelpful?","People develop differently and deserve respect","Everyone's body must match one example","Comparison changes how puberty works","Development varies, so comparisons can create unfair expectations.","Remember that people develop at different rates."],
 ["Which statement is a respectful way to discuss puberty?","Use accurate language and respect privacy","Make jokes about another person's changes","Share someone's private health details","Respectful language and privacy matter when discussing body changes.","Choose the response that protects dignity."],
 ["Is this lesson personal medical advice?","No, it is general learning information","Yes, it diagnoses each student","It replaces a health professional","General lessons cannot diagnose personal health concerns.","Check the learning note."],
 ["Why might a student need support during changes?","Trusted people can answer questions and provide reassurance","Support stops normal growth","Everyone has identical questions","Support can help learners understand changes and feel reassured.","Choose a supportive, non-judgmental option."],
 ["Which idea is most important when learning about adolescence?","Development is normal, varied and deserving of respect","Everyone changes at exactly the same rate","There is only one acceptable body shape","People develop differently and should be treated with respect.","Select the statement that avoids harmful comparisons."]
 ]},
 {id:"bio-conservation",grade:8,title:"Conservation of Plants and Animals",short:"Habitats & conservation",kind:"conservation",intro:"Explore how habitat change affects biodiversity and food webs, then compare conservation actions that protect species and ecosystems.",note:"Simplified habitat model; real ecosystems are complex. Examples illustrate conservation principles, not local species counts.",controls:[{key:"change",label:"Habitat change",type:"select",value:"Healthy habitat",options:["Healthy habitat","Deforestation","Restoration","Protected habitat"]},{key:"species",label:"Species group",type:"select",value:"Forest animals",options:["Forest animals","Plants","Pollinators","Endangered species"]}],explain:"",predict:"What may happen when a habitat is cleared?",predictOptions:["Organisms can lose food and shelter","All organisms gain more space"],observe:"Which action can support conservation?",choices:["Protect and restore habitats","Remove every native plant"],answer:0,hint:"Choose an action that helps keep a habitat healthy.",learn:"Habitats provide food, water, shelter and space. Habitat loss and fragmentation can threaten biodiversity and endangered species. Protected areas, habitat restoration, sustainable choices and community conservation can help plants and animals.",diagram:["Habitat · food, water & shelter","Biodiversity · variety of life","Habitat loss · fewer resources","Protection · safer places","Restoration · repair habitat"],quiz:[
 ["What is a habitat?","A place that provides organisms with resources and conditions","A list of endangered species only","An animal's body covering","Habitats provide resources such as food, water and shelter.","Think of what a living thing needs from its surroundings."],
 ["What does biodiversity describe?","The variety of living things","The amount of rainfall only","One animal's life cycle","Biodiversity refers to variety among living things.","Recall the meaning of diversity."],
 ["What can deforestation do to forest organisms?","Remove or reduce habitat, food and shelter","Create unlimited resources for every species","Stop all changes in an ecosystem","Deforestation can remove habitat and reduce resources.","Follow what happens when trees and habitat disappear."],
 ["What is an endangered species?","A species at risk of extinction","A species that lives only in water","Any organism in a forest","Endangered species face a risk of extinction.","Think about the risk to the species' future."],
 ["How can habitat fragmentation affect wildlife?","It can split habitat into smaller separated areas","It joins every habitat into one","It creates new food for all animals","Fragmentation separates habitat and can make movement and access to resources harder.","Look at how roads or clearing divide spaces."],
 ["Which is a conservation action?","Protecting and restoring habitats","Removing all native plants","Disturbing nesting areas","Habitat protection and restoration can support biodiversity.","Choose an action that safeguards habitat."],
 ["Why do food webs matter when conserving habitat?","Species depend on connected food and resource relationships","Each species lives without affecting others","Food webs contain only predators","Ecosystem relationships mean changes can affect multiple species.","Trace connections among plants, animals and decomposers."],
 ["What can restoration do?","Help repair a damaged habitat","Guarantee every species returns immediately","Replace all ecosystems with one crop","Restoration can improve habitat, though recovery takes time and varies.","Avoid assuming recovery is instant."],
 ["Why might protected areas help?","They can safeguard habitats and species from some pressures","They make all natural change stop","They are useful only for one animal","Protected areas can conserve important habitats and biodiversity.","Think about what protection can reduce."],
 ["Which response best describes conservation?","Actions that protect biodiversity and the habitats organisms depend on","Keeping all organisms in one place","Stopping people from learning about nature","Conservation supports species, habitats and ecological relationships.","Consider both organisms and their homes."]
 ]}
];
const biologyGradeInfo={
 6:{name:"Class 6",description:"Discover plant parts, living diversity, movement, classification and life processes.",ids:["bio-plant-world","bio-diversity","bio-plant-exploring","bio-movement","bio-classification","bio-characteristics"]},
 7:{name:"Class 7",description:"Explore nutrition, respiration, transport, plant reproduction and forest ecosystems.",ids:["bio-photosynthesis","bio-digestion","bio-respiration","bio-transport","bio-plant-repro","bio-forest"]},
 8:{name:"Class 8",description:"Investigate cells, microorganisms, animal life cycles, adolescence and conservation.",ids:["bio-cell","bio-microbes","bio-animal-reproduction","bio-adolescence","bio-conservation"]}
};
