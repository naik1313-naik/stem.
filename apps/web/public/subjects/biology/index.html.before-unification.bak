function drawMotion(v,w,h){
 const y=h*.68,left=w*.12,right=w*.88,len=right-left;
 line(left,y,right,y,"#a4b6bb",3);
 for(let i=0;i<=10;i++){let x=left+len*i/10;line(x,y-5,x,y+7,"#728890",1);text(`${(v.distance*i/10).toFixed(0)}`,x,y+21,"#9baeb3",9,"center");}
 text("Distance along track (m)",w/2,y+43,"#a9b9be",10,"center");
 text("Metre (m) · centimetre (cm) · millimetre (mm)",w/2,h-18,"#8ea1a7",9,"center");
 const phase=(state.elapsed*v.speed/Math.max(v.distance,1))%1;
 if(v.path==="Straight line"){const x=left+phase*len;circle(x,y-10,9,"#ffb66d");text("rectilinear",left,y-37,"#c0d0d2",10);}
 else if(v.path==="Circular path"){const cx=w*.5,cy=h*.39,r=Math.min(w*.17,h*.21);ctx.strokeStyle="#728890";ctx.lineWidth=2;ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);ctx.stroke();const a=phase*Math.PI*2;circle(cx+Math.cos(a)*r,cy+Math.sin(a)*r,8,"#ffb66d");text("circular",cx,cy-r-13,"#c0d0d2",10,"center");}
 else{const x=left+Math.abs(Math.sin(phase*Math.PI*2))*len;circle(x,y-10,9,"#ffb66d");line(left,y+32,right,y+32,"#789097",1,[3,5]);text("periodic · back and forth",w/2,y-37,"#c0d0d2",10,"center");}
 text("Tools: ruler  ·  measuring tape  ·  metre scale",w/2,36,"#9cb0b5",10,"center");
}
function drawShadow(v,w,h){
 if(v.demo==="Plane mirror"){const my=w*.59;line(my,50,my,h-40,"#9bd8df",4);text("plane mirror",my+8,55,"#a4d5d7",10);const ox=w*.33,oy=h*.53;circle(ox,oy,17,"#ffb66d");text("object",ox,oy+33,"#c7d2d3",9,"center");circle(my+(my-ox),oy,17,"#ffb66d66");text("virtual image",my+(my-ox),oy+35,"#c7d2d3",9,"center");arrow(ox+20,oy-30,my-6,oy-30,"#ffdb98",1.5);arrow(my+6,oy-15,my+(my-ox)-15,oy-15,"#69e0c1",1.5);text("left ↔ right reversed",w/2,h-22,"#b7c8ca",10,"center");return;}
 if(v.demo==="Pinhole camera"){const cx=w*.52,py=h*.47;ctx.strokeStyle="#8fa3aa";ctx.lineWidth=3;ctx.strokeRect(cx-70,py-65,145,130);line(cx,py-65,cx,py+65,"#ffcf8d",2);text("tiny pinhole",cx,py-76,"#d4c3a9",9,"center");for(let i=-1;i<=1;i++){line(45,py+i*29,cx,py+i*8,"#ffc879",1.5);line(cx,py+i*8,cx+65,py-i*24,"#9bd9d1",1.4);}text("upright object",43,py+75,"#bdc9ca",9);text("inverted image",cx+80,py+79,"#bdc9ca",9);text("Light travels in straight lines",w/2,35,"#aebfc2",10,"center");return;}
 const sourceX=w*.13,screenX=w*.83,objectX=w*(.3+v.position*.045),cy=h*.5,ox=objectX;
 circle(sourceX,cy,9,"#ffe49b");text("luminous source",sourceX,cy-20,"#c9d4d3",9,"center");
 ctx.strokeStyle="#d0dadd";ctx.lineWidth=2;ctx.strokeRect(screenX,cy-75,6,150);text("screen",screenX+8,cy-82,"#c1cdcf",9);
 const opacity=v.material==="Opaque"?1:v.material==="Translucent"?0.42:0;
 if(opacity){ctx.fillStyle=`rgba(16,26,34,${opacity})`;ctx.fillRect(screenX+8,cy-18,24,36);ctx.strokeStyle="#ffb66d";ctx.lineWidth=2;ctx.fillStyle="#ffb66d";ctx.beginPath();ctx.moveTo(ox,cy-25);ctx.lineTo(ox-14,cy+14);ctx.lineTo(ox+14,cy+14);ctx.closePath();ctx.fill();ctx.stroke();line(sourceX+10,cy,ox,cy,"#ffdb98",1.5);line(ox+14,cy-18,screenX,cy-38,"#ffdb98",1);line(ox+14,cy+18,screenX,cy+38,"#ffdb98",1);}
 else{ctx.fillStyle="#ffb66d66";ctx.beginPath();ctx.arc(ox,cy,14,0,Math.PI*2);ctx.fill();line(sourceX+10,cy,screenX,cy,"#ffdb98",1.5);text("Light passes through",w*.52,cy+48,"#c9d5d5",10,"center");}
 text(`${v.material} object`,ox,cy+36,"#c9d5d5",9,"center");text(opacity?"shadow":"no dark shadow",screenX+22,cy+7,"#c9d5d5",9);
}
function drawCircuit(v,w,h,liquid){
 const x1=w*.15,x2=w*.85,top=h*.28,bot=h*.73,cy=(top+bot)/2;
 const closed=!!v.closed,material=v.material||v.liquid;
 const conducts=liquid?["Salt solution","Lemon solution"].includes(v.liquid):["Copper","Iron","Aluminium"].includes(v.material);
 const lit=closed&&conducts;
 const switchX=x1+(x2-x1)*.2,bulbX=x1+(x2-x1)*.61;
 line(x1,top,switchX-10,top,"#70d6bc",2);
 line(switchX+10,top,bulbX-18,top,"#70d6bc",2);
 line(bulbX+18,top,x2,top,"#70d6bc",2);
 line(x2,top,x2,bot,"#70d6bc",2);
 const testStart=x1+(x2-x1)*.4,testEnd=x1+(x2-x1)*.65;
 line(x2,bot,testEnd,bot,"#70d6bc",2);line(testStart,bot,x1,bot,"#70d6bc",2);
 line(x1,bot,x1,cy+12,"#70d6bc",2);line(x1,cy-12,x1,top,"#70d6bc",2);
 line(x1-13,cy-12,x1+13,cy-12,"#f1f3df",3);line(x1-8,cy+12,x1+8,cy+12,"#f1f3df",2);
 text("+",x1+18,cy-9,"#d8e2df",10);text("−",x1+16,cy+17,"#d8e2df",10);text("cell",x1-5,cy+34,"#aebfc1",9,"center");
 line(switchX-10,top,switchX-4,top,"#70d6bc",2);line(switchX+10,top,switchX+16,top,"#70d6bc",2);
 line(switchX-4,top,switchX+7,top-(closed?0:12),"#ffe09a",2);
 text("switch",switchX,top-21,"#aebfc1",8,"center");
 circle(bulbX,top,15,lit?"#ffe09a":"#75858b",lit?"#ffbf68":"#9dabad");
 line(bulbX-8,top,bulbX+8,top,lit?"#fff1c8":"#bec8c8",2);
 text("bulb",bulbX,top-24,"#c4d0d0",8,"center");
 if(liquid){
   const vesselY=bot-37,vesselW=testEnd-testStart,center=(testStart+testEnd)/2;
   ctx.fillStyle="#1d4655";ctx.fillRect(testStart+2,vesselY+5,vesselW-4,31);
   ctx.strokeStyle="#8bbec2";ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(testStart,vesselY);ctx.lineTo(testStart,vesselY+38);ctx.lineTo(testEnd,vesselY+38);ctx.lineTo(testEnd,vesselY);ctx.stroke();
   line(center-11,vesselY-7,center-11,vesselY+25,"#d9d4a0",2);line(center+11,vesselY-7,center+11,vesselY+25,"#c4a4a0",2);
   if(v.demo==="Electroplating"&&lit){ctx.strokeStyle="#ffcc72";ctx.lineWidth=3;ctx.strokeRect(center+8,vesselY-6,6,34);text("coating",center+17,vesselY-8,"#ffda91",7);}
   text(v.liquid,center,bot+16,"#c7d3d2",8,"center");
 }else{
   ctx.fillStyle=conducts?"#284945":"#44343a";ctx.fillRect(testStart,bot-10,testEnd-testStart,20);
   ctx.strokeStyle=conducts?"#69e0c1":"#ff9b86";ctx.lineWidth=1.5;ctx.strokeRect(testStart,bot-10,testEnd-testStart,20);
   text(material||"sample", (testStart+testEnd)/2,bot+25,"#c7d3d2",8,"center");
 }
 if(lit&&state.running){for(let i=0;i<12;i++){const t=((state.elapsed*1.1+i/12)%1);const perimeter=2*(x2-x1)+2*(bot-top);let d=t*perimeter,px,py;if(d<x2-x1){px=x1+d;py=top;}else if((d-=x2-x1)<bot-top){px=x2;py=top+d;}else if((d-=bot-top)<x2-x1){px=x2-d;py=bot;}else{d-=x2-x1;px=x1;py=bot-d;}circle(px,py,2.4,"#fff0ae");}}
 else{for(let i=0;i<7;i++)circle(x1+15+i*9,bot,2,"#f9c978");}
 text(liquid?"virtual conducting-liquid circuit":"cell · wires · switch · test material · bulb",w/2,h-19,"#9fb0b4",9,"center");
}
function drawMagnets(v,w,h){
 const cx=w*.5,cy=h*.48,magnetic=["Iron nail","Steel paper clip"].includes(v.material),attract=v.poles==="North + South";
 const drawBar=(x,y,north,flip=false)=>{ctx.save();if(flip){ctx.translate(x,y);ctx.scale(-1,1);ctx.translate(-x,-y);}ctx.fillStyle="#e77e72";ctx.fillRect(x-50,y-16,50,32);ctx.fillStyle="#769fe2";ctx.fillRect(x,y-16,50,32);text("N",x-25,y+5,"#fff",12,"center");text("S",x+25,y+5,"#fff",12,"center");ctx.restore();};
 text("Made magnet · bar magnet",cx,42,"#b9c9cc",10,"center");drawBar(cx-89,cy,true);drawBar(cx+89,cy,false,!attract);
 const gap=attract?28:70;
 if(attract)for(let i=-2;i<=2;i++){const yy=cy+i*13;ctx.beginPath();ctx.strokeStyle="#69e0c180";ctx.lineWidth=1;ctx.moveTo(cx-38,yy);ctx.quadraticCurveTo(cx,cy+i*5,cx+38,yy);ctx.stroke();}
 else{arrow(cx-35,cy-38,cx-72,cy-38,"#ff9b81",1.5);arrow(cx+35,cy-38,cx+72,cy-38,"#ff9b81",1.5);}
 const objX=cx,objY=h*.77;ctx.fillStyle=magnetic?"#c5d4d7":"#9b795a";ctx.fillRect(objX-30,objY-6,60,12);text(v.material, objX,objY+22,"#c2d0d0",10,"center");text(magnetic?"attracted to magnet":"not attracted in this model",cx,h-17,magnetic?"#a5e4d3":"#bbc5c7",10,"center");
 ctx.fillStyle="#766852";ctx.beginPath();ctx.moveTo(w*.1,h*.68);ctx.lineTo(w*.12,h*.61);ctx.lineTo(w*.17,h*.59);ctx.lineTo(w*.21,h*.63);ctx.lineTo(w*.22,h*.69);ctx.closePath();ctx.fill();text("natural lodestone",w*.16,h*.73,"#c1c9c4",8,"center");
 ctx.save();ctx.translate(w*.16,h*.3);ctx.rotate(state.running?Math.sin(state.elapsed*2)*.25:0);arrow(-26,0,25,0,"#a7d6de",2);ctx.restore();text("compass",w*.16,h*.3+26,"#9eb1b6",9,"center");text(attract?"unlike poles attract":"like poles repel",cx,cy+45,"#e2c28f",10,"center");
}
function drawHeat(v,w,h){
 const cy=h*.53;
 text(`Cool reference: 20 °C     ·     Warm sample: ${v.temperature} °C`,w/2,42,"#d8e6e2",11,"center");
 if(v.transfer==="Conduction"){const x0=w*.18,x1=w*.82,y=cy;line(x0,y,x1,y,"#9aaeb4",14);for(let i=0;i<14;i++){const x=x0+30+i*(x1-x0-60)/13;const shift=state.running?Math.sin(state.elapsed*7+i)*3:0;circle(x+shift,y+Math.sin(i)*2,4,i<5?"#ff8869":"#d6b77d");if(i<13)arrow(x+8,y-20,x+24,y-20,"#ff9b6b",1);}text("energy passes through a solid",w/2,y+50,"#b8c8ca",10,"center");}
 else if(v.transfer==="Convection"){ctx.fillStyle="#233b48";ctx.fillRect(w*.34,cy-70,w*.32,140);ctx.strokeStyle="#89a9ae";ctx.strokeRect(w*.34,cy-70,w*.32,140);for(let i=0;i<5;i++){const a=state.elapsed*1.1+i*Math.PI*2/5;const x=w*.5+Math.cos(a)*w*.09,y=cy+Math.sin(a)*48;circle(x,y,5,Math.sin(a)>0?"#84bfff":"#ff8e69");}arrow(w*.38,cy+35,w*.38,cy-36,"#ff9b6b",1.7);arrow(w*.62,cy-35,w*.62,cy+36,"#86bcff",1.7);text("warm fluid rises · cool fluid sinks",w/2,cy+91,"#b8c8ca",10,"center");}
 else{circle(w*.5,cy-20,31,"#ffbd67");for(let i=0;i<7;i++){const a=i*Math.PI*2/7+state.elapsed*.2;arrow(w*.5+Math.cos(a)*42,cy-20+Math.sin(a)*42,w*.5+Math.cos(a)*94,cy-20+Math.sin(a)*70,"#ffc980",1.4);}ctx.fillStyle=v.surface==="Dark"?"#4a5057":"#eee8d7";ctx.fillRect(w*.37,cy+62,w*.26,17);text(`${v.surface} surface · ${v.surface==="Dark"?"absorbs more":"absorbs less"} radiation`,w/2,cy+103,"#c4d0d1",10,"center");}
 text("Clinical thermometer → body temperature   ·   Laboratory thermometer → experiments",w/2,h-17,"#94a9ae",9,"center");
}
function drawMotionTime(v,w,h){
 const left=w*.13,base=h*.77,top=h*.2,right=w*.7;
 line(left,top,left,base,"#9caeb2",1.5);line(left,base,right,base,"#9caeb2",1.5);text("distance (m)",left-5,top-8,"#aababe",9);text("time (s)",right,base+18,"#aababe",9);
 for(let i=0;i<=4;i++){const x=left+(right-left)*i/4,y=base-(base-top)*i/4;line(x,base-3,x,base+3,"#6e858c",1);text((v.time*i/4).toFixed(0),x,base+14,"#9aadb2",8,"center");line(left-3,y,left+3,y,"#6e858c",1);text((v.distance*i/4).toFixed(0),left-10,y+3,"#9aadb2",8,"right");}
 const slope=Math.min(v.distance/v.time,10),endY=base-(base-top)*Math.min(slope/10,1);arrow(left,base,right,endY,"#69e0c1",2.5);
 text(`slope = speed = ${(v.distance/v.time).toFixed(1)} m/s`,(left+right)/2,top-9,"#bcebdc",10,"center");
 const progress=state.running?Math.min(state.elapsed/v.time,1):0;circle(left+(right-left)*progress,base+(endY-base)*progress,5,"#ffb66d");
 const px=w*.84,py=h*.42,r=Math.min(h*.2,57),period=2*Math.PI*Math.sqrt(v.length/9.8),a=Math.sin(state.elapsed*2*Math.PI/period)*.35;line(px,py,px+Math.sin(a)*r,py+Math.cos(a)*r,"#c3d2d4",2);circle(px,py,4,"#edf0e7");circle(px+Math.sin(a)*r,py+Math.cos(a)*r,10,"#ffb66d");ctx.strokeStyle="#70868d";ctx.beginPath();ctx.arc(px,py,r,-.35+Math.PI/2,.35+Math.PI/2);ctx.stroke();text(`L = ${v.length} m`,px,py+r+25,"#b0c1c4",9,"center");text("pendulum",px,py-r-12,"#b0c1c4",9,"center");
}
function drawCurrent(v,w,h){
 if(v.effect==="Circuit symbols"){const labels=["cell","bulb","switch","wire","fuse"];labels.forEach((s,i)=>{const x=w*(.18+i*.16),y=h*.49;line(x-24,y,x+24,y,"#76d8c0",2);if(i===0){line(x-7,y-14,x-7,y+14,"#fff",2);line(x+7,y-8,x+7,y+8,"#fff",2);}else if(i===1){circle(x,y,13,"transparent","#ffd28c");line(x-8,y+8,x+8,y-8,"#ffd28c",1.4);}else if(i===2){line(x-15,y,x-5,y,"#aaa",1.5);line(x-5,y,x+11,y-11,"#aaa",2);line(x+15,y,x+24,y,"#aaa",1.5);}else if(i===4){ctx.strokeStyle="#ffb66d";ctx.strokeRect(x-9,y-9,18,18);}text(s,x,y+38,"#bfcccf",9,"center");});text("Common circuit symbols",w/2,h-24,"#aebec1",10,"center");return;}
 if(v.effect==="Heating effect"){line(w*.2,h*.57,w*.8,h*.57,"#9baeb4",5);for(let i=0;i<12;i++){const x=w*.24+i*w*.046;const pulse=state.running?(Math.sin(state.elapsed*5+i)+1)/2:.2;const heat=Math.round((v.current/8)*pulse*110);circle(x,h*.57,5+v.current*.18,`rgba(255,${120+heat},80,${.35+pulse*.55})`);}text("greater current · greater heating effect (conceptual)",w/2,h*.38,"#ffd1a0",10,"center");ctx.strokeStyle="#ffb66d";ctx.strokeRect(w*.43,h*.73,65,21);text("fuse · melts if current is too high",w/2,h*.84,"#b9c8ca",9,"center");}
 else{const cx=w*.46,cy=h*.51;ctx.strokeStyle="#ffbb76";ctx.lineWidth=3;ctx.beginPath();for(let x=-70;x<=70;x+=5){const y=Math.sin((x+state.elapsed*45)*.15)*18;ctx.lineTo(cx+x,cy+y);}ctx.stroke();ctx.strokeStyle="#9fadb0";ctx.lineWidth=2;ctx.strokeRect(cx-42,cy-31,84,62);text(v.effect==="Electric bell"?"electromagnet pulls arm":"current in a coil makes a magnet",w/2,h*.3,"#c5d2d2",10,"center");if(v.effect==="Electric bell"){circle(cx+56,cy,8,"#ffb66d");text("bell",cx+56,cy+27,"#bfcacc",9,"center");}text(`${v.turns} coil turns · ${v.current} A setting`,w/2,h*.82,"#bfcacc",10,"center");}
}
function drawOptics(v,w,h){
 if(v.element==="Prism"){const x=w*.47,y=h*.42;line(35,y+40,x-55,y,"#f5f0cf",3);ctx.fillStyle="#314854";ctx.strokeStyle="#bfd1d3";ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(x-45,y-65);ctx.lineTo(x+57,y);ctx.lineTo(x-45,y+65);ctx.closePath();ctx.fill();ctx.stroke();const colors=["#e95d5d","#f2924d","#f5d166","#70c875","#58b6d4","#6884e2","#a87ad6"];colors.forEach((c,i)=>line(x+40,y+(i-3)*2,w-35,y-65+i*20,c,2));text("white light",45,y+63,"#dce4e2",9);text("spectrum · seven colours",w-35,h*.78,"#c3ced0",9,"right");return;}
 const opticX=w*.63,base=h*.75,focal=3,scale=Math.min(w*.045,w*.18/8),height=v.size*19;
 const isMirror=v.element.includes("mirror"),convex=v.element==="Convex mirror"||v.element==="Convex lens";
 line(w*.1,base,w*.91,base,"#71868e",1,[4,5]);
 if(v.element==="Plane mirror"){line(opticX,h*.19,opticX,h*.75,"#d8e7e2",3);}
 else if(isMirror){ctx.beginPath();ctx.strokeStyle="#9ee0d1";ctx.lineWidth=4;ctx.moveTo(opticX+(convex?9:-9),h*.2);ctx.quadraticCurveTo(opticX+(convex?-22:22),h*.47,opticX+(convex?9:-9),h*.75);ctx.stroke();}
 else{ctx.beginPath();ctx.ellipse(opticX,h*.48,convex?12:6,56,0,0,Math.PI*2);ctx.fillStyle="#73b9bb40";ctx.fill();ctx.strokeStyle="#9edbd2";ctx.lineWidth=2;ctx.stroke();}
 const distance=Number(v.object),ox=opticX-distance*scale,oy=base-height;
 arrow(ox,base,ox,oy,"#ffb66d",2);text("object",ox,base+17,"#c4d0d1",9,"center");
 let imageX,imageHeight,isVirtual,side;
 if(v.element==="Plane mirror"){imageX=opticX+distance*scale;imageHeight=height;isVirtual=true;side="behind mirror";}
 else if(v.element==="Concave mirror"){
   isVirtual=distance<=focal;const imageDistance=Math.min((focal*distance)/Math.max(Math.abs(distance-focal),.6),7);
   imageX=opticX+(isVirtual?1:-1)*imageDistance*scale;imageHeight=Math.min(height*2.2,height*focal/Math.max(Math.abs(distance-focal),.7));side=isVirtual?"behind mirror":"in front of mirror";
 }else if(v.element==="Convex mirror"){
   isVirtual=true;const imageDistance=focal*distance/(focal+distance);imageX=opticX+imageDistance*scale;imageHeight=height*imageDistance/distance;side="behind mirror";
 }else if(v.element==="Concave lens"){
   isVirtual=true;const imageDistance=focal*distance/(focal+distance);imageX=opticX-imageDistance*scale;imageHeight=height*imageDistance/distance;side="same side as object";
 }else if(distance<=focal){
   isVirtual=true;const imageDistance=focal*distance/Math.max(focal-distance,.65);imageX=opticX-imageDistance*scale;imageHeight=Math.min(height*2,height*imageDistance/distance);side="same side as object";
 }else{
   isVirtual=false;const imageDistance=Math.min(focal*distance/(distance-focal),7);imageX=opticX+imageDistance*scale;imageHeight=Math.min(height*2,height*imageDistance/distance);side="opposite side";
 }
 imageX=Math.max(w*.08,Math.min(w*.91,imageX));
 const imageTop=base+(isVirtual?-imageHeight:imageHeight);
 arrow(imageX,base,imageX,imageTop,"#8ebcff",2);
 const rayY=base-height*.48;
 line(ox,oy,opticX,rayY,"#ffdc96",1.4);
 if(isVirtual){
   const endX=isMirror?Math.max(w*.08,opticX-scale*3):Math.min(w*.9,opticX+scale*3);
   const endY=base+height*.18;
   arrow(opticX,rayY,endX,endY,"#69e0c1",1.4);
   line(opticX,rayY,imageX,imageTop,"#8ebcff",1,[4,4]);
 }else{
   arrow(opticX,rayY,imageX,imageTop,"#69e0c1",1.4);
 }
 const type=isVirtual?"virtual · upright":"real · inverted";
 text(`${type} · ${side}`,w*.5,h*.91,"#c1d0d1",9,"center");
 text(isVirtual?"image (virtual)":"image (real)",imageX,base+17,"#a9c5e7",8,"center");
 if(v.element==="Plane mirror")text("same size · lateral inversion",w*.5,h*.84,"#b7c8ca",9,"center");
 else{const focusX=isMirror?opticX-focal*scale:opticX+focal*scale;circle(focusX,base,3,"#ffcc7b");text("F",focusX,base+12,"#c2b9a2",8,"center");}
 text(v.element,w*.5,35,"#c5d3d4",11,"center");
}
function drawLiquid(v,w,h){
 drawCircuit({...v,closed:v.closed},w,h,true);
 if(v.demo==="Magnetic"){ctx.strokeStyle="#ffb66d";ctx.lineWidth=2;for(let i=0;i<6;i++){ctx.beginPath();ctx.ellipse(w*.5,h*.53,55+i*9,24+i*7,0,0,Math.PI*2);ctx.stroke();}text("current creates a magnetic field",w/2,h*.22,"#c7d2d2",10,"center");}
 else if(v.demo==="Heating"){text(v.closed?"current → heating effect":"open switch · no current",w/2,h*.16,v.closed?"#ffd59b":"#bdc9ca",10,"center");}
 else{text(v.demo==="Electroplating"?"metal layer grows on the object":"charged particles carry current",w/2,h*.16,"#c7d2d2",10,"center");}
}
function drawForces(v,w,h){
 const cx=w*.5,cy=h*.55,force=v.strength,pushLength=45+force*5;ctx.fillStyle="#8ebcff";ctx.fillRect(cx-38,cy-29,76,58);text("object",cx,cy+5,"#10202a",10,"center");text(v.force,cx,cy-52,"#cedada",11,"center");
 if(v.force==="Muscular push"){arrow(cx-pushLength-5,cy,cx-42,cy,"#ffb66d",3);text("push · contact",cx-pushLength*.65,cy-15,"#d3c4ad",9,"center");}
 else if(v.force==="Friction"){arrow(cx+112,cy+23,cx+48,cy+23,"#ff9b86",3);arrow(cx-130,cy,cx-48,cy,"#69e0c1",2);text(v.surface==="Rough"?"rough · more friction":"smooth · less friction",cx,cy+60,"#c2cecf",9,"center");}
 else{const label={Magnetic:"magnet",Electrostatic:"charged object",Gravitational:"Earth"}[v.force];circle(cx-110,cy,18,v.force==="Magnetic"?"#759fe0":v.force==="Electrostatic"?"#d18ad6":"#7cc59c");text(label,cx-110,cy+34,"#c2ced0",9,"center");arrow(cx-84,cy,cx-42,cy,"#ffb66d",2);text("acts across a gap · non-contact",cx,cy+66,"#c2ced0",9,"center");}
 text(`Force strength: ${force} N (illustrative)`,cx,h-24,"#b7c6c8",10,"center");text("A force can change motion or shape",cx,35,"#c2d0d1",10,"center");
}
function drawPressure(v,w,h){
 if(v.demo==="Surface pressure"){const y=h*.62;ctx.fillStyle="#899ba0";ctx.fillRect(w*.32,y,w*.36,14);ctx.fillStyle="#d0a876";ctx.fillRect(w*.45,y-65,w*.1,65);arrow(w*.5,y-95,w*.5,y-68,"#ffb66d",3);const width=20+v.area*10;ctx.strokeStyle="#69e0c1";ctx.setLineDash([4,4]);ctx.strokeRect(w*.5-width/2,y-8,width,24);ctx.setLineDash([]);text(`Force = ${v.force} N`,w*.5,y-106,"#c4d0d1",10,"center");text(`Area = ${v.area} cm²  ·  Pressure = ${(v.force/v.area).toFixed(1)} N/cm²`,w*.5,y+46,"#c3d0d2",10,"center");text("Air around us also exerts atmospheric pressure",w*.5,y+67,"#aebfc1",9,"center");}
 else if(v.demo==="Fluid pressure"){const x=w*.33,y=h*.22;ctx.fillStyle="#183a49";ctx.fillRect(x,y,w*.34,h*.6);ctx.strokeStyle="#90b6bd";ctx.strokeRect(x,y,w*.34,h*.6);for(let i=0;i<5;i++){const d=(i+1)/6,reach=18+v.depth*4;arrow(x+w*.38,y+d*h*.6,x+w*.38+reach,y+d*h*.6,"#74bed0",1+d*2);text(`depth ${Math.round(v.depth*d)} m`,x+w*.57,y+d*h*.6+3,"#b6c8ca",8);}text("fluid pressure increases with depth",w*.5,h*.14,"#c2d0d1",10,"center");}
 else if(v.demo==="Wind currents"){circle(w*.5,h*.5,33,"#ffb66d");for(let i=0;i<6;i++){const a=i*Math.PI/3+state.elapsed*.35;arrow(w*.5+Math.cos(a)*48,h*.5+Math.sin(a)*35,w*.5+Math.cos(a)*105,h*.5+Math.sin(a)*62,"#8ebcff",2);}text("uneven heating → moving air → wind",w*.5,h*.84,"#c2d0d1",10,"center");}
 else{const cx=w*.5,cy=h*.53;for(let i=0;i<6;i++){const r=27+i*22;ctx.beginPath();ctx.ellipse(cx,cy,r,r*.48,state.elapsed*.12,0,Math.PI*2);ctx.strokeStyle=`rgba(142,188,255,${.8-i*.09})`;ctx.lineWidth=2;ctx.stroke();}text("LOW PRESSURE",cx,cy+4,"#ffbca8",9,"center");text("Cyclone model · not a forecast",cx,h-22,"#ffcf91",10,"center");}
}
function drawSound(v,w,h){
 const cx=w*.51,cy=h*.46,amp=v.amplitude*3.1,freq=v.frequency;
 const cycles=2+Math.log10(Math.max(freq,10)/10)*1.65;
 line(w*.12,cy,w*.88,cy,"#637b83",1,[3,5]);ctx.beginPath();ctx.strokeStyle=v.soundtype==="Noise"?"#ffb66d":"#72ddc0";ctx.lineWidth=2.5;for(let x=w*.13;x<w*.88;x+=2){const phase=(x-w*.13)/w*cycles*Math.PI*2+state.elapsed*2;const wave=v.soundtype==="Noise"?(Math.sin(phase)+.35*Math.sin(phase*2.7)+.18*Math.sin(phase*4.1))/1.53:Math.sin(phase);const y=cy-wave*amp;if(x===w*.13)ctx.moveTo(x,y);else ctx.lineTo(x,y);}ctx.stroke();
 text(`${v.soundtype} · ${freq} Hz · amplitude ${v.amplitude}`,w*.5,cy-amp-19,"#c1d0d1",10,"center");
 const mediumX=w*.51,mediumY=h*.75;for(let r=0;r<4;r++)for(let c=0;c<16;c++){const move=state.running&&v.medium!=="No medium"?Math.sin(state.elapsed*4+c*.6+r)*3:0;circle(mediumX-115+c*15+move,mediumY-19+r*13,2.1,v.medium==="No medium"?"#52636b":"#87b6bd");}
 text(v.medium==="No medium"?"No medium · sound cannot travel":`Vibrations through ${v.medium.toLowerCase()}`,mediumX,mediumY+48,"#bccacc",9,"center");
 const bx=w*.13,by=h*.72;ctx.strokeStyle="#d8a777";ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(bx,by-33);ctx.quadraticCurveTo(bx+13,by,bx,by+33);ctx.stroke();line(bx-14,by-27,bx-14,by+27,"#d8a777",2);text("voice box",bx,by+51,"#c6d1d1",8,"center");
 const ex=w*.88,ey=h*.72;ctx.strokeStyle="#d4b992";ctx.lineWidth=3;ctx.beginPath();ctx.arc(ex,ey,17,-1,1);ctx.stroke();line(ex-10,ey-23,ex-10,ey+23,"#d4b992",2);text("ear",ex,ey+44,"#c6d1d1",8,"center");
 text(v.frequency<20?"Infrasound · below usual hearing range":v.frequency>20000?"Ultrasound · above usual hearing range":"Within usual human hearing range",w*.5,35,"#c2d0d1",10,"center");
}
function drawEye(v,w,h){
 const left=w*.12,right=w*.56,cy=h*.53;
 if(v.surface==="Smooth mirror"){const n=v.rays;for(let i=0;i<n;i++){const y=cy+(i-(n-1)/2)*17;arrow(left,y,right,y-35,"#ffce87",1.6);arrow(right,y-35,left,y-70,"#69e0c1",1.4);}line(right,cy-90,right,cy+28,"#e2eeeb",3);text("smooth mirror · regular reflection",w*.34,cy+58,"#bdcaca",9,"center");}
 else{line(left,cy-35,right,cy-35,"#d8e4e0",5);for(let i=0;i<v.rays;i++){const y=cy-35+(i-(v.rays-1)/2)*5;arrow(left,y,right,y-3,"#ffcc82",1.5);for(let j=0;j<3;j++){const a=(j-1)*.45;arrow(right,y,right+45*Math.cos(a),y+45*Math.sin(a),"#74d7be",1.2);}}text("rough surface · scattered rays",w*.34,cy+40,"#bdcaca",9,"center");}
 const apex=w*.3,mirrorY=h*.78,angle=v.mirrorAngle*Math.PI/180,arm=35,half=Math.min(angle/2,Math.PI*.42);
 line(apex,mirrorY,apex-arm*Math.cos(half),mirrorY+arm*Math.sin(half),"#e2eeeb",2);
 line(apex,mirrorY,apex-arm*Math.cos(half),mirrorY-arm*Math.sin(half),"#e2eeeb",2);
 const imageCount=Math.max(1,Math.ceil(360/v.mirrorAngle)-1);
 for(let i=0;i<Math.min(imageCount,10);i++){const a=(i/Math.max(imageCount,1))*Math.PI*2;circle(apex+Math.cos(a)*20,mirrorY+Math.sin(a)*20,2.5,"#8ebcff");}
 text(`Two mirrors · ${v.mirrorAngle}° · about ${imageCount} images`,apex,mirrorY+41,"#c0cecf",7,"center");
 const eyeScale=Math.min(1,w/520),ex=Math.min(w*.8,w-180*eyeScale),ey=cy;
 ctx.fillStyle="#29404b";ctx.beginPath();ctx.ellipse(ex,ey,69*eyeScale,39*eyeScale,0,0,Math.PI*2);ctx.fill();ctx.strokeStyle="#a5c1c4";ctx.lineWidth=2;ctx.stroke();
 ctx.fillStyle="#8bd0d1";ctx.beginPath();ctx.ellipse(ex-13*eyeScale,ey,16*eyeScale,29*eyeScale,0,0,Math.PI*2);ctx.fill();circle(ex-7*eyeScale,ey,10*eyeScale,"#253d54");circle(ex-7*eyeScale,ey,4*eyeScale,"#101a23");
 ctx.fillStyle="#ffb66d";ctx.beginPath();ctx.arc(ex+43*eyeScale,ey,5*eyeScale,-Math.PI/2,Math.PI/2);ctx.stroke();arrow(ex+69*eyeScale,ey,ex+91*eyeScale,ey,"#8ebcff",1.5);
 text("cornea",ex-20*eyeScale,ey-47*eyeScale,"#d6e0df",8);text("iris",ex-30*eyeScale,ey+43*eyeScale,"#d6e0df",8);text("pupil",ex-6*eyeScale,ey+19*eyeScale,"#d6e0df",8);text("lens",ex+2*eyeScale,ey-43*eyeScale,"#d6e0df",8);text("retina",ex+46*eyeScale,ey+32*eyeScale,"#d6e0df",8);text("optic nerve",ex+95*eyeScale,ey+4*eyeScale,"#d6e0df",8);text("Light focuses on retina",ex,ey+75*eyeScale,"#bac8ca",9,"center");
}
function drawNatural(v,w,h){
 if(v.demo==="Earthquake waves"){const ground=h*.57;line(w*.08,ground,w*.92,ground,"#85a19f",2);ctx.fillStyle="#293a40";ctx.fillRect(w*.08,ground+3,w*.84,h*.36);const fx=w*.42,fy=ground+65;circle(fx,fy,7,"#ffb66d");circle(fx,fy,3,"#fff0c0");circle(fx,ground,5,"#ff8c82");text("focus · underground",fx,fy+21,"#d0d9d9",9,"center");text("epicentre",fx,ground-13,"#ffc3ac",9,"center");for(let i=0;i<4;i++){const r=(state.elapsed*38+i*33)%130;ctx.beginPath();ctx.strokeStyle=`rgba(255,182,109,${Math.max(.1,1-r/140)})`;ctx.lineWidth=2;ctx.arc(fx,fy,r,Math.PI*1.1,Math.PI*1.9);ctx.stroke();}text("seismic waves travel out from the focus",w*.67,h*.84,"#c3cdce",9,"center");}
 else if(v.demo==="Lightning"){const ground=h*.79;ctx.fillStyle="#37424a";ctx.beginPath();ctx.ellipse(w*.52,h*.25,w*.23,33,0,0,Math.PI*2);ctx.fill();text("charged storm cloud",w*.52,h*.25+4,"#e0e6e3",9,"center");for(let i=0;i<7;i++){const x=w*.35+i*w*.05,y=h*.45+Math.sin(i+state.elapsed*2)*12;ctx.fillStyle=i%2?"#ff9992":"#a8bfff";text(i%2?"−":"+",x,y,"#f4cc92",14,"center");}ctx.beginPath();ctx.moveTo(w*.5,h*.32);ctx.lineTo(w*.46,h*.48);ctx.lineTo(w*.53,h*.49);ctx.lineTo(w*.47,h*.68);ctx.strokeStyle="#f8df98";ctx.lineWidth=3;ctx.stroke();line(0,ground,w,ground,"#83938f",2);text("Lightning safety: go indoors · avoid water & open areas",w*.5,h*.92,"#ffcc91",9,"center");}
 else{const cx=w*.34,cy=h*.47;circle(cx,cy,35,"#b08c6b");text("rub",cx,cy+5,"#19252b",10,"center");for(let i=0;i<v.charge;i++){const a=i*Math.PI*2/v.charge;text(i%2?"+":"−",cx+Math.cos(a)*63,cy+Math.sin(a)*52,"#ffcf7e",12,"center");}const x2=w*.72;circle(x2,cy,27,v.relation.startsWith("Unlike")?"#8ebcff":"#d690d6");circle(x2-53,cy,27,"#d690d6");text(v.relation.startsWith("Unlike")?"+":"+",x2-53,cy+5,"#fff",12,"center");text(v.relation.startsWith("Unlike")?"−":"+",x2,cy+5,"#fff",12,"center");arrow(x2-22,cy-37,x2-43,cy-37,v.relation.startsWith("Unlike")?"#69e0c1":"#ff9086",1.7);text(v.demo==="Charging by rubbing"?"charge transfer by rubbing":`${v.relation} charges ${v.relation.startsWith("Unlike")?"attract":"repel"}`,w*.52,h*.82,"#c7d3d3",10,"center");}
}
document.querySelectorAll(".nav-button").forEach(btn=>btn.addEventListener("click",()=>{if(btn.dataset.grade==="home"){state.page="home";state.running=false;renderHome();renderNav();}else openGrade(Number(btn.dataset.grade));}));
$("home-button").addEventListener("click",()=>{state.page="home";state.running=false;renderHome();renderNav();});
window.addEventListener("resize",()=>draw());
renderHome();renderNav();
})();
</script>
</body>
</html>
