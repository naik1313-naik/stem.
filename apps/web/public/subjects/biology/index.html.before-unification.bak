  text(v.leaf==="Green leaf with chlorophyll"?"leaf · chlorophyll absorbs light":"leaf · less chlorophyll in this model",cx,cy+7,"#eff5dd",9,"center");arrow(w*.36,h*.34,cx-68,cy-15,"#8ebcff",2);text("CO₂",w*.34,h*.3,"#b8d2ef",10,"center");arrow(w*.38,h*.74,cx-55,cy+38,"#65c5e3",2);text("water",w*.35,h*.82,"#9dd9eb",9,"center");arrow(cx+70,cy-12,w*.76,h*.34,"#69e0c1",2);text("oxygen",w*.81,h*.3,"#a4ead7",9,"center");arrow(cx+65,cy+20,w*.76,h*.69,"#ffb66d",2);text("glucose",w*.81,h*.74,"#f3d09f",9,"center");
