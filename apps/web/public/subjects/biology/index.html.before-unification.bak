const chemAlloyFacts={"Steel (iron + carbon)":"Iron mixed with a small amount of carbon; strong and useful for buildings and tools.","Brass (copper + zinc)":"Copper and zinc; useful for fittings and musical instruments.","Bronze (copper + tin)":"Copper and tin; useful for statues and some bearings."};
function chemSolutionCapacity(solute,temp){if(solute==="Salt")return {Cool:2,Room:4,Warm:5}[temp];if(solute==="Sugar")return {Cool:3,Room:5,Warm:7}[temp];return 0;}
const explanations={
  "motion-distance":v=>`The orange dot is a moving object. Its track marks are a ruler scale: each mark shows distance in metres (m), and smaller lengths can be measured in centimetres (cm) or millimetres (mm). The motion menu changes the path to a straight, circular or repeating back-and-forth path. Speed changes how quickly the dot moves; track length changes the marked distance. In real life, a ruler, tape measure or metre scale is used to measure. This drawing is not to scale.`,
  "light-shadow":v=>`The yellow lamp makes light; the orange object does not make its own light, so we see it when light reflects from it. ${v.demo==="Shadow"?`The rays travel in straight lines. ${v.material==="Opaque"?"An opaque object blocks the rays and makes a dark shadow.":v.material==="Translucent"?"A translucent object scatters some light, so its shadow is softer.":"A transparent object lets most light pass, so there is little dark shadow."} Moving the object changes the shadow on the screen.`:v.demo==="Pinhole camera"?"The small hole lets a few straight rays cross. They form an upside-down image on the back of the camera.":"The flat mirror reflects the rays. The image appears behind the mirror, upright and left-right reversed; it is virtual, not a picture you can catch on a screen."} Change the material, object position or activity to compare. The ray drawing is simplified.`,
  "electric-circuits":v=>`The cell's long and short lines represent its positive and negative ends. The green lines are wires, the switch opens or closes the path, the orange sample is the tested material, and the bulb glows only when the path is closed and the sample conducts. Metals such as ${v.material} usually conduct; rubber, plastic and dry wood are insulators. Change the switch or sample to test the idea. This is a safe, low-voltage diagram, not real wiring.`,
  "magnets":v=>`The red half is the north pole (N) and the blue half is the south pole (S). The curved marks and arrows show the interaction: unlike poles attract and like poles repel. The sample bar changes colour to show whether ${v.material} is attracted in this simple test. The small needle is a compass; it lines up roughly north–south because Earth acts like a giant magnet. Change the facing poles or test material. Real magnetic fields are three-dimensional, so this sketch is only a guide.`,
  "heat":v=>`The number is a temperature in degrees Celsius (°C); the cool reference is 20 °C. The moving dots stand for tiny particles. ${v.transfer==="Conduction"?"In conduction, energy passes between neighbouring particles in a solid.":v.transfer==="Convection"?"In convection, warmer parts of a liquid or gas move up and cooler parts move down.":"In radiation, energy travels as waves from the warm source; it does not need air or touching."} Dark surfaces absorb more radiation than light surfaces. Change the transfer type, temperature or surface colour to compare. Thermometers measure temperature: clinical ones are for body temperature, laboratory ones for experiments. No real heat is used here.`,
  "motion-time":v=>`The graph's horizontal axis is time (s); its vertical axis is distance (m). The green line shows the journey and its slope represents speed: a steeper line means faster motion. When running, the orange dot marks progress along the journey. The orange bob is a pendulum; each swing repeats, and the length control changes its period (time for one full swing). Distance divided by time gives average speed in m/s. This graph assumes steady speed, and the pendulum uses a small-swing model.`,
  "current-effects":v=>`${v.effect==="Circuit symbols"?"The simple marks stand for a cell, bulb, switch, wire and fuse.":"The animated parts are a wire, coil or bell mechanism. A glowing wire represents heating by current; a coil around an iron core represents an electromagnet; in a bell, the magnet pulls an arm so the contact can make and break."} The current control changes the modelled heating strength, while more coil turns make a stronger electromagnet in this simplified model. A fuse melts to break a circuit if too much current flows. These are symbols and concepts, not mains wiring.`,
  "light":v=>`${v.element==="Prism"?"The pale ray is white light; the coloured rays show it spreading into seven colours in a prism.":"Gold rays show incoming light, green rays show reflected or refracted light, and the blue arrow marks an image. The object-distance and height controls move or resize the object. A plane mirror makes an upright virtual image; curved mirrors and lenses can make real or virtual images depending on the object position."} Select another mirror, lens or prism to compare. Ray diagrams use ideal surfaces and are not to scale.`,
  "electric-effects":v=>`The cell, wires and switch form a virtual circuit. The container and two electrodes represent a liquid sample; particles in a conducting liquid let current pass. ${v.liquid==="Salt solution"||v.liquid==="Lemon solution"?"This sample is shown as conducting.":"This sample is shown as a poor conductor."} With the switch closed, current can produce heating or a magnetic effect. In electroplating, a thin metal layer is deposited on the object. Choose a different effect or liquid to see the model change. Real liquids and electricity can be hazardous; this is only a diagram.`,
  "forces":v=>`${v.force==="Muscular push"?"The arrow is a hand's push on the blue object; touching makes it a contact force.":v.force==="Friction"?"The opposing arrows show friction resisting sliding; friction is a contact force, and a rough surface usually gives more friction than a smooth one.":`The blue object and ${v.force==="Magnetic"?"magnet":"charged object or Earth"} are separated. ${v.force} is a non-contact force, so it can act without touching.`} Change the force menu, strength or surface. The arrows show direction and relative size, not exact measured forces; a force can change motion or shape.`,
  "pressure-weather":v=>`${v.demo==="Surface pressure"?`The block presses on the outlined area. Pressure = force ÷ area, so spreading the same force over more area lowers pressure. The air around us also pushes in every direction; this is atmospheric pressure.`:v.demo==="Fluid pressure"?`The blue region is liquid. The arrows get longer lower down to show that fluid pressure increases with depth; the depth control changes the labels and arrows.`:v.demo==="Wind currents"?"The warm orange region heats nearby air; warm air rises and cooler air moves in, making a circulation that can create wind.":"The curved blue paths represent fast rotating winds around a low-pressure centre. The centre is labelled; the motion is a concept, not a weather prediction."} Adjust force, area, depth or model to compare. The weather pictures are greatly simplified and are not forecasts.`,
  "sound":v=>`The moving line is a sound wave: frequency (Hz) changes how close its waves are and represents pitch; amplitude changes wave height and represents loudness. The dots are particles in a medium. ${v.medium==="No medium"?"With no medium, sound cannot travel.":"Sound vibrations pass from particle to particle through "+v.medium.toLowerCase()+"."} The wave changes with the frequency, amplitude and music/noise controls. The small voice-box sketch shows where voice vibrations start; the ear labels show the outer ear, eardrum, tiny bones, cochlea and nerve. Human hearing is roughly 20–20,000 Hz. This drawing makes no real sound and its loudness is not calibrated.`,
  "reflection-eye":v=>`${v.surface==="Smooth mirror"?"The gold rays bounce from a smooth surface in an orderly way; this is regular reflection.":"The teal rays spread in different directions from a rough surface; this is diffused reflection."} The small angled mirrors and blue dots represent repeated reflections; changing their angle changes the approximate number of images. In the eye, the cornea and lens focus light on the retina; the iris controls the pupil, and the optic nerve carries signals to the brain. Change the surface, mirror angle or number of rays. Both diagrams are simplified, not to scale.`,
  "natural-phenomena":v=>`${v.demo==="Charging by rubbing"||v.demo==="Charge interaction"?`The plus and minus signs represent electric charges. Rubbing can transfer electrons between materials; opposite charges attract and like charges repel. The charge slider changes the number of signs shown.`:v.demo==="Lightning"?"The charged cloud and jagged bolt represent charge separation and a sudden electrical discharge to the ground. Lightning is much more complex than this drawing.":"The orange underground dot is the earthquake focus, where the shaking starts; the surface point above it is the epicentre. Expanding curves are seismic waves moving through Earth."} Change the model or charge pair to compare. Lightning and earthquake models are not forecasts or safety guides.`
};
const observationChecks={
  "motion-distance":{question:"If speed increases on the same straight track, what happens?",options:["The object reaches the end sooner.","The track becomes longer."],answer:0,feedback:"Speed changes how quickly the object moves. The marked track length stays the same."},
  "light-shadow":{question:"Which material blocks most light and makes the clearest shadow?",options:["Opaque material","Transparent material"],answer:0,feedback:"Opaque materials block light. Transparent materials let most light pass through."},
  "electric-circuits":{question:"What lets the bulb glow in this circuit?",options:["A closed path with a conducting sample","An open switch and an insulating sample"],answer:0,feedback:"Current needs a complete path, and the test material must conduct for this series circuit to light."},
  "magnets":{question:"What happens when two like poles face each other?",options:["They repel.","They attract."],answer:0,feedback:"Like poles repel; unlike poles attract."},
  "heat":{question:"Which surface absorbs more radiant energy?",options:["A dark surface","A light surface"],answer:0,feedback:"Dark surfaces generally absorb more radiant energy than light surfaces."},
  "motion-time":{question:"What happens when you make the pendulum longer?",options:["Its period gets longer; it swings more slowly.","Its period gets shorter; it swings faster."],answer:0,feedback:"For small swings, period is proportional to the square root of length. A longer pendulum takes more time for one swing."},
  "current-effects":{question:"What does a fuse do if too much current flows?",options:["It melts and breaks the circuit.","It adds more current to the circuit."],answer:0,feedback:"A fuse is designed to melt and interrupt the circuit when current is excessive."},
  "light":{question:"What happens when white light passes through a prism?",options:["It spreads into a spectrum of colours.","It stops travelling at the prism."],answer:0,feedback:"A prism separates white light into a spectrum of colours."},
  "electric-effects":{question:"What can happen when current passes through a conducting liquid?",options:["The liquid can conduct current and chemical changes may occur.","The liquid always becomes an insulator."],answer:0,feedback:"Some liquids conduct; chemical effects can happen in a suitable conducting solution."},
  "forces":{question:"For the same force, what happens if its area of contact gets larger?",options:["Pressure gets smaller.","Pressure gets larger."],answer:0,feedback:"Pressure is force divided by area. Spreading the same force over more area lowers pressure."},
  "pressure-weather":{question:"At the same force, what does a larger contact area do to pressure?",options:["It lowers the pressure.","It raises the pressure."],answer:0,feedback:"Pressure = force ÷ area, so a larger area gives lower pressure for the same force."},
  "sound":{question:"Can sound travel when there is no material medium?",options:["No. Sound needs a medium.","Yes. Sound travels through empty space."],answer:0,feedback:"Sound is a vibration passed through particles, so it cannot travel through a vacuum."},
  "reflection-eye":{question:"What usually happens to the number of images when two mirrors are brought closer together?",options:["More images can form.","Fewer images always form."],answer:0,feedback:"In the ideal model, a smaller angle between mirrors gives more repeated reflections and images."},
  "natural-phenomena":{question:"Where is an earthquake's focus?",options:["Below the ground, where the shaking starts.","On the surface directly above the focus."],answer:0,feedback:"The focus is underground. The epicentre is the point on the surface above it."}
};
const predictions={
  "motion-distance":{question:"If the object moves faster on the same track, what do you predict?",options:["It will reach the end sooner.","The measured track will get longer."],answer:0},
  "light-shadow":{question:"What do you predict an opaque object will do to the light?",options:["Block most light and make a dark shadow.","Let nearly all the light pass through."],answer:0},
  "electric-circuits":{question:"What do you predict when the switch is closed and copper fills the gap?",options:["The bulb will light.","The bulb will stay dark."],answer:0},
  "magnets":{question:"What do you predict when two north poles face each other?",options:["They will push apart.","They will pull together."],answer:0},
  "heat":{question:"Which surface do you predict will absorb more radiant energy?",options:["The dark surface.","The light surface."],answer:0},
  "motion-time":{question:"What do you predict if the pendulum is made longer?",options:["It will take more time for a swing.","It will take less time for a swing."],answer:0},
  "current-effects":{question:"What do you predict a fuse does when too much current flows?",options:["It melts and breaks the circuit.","It lets extra current keep flowing."],answer:0},
  "light":{question:"What do you predict white light does in a prism?",options:["Spreads into a band of colours.","Stops at the prism."],answer:0},
  "electric-effects":{question:"What do you predict in the electroplating model with a closed switch and conducting liquid?",options:["A thin coating builds on the object.","The liquid prevents all change."],answer:0},
  "forces":{question:"What do you predict roughness does to friction?",options:["A rougher surface usually increases friction.","A rougher surface removes friction."],answer:0},
  "pressure-weather":{question:"With the same force, what do you predict if the contact area increases?",options:["Pressure decreases.","Pressure increases."],answer:0},
  "sound":{question:"What do you predict sound does when there is no material medium?",options:["It cannot travel.","It travels just as it does through air."],answer:0},
  "reflection-eye":{question:"What do you predict when two mirrors are set at a smaller angle?",options:["More images can form.","No reflected images can form."],answer:0},
  "natural-phenomena":{question:"Where do you predict earthquake waves begin?",options:["At the underground focus.","At the surface epicentre."],answer:0}
};
const observationHints={
  "motion-distance":"Think about speed as how quickly position changes; the track marks are fixed.",
  "light-shadow":"Ask whether the material lets light pass or blocks it.",
  "electric-circuits":"Check both parts: is the path closed, and does copper conduct?",
  "magnets":"Compare the names of the two facing poles.",
  "heat":"Think about which colour takes in more energy from radiation.",
  "motion-time":"A longer pendulum swings more slowly.",
  "current-effects":"A fuse is a safety link that opens the path when current is too large.",
  "light":"A prism bends different colours of white light by different amounts.",
  "electric-effects":"In electroplating, current can move metal from a solution onto an object.",
  "forces":"Friction acts where surfaces touch and usually resists sliding.",
  "pressure-weather":"Use pressure = force divided by area.",
  "sound":"Sound is a vibration passed from particle to particle.",
  "reflection-eye":"The mirrors can reflect light back and forth more times at a smaller angle.",
  "natural-phenomena":"The focus is inside Earth; the epicentre is directly above it."
};
const defaultValues={};modules.forEach(m=>{defaultValues[m.id]={};m.controls.forEach(c=>defaultValues[m.id][c.key]=c.value);});
const chemistryDefaults={};chemistryModules.forEach(m=>{chemistryDefaults[m.id]={};m.controls.forEach(c=>chemistryDefaults[m.id][c.key]=c.value);});
const chemistryState={values:JSON.parse(JSON.stringify(chemistryDefaults)),completed:new Set(),investigated:new Set(),predictions:{},predictionChoices:{},answers:{},picked:{"chem-separation":0},quizScores:{6:null,7:null,8:null},quizAnswers:{6:Array(3).fill(null),7:Array(3).fill(null),8:Array(3).fill(null)}};
const biologyDefaults={};biologyModules.forEach(m=>{biologyDefaults[m.id]={};m.controls.forEach(c=>biologyDefaults[m.id][c.key]=c.value);});
const biologyState={values:JSON.parse(JSON.stringify(biologyDefaults)),completed:new Set(),investigated:new Set(),predictionChoices:{},predictions:{},answers:{},quizScores:{},quizAnswers:{},quizCycles:{},quizIndex:{},quizTopic:biologyModules[0].id};
biologyModules.forEach(m=>{biologyState.quizAnswers[m.id]=Array(m.quiz.length).fill(null);biologyState.quizScores[m.id]=null;biologyState.quizCycles[m.id]=0;biologyState.quizIndex[m.id]=0;});
const state={page:"home",subject:"biology",lastModule:{biology:biologyModules[0].id},grade:6,module:biologyModules[0].id,elapsed:0,running:false,visited:new Set(),completed:new Set(),investigated:new Set(),values:JSON.parse(JSON.stringify(defaultValues)),predictionChoices:{},predictions:{},observationAnswers:{},comparisons:{},quizScores:{6:null,7:null,8:null},quizAnswers:{6:Array(3).fill(null),7:Array(3).fill(null),8:Array(3).fill(null)}};
const $=id=>document.getElementById(id);
let ctx=null,canvasW=0,canvasH=0,dpr=1,raf=0,lastTime=0,canvasObserver=null;
const home=$("home-view"),gradeView=$("grade-view"),quizView=$("quiz-view");
function vals(id=state.module){return state.values[id];}
function current(){return modules.find(m=>m.id===state.module);}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':'&quot;',"'":"&#39;"}[c]));}
function activeGradeInfo(){return state.subject==="biology"?biologyGradeInfo:state.subject==="chemistry"?chemistryGradeInfo:gradeInfo;}
function progress(grade){const ids=activeGradeInfo()[grade].ids,done=state.subject==="biology"?biologyState.completed:state.subject==="chemistry"?chemistryState.completed:state.completed;return ids.filter(id=>done.has(id)).length;}
function updateSubjectChrome(){
  const biology=state.subject==="biology",chemistry=state.subject==="chemistry",title=biology?"Biology Virtual Lab":chemistry?"Chemistry Virtual Lab":"Physics Virtual Lab";
  document.title=title;$("page-title").textContent=title;
  document.querySelector(".brand-title").textContent=title.toUpperCase();
  document.querySelector(".welcome p").textContent=biology?"Explore Biology in separate Class 6, 7 and 8 sections. Predict, investigate, observe and explain with safe, interactive models.":chemistry?"Explore chemistry ideas from Classes 6, 7 and 8. Predict, investigate and explain using safe virtual models.":"Explore ideas from Classes 6, 7 and 8. Change one thing at a time, watch what happens, and make your own discoveries.";
  home.setAttribute("aria-label",biology?"Choose a Biology class":chemistry?"Choose a Chemistry class":"Choose a Physics class");
}
function renderHome(){
  updateSubjectChrome();
  if(state.subject==="biology"){renderBiologyHome();return;}
  if(state.subject==="chemistry"){renderChemistryHome();return;}
  home.hidden=false;gradeView.hidden=true;quizView.hidden=true;
  home.innerHTML=`<div class="home-grid">${Object.entries(gradeInfo).map(([g,info])=>{const done=progress(g),score=state.quizScores[g];return `<article class="grade-card" tabindex="0" role="button" data-open-grade="${g}" aria-label="Open ${info.name}"><div class="grade-card-head"><span class="grade-badge">${esc(info.name.replace("Class ","C"))}</span><span class="module-count">${info.ids.length} modules</span></div><h2>${esc(info.name)}</h2><p>${esc(info.description)}</p><div class="card-bottom"><span>${done}/${info.ids.length} complete · Quiz ${score===null?"not taken":`${score}/3`}</span><span class="progress-track"><span class="progress-fill" style="display:block;width:${done/info.ids.length*100}%"></span></span></div></article>`;}).join("")}</div><div class="home-tip"><strong>How to use the lab:</strong> First predict and submit. Then change a control or run the model, observe the result and answer the question. These are learning simulations—not real experiments. Progress and quiz scores stay in this browser session; no account or personal details are needed.</div>`;
  home.querySelectorAll("[data-open-grade]").forEach(card=>{card.addEventListener("click",()=>openGrade(Number(card.dataset.openGrade)));card.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();openGrade(Number(card.dataset.openGrade));}});});
}
function renderChemistryHome(){
  home.hidden=false;gradeView.hidden=true;quizView.hidden=true;
  const score=chemistryState.quizScores;
  home.innerHTML=`<div class="home-grid">${Object.entries(chemistryGradeInfo).map(([g,info])=>{const done=progress(Number(g)),quizScore=score[g];return `<article class="grade-card" tabindex="0" role="button" data-open-grade="${g}" aria-label="Open Chemistry ${info.name}"><div class="grade-card-head"><span class="grade-badge">${esc(info.name.replace("Class ","C"))}</span><span class="module-count">${info.ids.length} modules</span></div><h2>${esc(info.name)}</h2><p>${esc(info.description)}</p><div class="card-bottom"><span>${done}/${info.ids.length} complete · Quiz ${quizScore===null?"not taken":`${quizScore}/3`}</span><span class="progress-track"><span class="progress-fill" style="display:block;width:${done/info.ids.length*100}%"></span></span></div></article>`;}).join("")}</div><div class="home-tip"><strong>How to use Chemistry Virtual Lab:</strong> Predict first, submit, then investigate using the virtual controls. Observe the model and answer the knowledge check. These are safe learning models, not instructions for real experiments. Progress and scores stay in this browser session; no account or personal details are needed.</div>`;
  home.querySelectorAll("[data-open-grade]").forEach(card=>{card.addEventListener("click",()=>openGrade(Number(card.dataset.openGrade)));card.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();openGrade(Number(card.dataset.openGrade));}});});
}
function renderControls(m){
  return m.controls.map(c=>{
    const value=vals(m.id)[c.key];
    if(c.type==="select")return `<label class="control-item"><span class="control-line"><span class="control-label">${esc(c.label)}</span></span><select data-key="${esc(c.key)}" aria-label="${esc(c.label)}">${c.options.map(o=>`<option${o===value?" selected":""}>${esc(o)}</option>`).join("")}</select></label>`;
    if(c.type==="toggle")return `<div class="control-item"><span class="control-line"><span class="control-label">${esc(c.label)}</span><span class="control-value">${value?esc(c.on):esc(c.off)}</span></span><label class="toggle-row"><input type="checkbox" data-key="${esc(c.key)}" ${value?"checked":""} aria-label="${esc(c.label)}"><span>${value?esc(c.on):esc(c.off)}</span></label></div>`;
    const precision=c.step<1?1:0;
    return `<label class="control-item"><span class="control-line"><span class="control-label">${esc(c.label)}</span><span class="control-value" data-value-label="${esc(c.key)}">${Number(value).toFixed(precision)} ${esc(c.unit||"")}</span></span><input type="range" min="${c.min}" max="${c.max}" step="${c.step}" value="${value}" data-key="${esc(c.key)}" aria-label="${esc(c.label)}"><span class="range-minmax"><span>${c.min} ${esc(c.unit||"")}</span><span>${c.max} ${esc(c.unit||"")}</span></span></label>`;
  }).join("");
}
function renderPredictionPanel(m){
  const prompt=predictions[m.id];
  const submitted=state.predictions[m.id]!==undefined;
  const selected=submitted?state.predictions[m.id]:state.predictionChoices[m.id];
  return `<section class="prediction-box" aria-labelledby="prediction-heading">
    <h4 id="prediction-heading">1. Make a prediction</h4>
    <p>${esc(prompt.question)}</p>
    <div class="prediction-options" role="group" aria-label="Choose your prediction">
      ${prompt.options.map((option,index)=>`<button class="prediction-choice" type="button" data-prediction-choice="${index}" aria-pressed="${selected===index}" ${submitted?"disabled":""}>${esc(option)}</button>`).join("")}
    </div>
    ${submitted?`<p class="prediction-saved" role="status">Prediction saved: “${esc(prompt.options[selected])}” Now change a control or run the model and see what happens.</p>`:`<button class="prediction-submit" id="submit-prediction" type="button" ${selected===undefined?"disabled":""}>Submit prediction</button>`}
  </section>`;
}
function snapshotModule(m){
  return {
    settings:m.controls.map(c=>`${c.label}: ${c.type==="toggle"?(vals(m.id)[c.key]?c.on:c.off):vals(m.id)[c.key]}${c.type==="range"?" "+(c.unit||""):""}`).join(" · "),
    metrics:m.metrics().map(([label,value])=>`${label}: ${value}`)
  };
}
function renderComparison(m){
  const comparison=state.comparisons[m.id];
  if(!comparison||!comparison.first||!comparison.second)return "";
  const side=(label,snapshot)=>`<div class="comparison-side"><strong>${label}</strong><p>${esc(snapshot.settings)}</p><p>${snapshot.metrics.map(esc).join("<br>")}</p></div>`;
  return `<section class="comparison-results" aria-live="polite"><h5>Compare your settings</h5><div class="comparison-grid">${side("Setting A",comparison.first)}${side("Setting B",comparison.second)}</div></section>`;
}
function renderObservationPanel(m){
  const check=observationChecks[m.id];
  const selected=state.observationAnswers[m.id];
  const answered=selected!==undefined;
  const correct=answered&&selected===check.answer;
  const investigated=state.investigated.has(m.id);
  const completed=correct;
  return `<aside class="observation-box" aria-label="Simulation explanation and observation question">
    <div><h4 class="box-title">What is happening?</h4><div class="what-happening" id="what-happening" aria-live="polite">${esc(explanations[m.id](vals(m.id)))}</div><p class="what-values" id="what-values">${esc(currentControlSummary(m))}</p></div>
    <div class="observation-check"><h5>What did you notice?</h5><p>${esc(check.question)}</p>
      <div class="observation-options" role="group" aria-label="Choose an observation">
        ${check.options.map((option,index)=>`<button class="observation-choice${answered&&selected===index?(correct?" is-correct":" is-incorrect"):""}" type="button" data-observation-answer="${index}" aria-pressed="${selected===index}" ${investigated?"":"disabled"}>${esc(option)}</button>`).join("")}
      </div>
      <p class="comparison-status" id="investigation-prompt">${investigated?"Your investigation is ready. Choose an answer and compare it with your prediction.":"Change a control or press Run before answering."}</p>
      <p class="observation-feedback${answered?(correct?" good":" bad"):""}" id="observation-feedback" aria-live="polite">${answered?(correct?"That’s right. "+check.feedback+" "+(state.predictions[m.id]===predictions[m.id].answer?"Your prediction matched the model.":"Your prediction differed from the model. Comparing both is a useful way to learn."):"Try again. Hint: "+observationHints[m.id]):""}</p>
      <p class="activity-completion" id="activity-completion"${completed?"":" hidden"}>Nice work! Activity complete. Your progress is saved for this session.</p>
    </div>
    <details><summary>Learn more</summary><p>${esc(m.learn)}</p></details>
  </aside>`;
}
function currentControlSummary(m){
  return "Current settings: "+m.controls.map(control=>{
    const value=vals(m.id)[control.key];
    if(control.type==="toggle")return `${control.label} ${value?control.on:control.off}`;
    if(control.type==="select")return `${control.label} ${value}`;
    return `${control.label} ${Number(value).toFixed(control.step<1?1:0)} ${control.unit||""}`;
  }).join(" · ");
}
function formulaNumber(value,digits=2){return Number(value).toFixed(digits);}
function formulaDetails(m=current()){
  const v=vals(m.id),t=state.elapsed;
  switch(m.id){
    case "motion-distance":{
      const lap=v.distance/v.speed,phase=(t*v.speed/Math.max(v.distance,1))%1,position=phase*v.distance;
      return {formula:"Time per model pass = track length ÷ speed\nphase = (elapsed time × speed ÷ track length) mod 1\nposition along path = phase × track length",substitution:`T = ${v.distance} m ÷ ${v.speed} m/s = ${formulaNumber(lap)} s\nphase = (${formulaNumber(t)} s × ${v.speed} m/s ÷ ${v.distance} m) mod 1 = ${formulaNumber(phase,3)}\nposition = ${formulaNumber(phase,3)} × ${v.distance} m = ${formulaNumber(position)} m`,result:`One pass: ${formulaNumber(lap)} s · Current position along the ${v.path.toLowerCase()} path: ${formulaNumber(position)} m`,meaning:"The orange marker repeats around the selected path. The marker's progress is set by the speed and the elapsed animation time.",example:`Walking ${v.distance} m at ${v.speed} m/s would take about ${formulaNumber(lap)} s at a steady pace.`,note:"The marker loops for learning; this is not a measured journey. The drawing is not to scale."};
    }
    case "light-shadow":{
      if(v.demo==="Plane mirror")return {formula:"Plane mirror: image distance = object distance\nImage is virtual, upright and left-right reversed.",substitution:"The diagram places the virtual image the same distance behind the mirror as the object is in front.",result:"Equal distances in the drawing; no physical length is measured.",meaning:"A mirror image appears behind the mirror, even though light does not travel from that point.",example:"Your reflection appears as far behind a bathroom mirror as you stand in front of it.",note:"This mode draws a fixed mirror example. Material and position controls affect the shadow mode, not this diagram."};
      if(v.demo==="Pinhole camera")return {formula:"Light travels in straight lines:\ntop of object → pinhole → bottom of image",substitution:"Rays from opposite ends cross at the pinhole.",result:"The screen image is upside down; no size or distance is calculated.",meaning:"Only a small bundle of rays passes through the tiny opening and forms an inverted image.",example:"A pinhole camera can show an upside-down view of a bright outdoor scene.",note:"This is a ray sketch, not a full camera model. Material and position controls apply to the shadow mode."};
      const shadow=v.material==="Opaque"?"dark shadow":v.material==="Translucent"?"softer, dimmer shadow":"little or no dark shadow";
      return {formula:"Light blocked by an opaque object → shadow\nTranslucent material scatters some light; transparent material passes most light.",substitution:`Material = ${v.material}; object position = ${v.position} steps.`,result:`The model shows a ${shadow}.`,meaning:"Moving the object changes where its shadow falls. Material controls how much light is blocked in this drawing.",example:"A hand between a lamp and a wall blocks light and makes a shadow.",note:"Shadow size and brightness are illustrative, not calculated from real object dimensions or light intensity."};
    }
    case "electric-circuits":{
      const conducts=["Copper","Iron","Aluminium"].includes(v.material),lit=v.closed&&conducts;
      return {formula:"Bulb ON = switch closed AND sample conducts\n(conceptual circuit rule)",substitution:`${v.closed?"Closed":"Open"} switch AND ${v.material} (${conducts?"conductor":"insulator"})`,result:`Bulb ${lit?"ON":"OFF"} · ${lit?"complete path":"incomplete path"} (no current value is calculated)`,meaning:"A bulb lights in this model only when the path is closed and the sample conducts.",example:"A torch needs its switch on and a complete path through its metal contacts.",note:"The diagram does not set voltage, resistance or current, so it does not calculate electrical units."};
    }
    case "magnets":{
      const magnetic=["Iron nail","Steel paper clip"].includes(v.material),attract=v.poles==="North + South";
      return {formula:"Unlike poles attract · like poles repel\nIron and steel are magnetic in this model.",substitution:`Facing poles = ${v.poles}; test material = ${v.material}.`,result:`Poles ${attract?"attract":"repel"} · sample ${magnetic?"is attracted":"is not attracted in this model"}.`,meaning:"Pole names predict whether magnets pull together or push apart; the sample test shows whether this material responds to the magnet.",example:"A fridge magnet attracts many steel paper clips but not a wooden pencil.",note:"No force strength or distance is calculated. Real magnetic fields are three-dimensional."};
    }
    case "heat":{
      const delta=v.temperature-20;
      return {formula:"Temperature difference: ΔT = T warm sample − T cool reference",substitution:`ΔT = ${v.temperature} °C − 20 °C = ${delta} °C\nTransfer mode = ${v.transfer}; surface = ${v.surface.toLowerCase()}.`,result:`The warm sample is ${delta} °C above the cool reference.`,meaning:"The temperature setting changes the displayed sample reading. The selected mode changes the heat-transfer picture, not this temperature difference.",example:`If a drink is ${v.temperature} °C and the room is 20 °C, the difference is ${delta} °C.`,note:"Temperature difference is not heat energy. The model has no mass or material heat capacity, so it does not calculate transferred heat."};
    }
    case "motion-time":{
      const speed=v.distance/v.time,period=2*Math.PI*Math.sqrt(v.length/9.8),frequency=1/period,cycles=Math.floor(t/period),graphProgress=Math.min(t/v.time,1)*100;
      return {formula:"Average speed = distance ÷ time\nSmall-angle pendulum: T ≈ 2π√(L/g); f ≈ 1/T",substitution:`speed = ${v.distance} m ÷ ${v.time} s = ${formulaNumber(speed)} m/s\nT ≈ 2π√(${formulaNumber(v.length,1)} m ÷ 9.8 m/s²) = ${formulaNumber(period)} s\nf ≈ 1 ÷ ${formulaNumber(period)} s = ${formulaNumber(frequency)} Hz\nElapsed = ${formulaNumber(t)} s; completed swings ≈ floor(elapsed ÷ T) = ${cycles}.`,result:`Speed ${formulaNumber(speed)} m/s · period ${formulaNumber(period)} s · frequency ${formulaNumber(frequency)} Hz · ${cycles} full swing${cycles===1?"":"s"} · graph ${formulaNumber(graphProgress,0)}%`,meaning:"A longer pendulum takes more time per swing. The graph's slope is the speed, and its moving dot follows the elapsed animation time.",example:`A ${formulaNumber(v.length,1)} m pendulum takes about ${formulaNumber(period)} s per full swing in this small-swing model.`,note:"The period is approximate for small angles and uses fixed g = 9.8 m/s². The graph assumes steady speed."};
    }
    case "current-effects":{
      if(v.effect==="Heating effect"){
        const pulse=state.running?(Math.sin(t*5)+1)/2:.2,heat=Math.round((v.current/8)*pulse*110),radius=5+v.current*.18;
        return {formula:"Glow drawing scale = round[(I ÷ 8 A) × pulse × 110]\nFirst dot radius = 5 px + 0.18 px/A × I",substitution:`I = ${v.current} A; pulse = ${formulaNumber(pulse,3)}\ncolor index = round[(${v.current} ÷ 8) × ${formulaNumber(pulse,3)} × 110] = ${heat}\nradius = 5 + 0.18 × ${v.current} = ${formulaNumber(radius,2)} px`,result:`First glow dot: color index ${120+heat}; radius ${formulaNumber(radius,2)} px.`,meaning:"The current setting changes the drawing's glow. The pulse changes with animation time while Run is active.",example:"The glow is a visual hint: a larger current setting makes the model look brighter.",note:"These are canvas drawing values, not real temperature or power. Resistance is not a control, so no heating-energy formula is calculated."};
      }
      if(v.effect==="Circuit symbols")return {formula:"No numerical formula is calculated in the symbol view.",substitution:`This view labels a cell, bulb, switch, wire and fuse. Current setting = ${v.current} A; coil turns = ${v.turns} (not used by this view).`,result:"Circuit symbols only; no calculated physical result or units.",meaning:"The symbols are a compact way to draw circuit parts.",example:"A circuit diagram uses standard symbols instead of pictures of each component.",note:"The current and coil controls apply to the other demonstrations, not to this symbol key."};
      return {formula:"Qualitative relation: current in a coil → magnetic effect\nMore turns and current can make an electromagnet stronger.",substitution:`Coil setting = ${v.turns} turns; current setting = ${v.current} A.`,result:`The model shows an ${v.effect==="Electric bell"?"electric bell":"electromagnet"}; field strength is not numerically calculated.`,meaning:"The coil represents a current-carrying electromagnet; the bell animation shows the arm being attracted.",example:"A small electromagnet can attract paper clips when current passes through its coil.",note:"Current and turns are settings, not calibrated field measurements. No mains wiring or real heating is modeled."};
    }
    case "light":{
      if(v.element==="Prism")return {formula:"White light → a spread of seven visible colour bands\n(no wavelength or angle calculation)",substitution:"Element = prism; the diagram draws seven fixed colour rays.",result:"Seven illustrative colours; object distance and height do not affect this view.",meaning:"A prism can separate white light into a spectrum of colours.",example:"A rainbow shows colours from sunlight spread by water droplets.",note:"The prism sketch does not calculate wavelengths, refraction angles or brightness."};
      const focal=3,object=Number(v.object),height=Number(v.size);
      if(v.element==="Plane mirror")return {formula:"dᵢ = dₒ; hᵢ = hₒ\n(plane-mirror image)",substitution:`dₒ = ${object} units; hₒ = ${height} units\ntherefore dᵢ = ${object} units and hᵢ = ${height} units.`,result:`Virtual, upright image ${object} units behind the mirror; same height (${height} units).`,meaning:"The image appears behind the mirror at the same distance as the object is in front.",example:`Stand ${object} steps from a mirror and your reflection appears about ${object} steps behind it.`,note:"The ray sketch is idealized and the screen drawing is not to scale."};
      if(v.element==="Convex mirror"||v.element==="Concave lens"){
        const imageDistance=focal*object/(focal+object),imageHeight=height*imageDistance/object;
        const side=v.element==="Convex mirror"?"behind the mirror":"on the object's side";
        return {formula:"Virtual image magnitude: |dᵢ| = f dₒ ÷ (f + dₒ)\n|hᵢ| = hₒ × |dᵢ| ÷ dₒ",substitution:`f = ${focal} units; dₒ = ${object} units; hₒ = ${height} units\n|dᵢ| = ${focal} × ${object} ÷ (${focal} + ${object}) = ${formulaNumber(imageDistance)} units\n|hᵢ| = ${height} × ${formulaNumber(imageDistance)} ÷ ${object} = ${formulaNumber(imageHeight)} units.`,result:`Virtual, upright, smaller image ${formulaNumber(imageDistance)} units ${side}; height ≈ ${formulaNumber(imageHeight)} units.`,meaning:"These elements form a smaller virtual image for every object position in this simplified model.",example:"A convex security mirror shows a smaller upright view of a wide area.",note:`The model fixes focal length at ${focal} units. Its ray drawing is schematic, not to scale.`};
      }
      const denominator=Math.abs(object-focal),virtual=object<=focal,denominatorFloor=v.element==="Concave mirror"?.6:.65;
      const idealDistance=denominator===0?Infinity:focal*object/denominator;
      const imageDistance=Math.min(focal*object/Math.max(denominator,denominatorFloor),7);
      const imageHeight=v.element==="Concave mirror"?Math.min(height*2.2,height*focal/Math.max(denominator,.7)):Math.min(height*2,height*imageDistance/object);
      const formula=virtual?"Virtual case: |dᵢ| = f dₒ ÷ (f − dₒ)":"Real-image case: dᵢ = f dₒ ÷ (dₒ − f)";
      const idealText=Number.isFinite(idealDistance)?`${formulaNumber(idealDistance)} units`:"infinite at the focal point";
      return {formula:`Thin-mirror/lens relation (ideal): ${formula}\nImage height uses magnification; display is bounded.`,substitution:`f = ${focal} units; dₒ = ${object} units; hₒ = ${height} units\nideal image distance = ${idealText}\ndrawing distance = min(${focal} × ${object} ÷ max(|${object} − ${focal}|, ${denominatorFloor}), 7) = ${formulaNumber(imageDistance)} units\nimage height shown ≈ ${formulaNumber(imageHeight)} units.`,result:`${virtual?"Virtual, upright":"Real, inverted"} image; ideal distance ${idealText}; diagram places it ${formulaNumber(imageDistance)} units away.`,meaning:"The object’s distance relative to the focal length changes whether the image is real or virtual and how large it appears.",example:`With f = ${focal} units and an object ${object} units away, the ideal image distance is ${idealText}.`,note:"The drawing clamps image distance to 7 units and image height to keep extreme images visible. Focal length is fixed at 3 units."};
    }
    case "electric-effects":{
      const conducts=["Salt solution","Lemon solution"].includes(v.liquid),current=v.closed&&conducts,coating=v.demo==="Electroplating"&&current;
      return {formula:"Current path complete = switch closed AND liquid conducts\nCoating shown = electroplating selected AND path complete",substitution:`Switch = ${v.closed?"closed":"open"}; liquid = ${v.liquid} (${conducts?"conducting":"poor conductor"}); effect = ${v.demo}.`,result:`${current?"Path conducts":"No complete conducting path"} · coating ${coating?"shown depositing":"not depositing"}.`,meaning:"The diagram treats salt and lemon solutions as conducting; only electroplating mode shows a coating when the switch is closed.",example:"In a real electroplating setup, current can help deposit a thin metal layer on an object.",note:"This model calculates no voltage, current, chemical amount or coating thickness. It is not a real experiment."};
    }
    case "forces":{
      const contact=["Muscular push","Friction"].includes(v.force);
      const push=v.force==="Muscular push";
      return {formula:push?"Illustrative arrow offset = 45 px + (5 px/N × force setting)":"Model rule: muscular push and friction are contact forces; magnetic, electrostatic and gravitational forces are non-contact.",substitution:`Force type = ${v.force}; setting = ${v.strength} N; surface = ${v.surface.toLowerCase()}.${push?`\narrow offset = 45 + (5 × ${v.strength}) = ${45+v.strength*5} px`:""}`,result:`${v.strength} N illustrative setting · ${contact?"contact":"non-contact"} force${push?`; push-arrow offset ${45+v.strength*5} px`:""}.`,meaning:"The selection shows whether objects touch. Only the muscular-push view scales its arrow with the strength slider.",example:"A stronger push can make a cart speed up, while friction acts where the cart and floor touch.",note:"The arrow scale is a drawing aid. Mass and acceleration are not simulated, so F = ma is not calculated."};
    }
    case "pressure-weather":{
      if(v.demo==="Surface pressure"){
        const pressure=v.force/v.area;
        return {formula:"Pressure = force ÷ area  (P = F/A)",substitution:`P = ${v.force} N ÷ ${v.area} cm² = ${formulaNumber(pressure,1)} N/cm²`,result:`Surface pressure = ${formulaNumber(pressure,1)} N/cm².`,meaning:"For the same force, spreading it over a larger area lowers the pressure.",example:`A ${v.force} N load on ${v.area} cm² gives ${formulaNumber(pressure,1)} N/cm² in this model.`,note:"This uses the displayed area and reports N/cm²; atmospheric pressure is discussed but not calculated."};
      }
      if(v.demo==="Fluid pressure"){
        const reach=18+v.depth*4;
        return {formula:"Fluid pressure increases with depth (qualitative).\nIllustration arrow reach = 18 px + 4 px/m × depth setting.",substitution:`Depth setting = ${v.depth} m\narrow reach = 18 + 4 × ${v.depth} = ${reach} px`,result:`Deeper points show longer arrows; current model arrow reach = ${reach} px.`,meaning:"Fluid pressure generally grows with depth, but these arrows show the trend rather than a pressure value.",example:"A swimmer feels more water pressure deeper below the surface.",note:"Fluid density and gravity are not controls, so hydrostatic pressure is not calculated. Force and area settings do not affect this view."};
      }
      if(v.demo==="Cyclone"){
        const angle=t*.12;
        return {formula:"Cyclone drawing rotation = 0.12 rad/s × animation time",substitution:`rotation = 0.12 × ${formulaNumber(t)} s = ${formulaNumber(angle)} rad`,result:`Illustrative rotation angle: ${formulaNumber(angle)} rad · centre marked LOW PRESSURE.`,meaning:"The ellipses rotate around the low-pressure centre to suggest a cyclone.",example:"Cyclone winds rotate around a lower-pressure centre; real storms are much more complex.",note:"This is animation timing, not a wind-speed or weather equation. The model is not a forecast."};
      }
      return {formula:"Uneven heating → air moves → wind (qualitative model)",substitution:`Selected view = ${v.demo}; this diagram does not calculate temperature or air speed.`,result:"Moving arrows show a conceptual air-current pattern; no physical units are calculated.",meaning:"Air can move when heating is uneven, helping create wind.",example:"Sunlight warms land and water differently, which can create local breezes.",note:"The force, area and depth sliders are not used in the wind-current drawing."};
    }
    case "sound":{
      const frequency=v.frequency,period=1/frequency,amplitude=v.amplitude*3.1;
      const range=frequency<20?"infrasound":frequency>20000?"ultrasound":"audible range";
      return {formula:"Period = 1 ÷ frequency  (T = 1/f)\nDisplayed wave amplitude = 3.1 px × amplitude setting",substitution:`T = 1 ÷ ${frequency} Hz = ${formulaNumber(period,6)} s\nvisual amplitude = 3.1 × ${v.amplitude} = ${formulaNumber(amplitude,1)} px\nMedium = ${v.medium}; sound type = ${v.soundtype}.`,result:`Period ${formulaNumber(period*1000,3)} ms · wave height ${formulaNumber(amplitude,1)} px · ${v.medium==="No medium"?"no sound travels without a medium":range}.`,meaning:"Higher frequency means higher pitch; a larger amplitude makes a taller drawn wave and represents louder sound.",example:`At ${frequency} Hz, one cycle takes about ${formulaNumber(period*1000,2)} ms. A familiar musical A is near 440 Hz.`,note:"The derived period matches the frequency setting, but the drawn wave is not timed to that real frequency. Wave height is a canvas scale, not measured sound level; the simulation makes no sound."};
    }
    case "reflection-eye":{
      const idealCount=Math.max(1,Math.ceil(360/v.mirrorAngle)-1),shownCount=Math.min(idealCount,10);
      return {formula:"Approximate images between two mirrors:\nN ≈ max(1, ceil(360° ÷ angle) − 1)",substitution:`N ≈ max(1, ceil(360° ÷ ${v.mirrorAngle}°) − 1) = ${idealCount}\nRays selected = ${v.rays}; surface = ${v.surface}.`,result:`About ${idealCount} images by the model rule; ${shownCount} image marks are drawn.`,meaning:"A smaller angle lets light reflect back and forth more times, so more images can appear.",example:`At ${v.mirrorAngle}°, the idealized rule gives about ${idealCount} images.`,note:"Image count is an ideal geometry estimate and the drawing caps visible marks at 10. The eye diagram is a separate, simplified illustration."};
    }
    case "natural-phenomena":{
      if(v.demo==="Earthquake waves"){
        const radius=(t*38)%130;
        return {formula:"First wave-ring radius in the drawing = (38 px/s × elapsed time) mod 130 px",substitution:`elapsed = ${formulaNumber(t)} s\nradius = (38 × ${formulaNumber(t)}) mod 130 = ${formulaNumber(radius,1)} px`,result:`Illustrated wave-ring radius: ${formulaNumber(radius,1)} px from the underground focus.`,meaning:"The rings spread outward from the focus; the point above it at the surface is the epicentre.",example:"Ripples spreading from a point in a tray help picture waves spreading from an earthquake focus.",note:"Pixels per second is only animation speed, not real seismic-wave speed. The model is not a warning or forecast."};
      }
      if(v.demo==="Charging by rubbing")return {formula:"Illustrated charge-symbol count = charge setting",substitution:`charge setting = ${v.charge} illustrative units → ${v.charge} symbols around the rubbed object.`,result:`${v.charge} charge symbols; no charge in coulombs or force is calculated.`,meaning:"Rubbing can transfer electrons and leave materials charged; the symbols represent charge, not individual electrons.",example:"A rubbed balloon can attract small bits of paper.",note:"Charge symbols are a simple picture. The slider is not a measurement of real electric charge."};
      if(v.demo==="Charge interaction")return {formula:"Unlike charges attract · like charges repel (qualitative rule)",substitution:`Charge pair = ${v.relation}; symbol amount setting = ${v.charge} illustrative units.`,result:`The model shows the pair ${v.relation.startsWith("Unlike")?"attracting":"repelling"}.`,meaning:"The signs of the charges determine whether they pull together or push apart.",example:"A charged balloon can attract an oppositely charged surface.",note:"No electric force or charge value is calculated; lightning and earthquake views use different parts of the model."};
      return {formula:v.demo==="Lightning"?"Lightning formation is shown as a conceptual charge separation and discharge.":"Charge transfer is represented by symbols moving around a rubbed object.",substitution:`Explore view = ${v.demo}; animation time = ${formulaNumber(t)} s.`,result:v.demo==="Lightning"?"A lightning path flashes in the drawing; no voltage or energy is calculated.":"Charge symbols illustrate rubbing; no force is calculated.",meaning:v.demo==="Lightning"?"A lightning bolt is a large electric discharge between charged regions.":"Rubbing can transfer charge between some materials.",example:"During a storm, go indoors and stay away from water and open areas.",note:"The lightning model is not a forecast and does not calculate electric fields, voltage or discharge energy."};
    }
    default:return {formula:"No formula is available for this simulation.",substitution:"",result:"",meaning:"",example:"",note:""};
  }
}
function updateFormulaPanel(){
  const panel=$("formula-panel");
  if(!panel)return;
  if(state.subject==="biology")return;
  if(state.subject==="chemistry"){updateChemistryLiveText();return;}
  const m=current(),details=formulaDetails(m);
  details.settings=currentControlSummary(m).replace("Current settings: ","");
  panel.querySelectorAll("[data-formula-field]").forEach(field=>{field.textContent=details[field.dataset.formulaField]||"";});
}
function chemValues(id=state.module){return chemistryState.values[id];}
function chemistryDescription(m,v){
  const id=m.id;
  if(id==="chem-materials"){
    const f=chemMaterialFacts[v.material],property=v.property.toLowerCase(),value=f[property]||f.appearance;
    return `${v.material} is ${f.origin.toLowerCase()}. The ${v.property.toLowerCase()} test shows ${value.toLowerCase()}. In the water picture, ${f.solubility.toLowerCase()}. These observations help us choose materials for different jobs. The virtual test is simplified and is not a laboratory measurement.`;
  }
  if(id==="chem-temperature")return `The thermometer scale shows ${v.temperature} °C, which is ${((9/5)*v.temperature+32).toFixed(1)} °F. Changing the sample temperature moves the indicator and changes both readings. A thermometer measures temperature, not heat. Ice begins melting near 0 °C and a warm room is often around 20–25 °C, but conditions matter.`;
  if(id==="chem-water-states"){
    if(v.mode==="Water cycle")return `The droplets represent water. The moving arrow shows evaporation from a surface, cooling and condensation into clouds, precipitation, then collection. Changing temperature changes the sample-state label, while the cycle is a simplified overview of water moving through the environment.`;
    const phase=v.temperature<=0?"solid ice":v.temperature<100?"liquid water":"water vapour";
    return `The blue dots represent water particles. At ${v.temperature} °C the model shows mainly ${phase}. Heating can model melting and evaporation; cooling can model condensation and freezing. The particles do not change into a new substance. State-change temperatures are approximate and depend on pressure and other conditions.`;
  }
  if(id==="chem-separation")return v.method==="Handpicking"?`The visible pieces represent ${v.mixture.toLowerCase()}. Handpicking removes the larger, easy-to-see unwanted pieces one at a time. This works when mixture parts are different enough to sort by sight. The slider changes how many pieces are shown; the drawing simplifies real mixtures.`:v.method==="Winnowing"?`The particles represent ${v.mixture.toLowerCase()}. Moving air carries lighter chaff farther while heavier grain falls nearby. The airflow control changes the strength of the illustrated breeze. Winnowing uses differences in weight and air movement; this is a simplified model.`:`The funnel holds a filter. The liquid passes through while insoluble solid particles remain on the filter. The chosen mixture and filter change the labels in the diagram. Filtration is useful for mixtures such as sand and water; the picture is simplified.`;
  if(id==="chem-nature"){
    if(v.explore==="Air composition")return `The circles show approximate dry-air composition: nitrogen 78.08%, oxygen 20.95%, argon 0.93%, and other gases 0.04% (about 100% total). The chart is simplified; water vapour varies. Select another topic to inspect water, soil, a rock or mineral, or an energy source.`;
    if(v.explore==="Soil layers")return "The bands represent simplified soil layers: organic-rich topsoil, subsoil and weathered parent material above bedrock. Real soil layers vary by place and are not perfectly even.";
    if(v.explore.indexOf("Renewable:")===0)return `${v.explore.replace("Renewable: ","")} is shown as a renewable energy source because it is naturally replenished. The moving symbol represents the source, not a measured amount of energy.`;
    if(v.explore.indexOf("Non-renewable:")===0)return `${v.explore.replace("Non-renewable: ","")} is a non-renewable resource in this model. Fossil fuels form over very long times, so supplies do not quickly replenish.`;
    return `${v.explore} is a natural resource. Water supports life and moves through the environment; rocks are made of minerals, while a mineral has a characteristic composition and properties. These drawings show examples, not every natural variation.`;
  }
  if(id==="chem-indicators"){const f=chemIndicatorFacts[v.substance],color=v.indicator==="Litmus"?f.litmusColor:f.universalColor;return `${v.substance} is classified as ${f.classification.toLowerCase()} in this virtual example. The ${v.indicator} result is ${color}. An indicator changes color to help classify a sample; it does not identify every substance or give an exact pH here. Never taste or touch samples.`;}
  if(id==="chem-metals"){const f=chemMetalFacts[v.sample],alloy=v.alloy==="None"?"No alloy selected.":chemAlloyFacts[v.alloy];return `${v.sample} is a ${f.group.toLowerCase()}. In this ${v.test.toLowerCase()} test it is ${f[v.test==="Electrical conductivity"?"conductivity":v.test.toLowerCase()]||f.lustre}. Its properties help explain uses such as ${f.use.toLowerCase()}. ${alloy} Examples show common patterns, but materials can have exceptions.`;}
  if(id==="chem-changes"){
    if(v.change==="Rusting iron")return `The iron sample has air/oxygen ${v.air?"available":"limited"} and water ${v.water?"present":"absent"}. The rust-color layer grows with the model's progress setting when both are available. Rust is a new substance, so rusting is a chemical change. This progress is illustrative, not a real reaction rate.`;
    if(v.change==="Combustion")return `The fuel symbol reacts with oxygen in the air and releases energy, shown as light and warmth. Combustion forms new substances, so it is a chemical change. This is a safe diagram only; it gives no instructions for starting a fire.`;
    return `${v.change} changes the shape or state, but the model shows the same substance before and after. No new substance forms, so this is a physical change. The progress control changes how much of the simple illustration is shown.`;
  }
  if(id==="chem-particles")return v.mode==="Diffusion"?`Each dot represents a tiny particle, not drawn to scale. The dots begin crowded in one region and spread into less crowded space. A higher movement setting makes the animation faster. This models diffusion, the spreading of particles from high to low concentration; real particle paths are more complex.`:`Each dot represents a particle. In a solid, particles are close and vibrate; in a liquid, they stay close but move past each other; in a gas, they are farther apart and move freely. Temperature setting changes the model's motion speed. Particle sizes and distances are not to scale.`;
  if(id==="chem-mixtures")return v.kind==="Element"?"Each same-colored circle is one atom of the same element. The diagram shows one kind of atom, not atoms at their real size.":v.kind==="Compound"?"Each joined pair represents different atoms chemically bonded in a fixed group. The example is water, H₂O: two hydrogen atoms joined to one oxygen atom. The diagram is not to scale.":v.kind==="Uniform mixture"?"Different particle types are spread evenly through the sample, like salt dissolved in water. They are together but not all chemically joined. The diagram is simplified and has no fixed chemical formula.":"Different particle types are grouped unevenly, like sand and water. The substances are together but remain distinct; mixtures do not have one fixed formula. Particle sizes are not to scale.";
  if(id==="chem-solutions"){const cap=chemSolutionCapacity(v.solute,v.temperature),compatible=v.solvent==="Water"&&(v.solute==="Salt"||v.solute==="Sugar"),dissolved=compatible?Math.min(v.amount,cap):0;return `${v.solute} is the solute and ${v.solvent.toLowerCase()} is the solvent. ${compatible?`${dissolved} of ${v.amount} model spoon-units are shown dissolved${v.amount>cap?"; extra solid remains because the model is saturated":""}.`:`This pair does not form a solution in this model; the solute remains visible.`} Stirring ${v.stir?"is on":"is off"} and the temperature is ${v.temperature.toLowerCase()}; these can change dissolving speed or the model limit for some solids. Spoon-units and capacity are illustrative, not measured solubility data.`;
  }
  return "This diagram is a simplified model of the selected chemistry idea.";
}
function chemistryNotice(m,v){
  if(m.id==="chem-temperature")return `Notice the reading: ${v.temperature} °C = ${((9/5)*v.temperature+32).toFixed(1)} °F. What do you predict the Fahrenheit reading will be after the next temperature change?`;
  if(m.id==="chem-water-states")return `Notice the ${v.mode==="Water cycle"?"water moving through the cycle":"modeled state at "+v.temperature+" °C"}. What do you predict will happen if the sample is ${v.mode==="Cooling"?"warmed":"cooled"} next?`;
  if(m.id==="chem-indicators"){const f=chemIndicatorFacts[v.substance];return `Notice ${v.substance} is ${f.classification.toLowerCase()} and the indicator shows ${v.indicator==="Litmus"?f.litmusColor:f.universalColor}. What do you predict for another sample?`;}
  if(m.id==="chem-separation")return `Notice how ${v.method.toLowerCase()} separates ${v.mixture.toLowerCase()}. What do you predict will happen if you change the method?`;
  if(m.id==="chem-solutions")return `Notice whether undissolved ${v.solute.toLowerCase()} remains. What do you predict if you add one more model spoon-unit?`;
  if(m.id==="chem-changes")return `Notice whether the model forms a new substance. What do you predict if air or water exposure changes?`;
  if(m.id==="chem-metals")return `Notice the selected ${v.test.toLowerCase()} and material use. What do you predict for another material?`;
  if(m.id==="chem-particles")return `Notice particle spacing and movement in ${v.mode==="Diffusion"?"diffusion":v.state.toLowerCase()+" state"}. What do you predict if the movement setting changes?`;
  if(m.id==="chem-mixtures")return `Notice whether particles are joined and how evenly they are spread. What do you predict in another particle model?`;
  if(m.id==="chem-materials")return `Notice ${v.material}'s ${v.property.toLowerCase()} result. What do you predict for a different material?`;
  return `Notice the selected ${v.explore.toLowerCase()} model. What do you predict if you inspect another example?`;
}
function chemistryDetails(m,v){
  if(m.id==="chem-temperature"){const f=(9/5)*Number(v.temperature)+32;return {formula:"°F = (9/5 × °C) + 32",substitution:`°F = (9/5 × ${v.temperature} °C) + 32 = ${f.toFixed(1)} °F`,result:`${v.temperature} °C = ${f.toFixed(1)} °F`,meaning:`The thermometer scale reads ${v.scale==="Celsius"?`${v.temperature} °C`:`${f.toFixed(1)} °F`}. A thermometer measures temperature, not heat.`,example:"Ice melts near 0 °C (32 °F); a comfortable room is often about 20–25 °C (68–77 °F).",note:"Conversion is exact for these scales; reference temperatures depend on conditions."};}
  if(m.id==="chem-water-states"){const state=v.mode==="Water cycle"?"Water-cycle stages":(v.temperature<=0?"Modeled state: ice (solid)":v.temperature<100?"Modeled state: liquid water":"Modeled state: water vapour");return {formula:"No calculation: show the selected temperature and modeled state.",substitution:`Mode: ${v.mode}; selected temperature: ${v.temperature} °C.`,result:`${state}`,meaning:"Heating or cooling can change water's state; the water remains H₂O.",example:"Ice in a drink melts; water vapour can cool into droplets on a window.",note:"The model uses approximate change points near ordinary pressure. Real state-change temperatures depend on pressure and conditions."};}
  if(m.id==="chem-nature"&&v.explore==="Air composition")return {formula:"Approximate dry-air composition (parts of about 100%)",substitution:"Nitrogen 78.08% + oxygen 20.95% + argon 0.93% + other gases 0.04%",result:"Total ≈ 100.00%",meaning:"Nitrogen is the largest part of dry air; oxygen is the next largest.",example:"A 100-part chart is like splitting a 100-piece collection into groups by gas.",note:"Approximate dry-air values; water vapour varies and is not included."};
  if(m.id==="chem-particles"&&v.mode==="Diffusion")return {formula:"Qualitative model: particles spread from crowded to less-crowded regions.",substitution:`Movement setting: ${v.temperature} relative model units; elapsed model time: ${state.elapsed.toFixed(1)} s.`,result:"Relative particle distribution changes over time (illustrative, not measured).",meaning:"Diffusion spreads particles from higher concentration toward lower concentration.",example:"A smell can spread through a room over time.",note:"Particles are not to scale; animation speed and movement setting are not physical measurements."};
  if(m.id==="chem-solutions"){const cap=chemSolutionCapacity(v.solute,v.temperature),compatible=v.solvent==="Water"&&(v.solute==="Salt"||v.solute==="Sugar"),dissolved=compatible?Math.min(v.amount,cap):0;return {formula:"Qualitative dissolving model; no measured concentration is calculated.",substitution:`Solute: ${v.solute}; solvent: ${v.solvent}; added: ${v.amount} illustrative spoon-units; stirring: ${v.stir?"on":"off"}; temperature: ${v.temperature}.`,result:compatible?`${dissolved} model units shown dissolved${v.amount>cap?`; ${v.amount-cap} remain undissolved`:""}.`:`No solution shown; ${v.solute} remains visible in ${v.solvent.toLowerCase()}.`,meaning:"Stirring and temperature may change how quickly some solids dissolve. Saturation is the model's limit under the selected conditions.",example:"Extra sugar can remain at the bottom after a drink can no longer dissolve more.",note:"Model spoon-units and capacity are illustrative, not real solubility values."};}
  return {formula:"No equation is needed for this observation or classification.",substitution:"Current selection: "+m.controls.map(c=>`${c.label}: ${v[c.key]}`).join("; "),result:"Qualitative model output; no unsupported measurement is calculated.",meaning:chemistryDescription(m,v),example:"Compare familiar materials and examples in everyday life.",note:"The diagram is simplified and does not provide laboratory-grade measurements."};
}
function chemistryMetrics(m,v){
  if(m.id==="chem-temperature")return [["Temperature",`${v.temperature} °C`],["Converted scale",`${((9/5)*v.temperature+32).toFixed(1)} °F`]];
  if(m.id==="chem-water-states")return [["Temperature",`${v.temperature} °C`],["Model state",v.mode==="Water cycle"?"Water cycle":v.temperature<=0?"Ice":v.temperature<100?"Liquid water":"Water vapour"]];
  if(m.id==="chem-nature"&&v.explore==="Air composition")return [["Nitrogen","78.08%"],["Oxygen","20.95%"],["Other gases","0.97%"],["Total","≈100%"]];
  if(m.id==="chem-indicators"){const f=chemIndicatorFacts[v.substance];return [["Sample",v.substance],["Classification",f.classification],["Indicator result",v.indicator==="Litmus"?f.litmusColor:f.universalColor]];}
  if(m.id==="chem-solutions"){const compatible=v.solvent==="Water"&&(v.solute==="Salt"||v.solute==="Sugar"),cap=chemSolutionCapacity(v.solute,v.temperature);return [["Solute / solvent",`${v.solute} / ${v.solvent}`],["Shown dissolved",compatible?`${Math.min(v.amount,cap)} model units`:"Not soluble in model"],["Saturation",compatible&&v.amount>cap?"Extra solid remains":compatible?"Below model limit":"No solution"]];}
  if(m.id==="chem-metals"){const f=chemMetalFacts[v.sample];return [["Group",f.group],["Property",f[v.test==="Electrical conductivity"?"conductivity":v.test.toLowerCase()]||f.lustre],["Everyday use",f.use],["Alloy",v.alloy]];}
  if(m.id==="chem-changes")return [["Example",v.change],["Air / oxygen",v.air?"Available":"Limited"],["Water",v.water?"Present":"Absent"],["Model progress",`${v.progress}%`]];
  if(m.id==="chem-particles")return [["Model",v.mode],["State",v.mode==="Diffusion"?"Diffusion":v.state],["Movement setting",`${v.temperature} relative units`]];
  if(m.id==="chem-materials"){const f=chemMaterialFacts[v.material];return [["Material type",f.origin.startsWith("Natural")?"Natural":"Man-made"],[v.property,f[v.property.toLowerCase()]||f.appearance],["Water test",f.solubility]];}
  return [["Selected model",m.controls.map(c=>String(v[c.key])).join(" · ")]];
}
function chemistryControlMarkup(m){
  return m.controls.map(c=>{const value=chemValues(m.id)[c.key];if(c.type==="select")return `<label class="control-item"><span class="control-line"><span class="control-label">${esc(c.label)}</span></span><select data-chem-key="${esc(c.key)}" aria-label="${esc(c.label)}">${c.options.map(o=>`<option${o===value?" selected":""}>${esc(o)}</option>`).join("")}</select></label>`;if(c.type==="toggle")return `<div class="control-item"><span class="control-line"><span class="control-label">${esc(c.label)}</span><span class="control-value">${value?esc(c.on):esc(c.off)}</span></span><label class="toggle-row"><input type="checkbox" data-chem-key="${esc(c.key)}" ${value?"checked":""} aria-label="${esc(c.label)}"><span>${value?esc(c.on):esc(c.off)}</span></label></div>`;return `<label class="control-item"><span class="control-line"><span class="control-label">${esc(c.label)}</span><span class="control-value" data-chem-value="${esc(c.key)}">${esc(value)} ${esc(c.unit||"")}</span></span><input type="range" min="${c.min}" max="${c.max}" step="${c.step}" value="${value}" data-chem-key="${esc(c.key)}" aria-label="${esc(c.label)}"><span class="range-minmax"><span>${c.min} ${esc(c.unit||"")}</span><span>${c.max} ${esc(c.unit||"")}</span></span></label>`;}).join("");
}
function chemistryExplanationMarkup(m){
  const v=chemValues(m.id),answer=chemistryState.answers[m.id];
  return `<div><h4 class="box-title">What is happening?</h4><div class="what-happening" id="chem-what">${esc(chemistryDescription(m,v))}</div><p class="what-values" id="chem-notice">${esc(chemistryNotice(m,v))}</p></div><div class="observation-check"><h5>Observe and explain</h5><p>${esc(m.check.question)}</p><div class="observation-options" role="group" aria-label="Choose your observation">${m.check.options.map((o,i)=>`<button class="observation-choice${answer===i?(i===m.check.answer?" is-correct":" is-incorrect"):""}" type="button" data-chem-answer="${i}" ${chemistryState.investigated.has(m.id)&&answer!==m.check.answer?"":"disabled"}>${esc(o)}</button>`).join("")}</div><p class="observation-feedback${answer===m.check.answer?" good":answer!==undefined?" bad":""}" id="chem-feedback" aria-live="polite">${answer===m.check.answer?"Correct. "+esc(m.check.why):answer!==undefined?"Try again. Hint: "+esc(m.check.hint):"Change a control or run the model before answering."}</p><p class="activity-completion"${chemistryState.completed.has(m.id)?"":" hidden"}>Nice work! Activity complete. Your progress is saved for this browser session.</p></div><p class="home-tip"><strong>Try this:</strong> ${esc(m.challenge.text)} <button class="secondary-button small-button" type="button" id="chem-challenge">Try the challenge</button></p>`;
}
function renderChemistryModule(){
  const m=chemistryModules.find(x=>x.id===state.module);if(!m)return;
  const grade=chemistryGradeInfo[m.grade],index=grade.ids.indexOf(m.id)+1,done=progress(m.grade),answer=chemistryState.answers[m.id],prediction=chemistryState.predictions[m.id];state.grade=m.grade;state.page="grade";
  gradeView.hidden=false;home.hidden=true;quizView.hidden=true;
  gradeView.innerHTML=`<header class="grade-header"><div><div class="grade-kicker">Explore Chemistry ${esc(grade.name)}</div><h2>${esc(grade.name)} Chemistry lab</h2><p>${esc(grade.description)}</p></div><div class="top-actions"><div class="grade-progress" aria-label="${done} of ${grade.ids.length} modules completed"><span>${done}/${grade.ids.length} complete</span><span class="progress-track"><span class="progress-fill" style="display:block;width:${done/grade.ids.length*100}%"></span></span></div><button class="primary-button small-button" type="button" data-quiz="${m.grade}">Class quiz · ${chemistryState.quizScores[m.grade]===null?"not taken":`${chemistryState.quizScores[m.grade]}/3`}</button></div></header>
  <div class="grade-layout"><nav class="topic-list" aria-label="${esc(grade.name)} Chemistry topics">${grade.ids.map((id,i)=>{const item=chemistryModules.find(x=>x.id===id);return `<button class="topic-link" type="button" data-chem-module="${id}" aria-current="${id===m.id}"><span class="topic-number">${String(i+1).padStart(2,"0")}</span><span class="topic-text">${esc(item.short)}</span></button>`;}).join("")}</nav>
  <article class="module-card"><header class="module-head"><div><div class="module-number">Module ${index} · Chemistry ${esc(grade.name)}</div><h3>${esc(m.title)}</h3><p class="module-intro">${esc(m.intro)}</p></div><span class="simulation-tag">VIRTUAL MODEL</span></header>
  <section class="prediction-box"><h4>1. Make a prediction</h4><p>${esc(m.prediction.question)}</p><div class="prediction-options" role="group" aria-label="Choose your prediction">${m.prediction.options.map((o,i)=>`<button class="prediction-choice" type="button" data-chem-prediction="${i}" aria-pressed="${prediction===i}" ${prediction!==undefined?"disabled":""}>${esc(o)}</button>`).join("")}</div>${prediction===undefined?`<button class="prediction-submit" type="button" id="chem-submit-prediction" ${chemistryState.predictionChoices[m.id]===undefined?"disabled":""}>Submit prediction</button>`:`<p class="prediction-saved" role="status">Prediction saved: “${esc(m.prediction.options[prediction])}” Now investigate and compare with what happens.</p>`}</section>
  <div class="simulation-content"${prediction===undefined?" hidden":""}><div class="canvas-shell" id="canvas-shell"><canvas id="lab-canvas" aria-label="${esc(m.title)} simplified interactive model"></canvas><div class="canvas-hint">SIMPLIFIED VIRTUAL MODEL · NOT TO SCALE</div></div><div class="sim-footer"><span id="run-status">${state.running?"Animation running":"Ready to explore"}</span><span class="sim-disclaimer">${esc(m.note)}</span></div><div class="module-lower"><section class="control-box"><h4 class="box-title">2. Investigate</h4><p class="module-intro">Change a setting and watch the model and labels update.</p><div class="control-grid">${chemistryControlMarkup(m)}</div><div class="measurements" id="measurements"></div><div class="control-actions"><button class="primary-button small-button" id="run-control">${state.running?"❚❚ Pause":"▶ Run"}</button><button class="secondary-button small-button" id="reset-control">↺ Reset</button><button class="secondary-button small-button" id="chem-try-again">Try another setting</button></div><p class="comparison-status" id="chem-prediction-compare">Your prediction: ${esc(m.prediction.options[prediction])}</p></section><aside class="observation-box">${chemistryExplanationMarkup(m)}</aside><section class="formula-panel" id="formula-panel"><h4>Live formula and worked example</h4><div class="formula-grid">${["formula","substitution","result","meaning","example","note"].map(k=>`<div class="formula-item ${k}"><span class="formula-label">${({formula:"Formula or model rule",substitution:"Current values",result:"Result",meaning:"What it means",example:"Familiar example",note:"Model limits"})[k]}</span><p class="formula-value" data-chem-formula="${k}"></p></div>`).join("")}</div></section></div></div></article></div>`;
  gradeView.querySelectorAll("[data-chem-module]").forEach(b=>b.addEventListener("click",()=>selectModule(b.dataset.chemModule)));
  gradeView.querySelector("[data-quiz]").addEventListener("click",()=>openQuiz(m.grade));
  gradeView.querySelectorAll("[data-chem-prediction]").forEach(b=>b.addEventListener("click",()=>{chemistryState.predictionChoices[m.id]=Number(b.dataset.chemPrediction);gradeView.querySelectorAll("[data-chem-prediction]").forEach(x=>x.setAttribute("aria-pressed",String(x===b)));$("chem-submit-prediction").disabled=false;}));
  const submit=$("chem-submit-prediction");if(submit)submit.addEventListener("click",()=>{chemistryState.predictions[m.id]=chemistryState.predictionChoices[m.id];renderModule();});
  gradeView.querySelectorAll("[data-chem-key]").forEach(control=>{const update=()=>{const c=m.controls.find(x=>x.key===control.dataset.chemKey);chemValues(m.id)[c.key]=control.type==="checkbox"?control.checked:control.type==="range"?Number(control.value):control.value;chemistryState.investigated.add(m.id);if(control.type==="range"){gradeView.querySelector(`[data-chem-value="${c.key}"]`).textContent=`${control.value} ${c.unit||""}`;control.style.setProperty("--pct",`${(Number(control.value)-Number(control.min))/(Number(control.max)-Number(control.min))*100}%`);}if(control.type==="checkbox"){control.parentElement.querySelector("span").textContent=control.checked?c.on:c.off;control.closest(".control-item").querySelector(".control-value").textContent=control.checked?c.on:c.off;}updateChemistryLiveText();updateMeasurements();draw();const buttons=gradeView.querySelectorAll("[data-chem-answer]");buttons.forEach(b=>b.disabled=false);};control.addEventListener("input",update);control.addEventListener("change",update);});
  gradeView.querySelectorAll("[data-chem-answer]").forEach(b=>b.addEventListener("click",()=>{const selected=Number(b.dataset.chemAnswer);chemistryState.answers[m.id]=selected;chemistryState.investigated.add(m.id);const correct=selected===m.check.answer;if(correct)chemistryState.completed.add(m.id);renderChemistryModule();}));
  $("chem-challenge").addEventListener("click",()=>{Object.keys(m.challenge.values).forEach(k=>chemValues(m.id)[k]=m.challenge.values[k]);chemistryState.investigated.add(m.id);renderChemistryModule();setupCanvas();updateMeasurements();updateChemistryLiveText();});
  $("run-control").addEventListener("click",toggleRun);$("reset-control").addEventListener("click",resetModule);
  $("chem-try-again").addEventListener("click",()=>{state.running=false;state.elapsed=0;chemistryState.answers[m.id]=undefined;chemistryState.investigated.delete(m.id);chemistryState.predictionChoices[m.id]=undefined;chemistryState.predictions[m.id]=undefined;chemistryState.values[m.id]=JSON.parse(JSON.stringify(chemistryDefaults[m.id]));renderChemistryModule();});
  setupCanvas();updateMeasurements();updateChemistryLiveText();updateProgressInHeader();renderNav();
}
function updateChemistryLiveText(){
  if(state.subject!=="chemistry")return;const m=chemistryModules.find(x=>x.id===state.module);if(!m)return;const d=chemistryDetails(m,chemValues(m.id)),desc=$("chem-what"),notice=$("chem-notice");
  if(desc)desc.textContent=chemistryDescription(m,chemValues(m.id));if(notice)notice.textContent=chemistryNotice(m,chemValues(m.id));
  document.querySelectorAll("[data-chem-formula]").forEach(el=>{el.textContent=d[el.dataset.chemFormula]||"";});
}
function biologyValues(id=state.module){return biologyState.values[id];}
function biologyExplanation(m,v){
  if(m.kind==="photosynthesis"){const rate=Math.min(v.light,v.water,v.carbon)*(v.leaf==="Green leaf with chlorophyll"?1:.45),limiting=rate===0?"one required input is unavailable":v.light<=v.water&&v.light<=v.carbon?"light":v.water<=v.carbon?"water":"carbon dioxide";return `The leaf model uses light, water and carbon dioxide to make glucose and release oxygen. Chlorophyll absorbs light energy; less chlorophyll in this model lowers the modeled output. Current modeled output: ${rate.toFixed(1)} units; ${limiting} is the limiting input. This is a conceptual model, not a measured rate or a diagram to scale.`;}
  if(m.kind==="cell")return `${v.cell} view: both plant and animal cells have a membrane, cytoplasm and nucleus. ${v.cell==="Plant cell"?"The plant model also shows a cell wall, a large vacuole and chloroplasts; not all plant cells contain chloroplasts.":"The animal model has no cell wall or chloroplasts."} ${v.label?"Labels are on.":"Labels are hidden in the drawing; use the diagram key above to identify structures."} Structures are enlarged and not to scale.`;
  if(m.kind==="movement")return `The ${v.joint.toLowerCase()} is where bones meet. Muscles pull on bones to bend or straighten a joint; they do not push bones from both ends. This simplified animation is not to scale.`;
  if(m.kind==="digestion")return `Food travels through the digestive tract in this order: mouth, food pipe, stomach, small intestine and large intestine. The selected view is ${v.food.toLowerCase()}; the small intestine absorbs most digested nutrients. Organs are not to scale.`;
  if(m.kind==="respiration")return `Breathing exchanges gases with the surroundings; cellular respiration happens inside cells and releases energy from food. The selected example is ${v.organism.toLowerCase()} (${v.activity.toLowerCase()}). Gas exchange structures differ among organisms.`;
  if(m.kind==="transport")return v.system==="Plant transport"?"Water and dissolved minerals enter roots and move toward leaves through xylem. Phloem carries sugars made in leaves to other parts. This simplified model does not show every transport process.":"The heart pumps blood through vessels around the body and back again. Blood carries materials such as oxygen and nutrients. This circulation drawing is a simplified loop, not to scale.";
  if(m.kind==="plant-reproduction")return `${v.stage} is highlighted. In flowering plants, pollen reaches a stigma during pollination; after fertilization, ovules develop into seeds and the ovary may form a fruit. Seeds can disperse by ${v.dispersal.toLowerCase()}. This is a simplified model.`;
  if(m.kind==="forest")return `${v.change} changes the forest web. Plants support herbivores; animals and plants are linked to predators and decomposers. Decomposers return nutrients to soil, while water and air support life. Arrows show selected relationships, not every interaction.`;
  if(m.kind==="adolescence")return `Puberty is a normal part of growing up. The topic is ${v.topic.toLowerCase()}; timing and pace vary from person to person. This is general learning information, not personal medical advice. A trusted adult or health professional can help with questions.`;
  if(m.kind==="microbes")return `${v.example} is shown as an illustration. Microorganisms have varied roles: some help make foods or decompose matter, while some cause disease. This model does not involve real samples; never culture or handle microorganisms.`;
  if(m.kind==="conservation")return `${v.change} can affect ${v.species.toLowerCase()}. Habitats provide food, water and shelter; habitat loss can reduce biodiversity and disrupt food webs. Protecting and restoring habitats can help, though recovery takes time.`;
  if(m.kind==="animal-reproduction")return `The ${v.animal.toLowerCase()} example shows the ${v.stage.toLowerCase()} stage. Animals grow and develop through life cycles, which differ among species. This simplified, respectful model focuses on general life-science ideas.`;
  const selected=m.controls.map(c=>`${c.label.toLowerCase()}: ${v[c.key]}`).join("; ");
  return `${m.learn} In this model, ${selected}. The diagram shows selected examples; organisms and structures vary.`;
}
function renderBiologyHome(){
  home.hidden=false;gradeView.hidden=true;quizView.hidden=true;
  home.innerHTML=`<div class="home-grid">${Object.entries(biologyGradeInfo).map(([g,info])=>{const done=progress(Number(g)),quizDone=info.ids.filter(id=>biologyState.quizScores[id]!==null).length;return `<article class="grade-card" tabindex="0" role="button" data-open-grade="${g}" aria-label="Open Biology ${info.name}"><div class="grade-card-head"><span class="grade-badge">${esc(info.name.replace("Class ","C"))}</span><span class="module-count">${info.ids.length} topics</span></div><h2>${esc(info.name)} Biology lab</h2><p>${esc(info.description)}</p><div class="card-bottom"><span>${done}/${info.ids.length} activities · ${quizDone}/${info.ids.length} quizzes</span><span class="progress-track"><span class="progress-fill" style="display:block;width:${done/info.ids.length*100}%"></span></span></div></article>`;}).join("")}</div><div class="home-tip"><strong>How to use Biology Virtual Lab:</strong> Choose your class and topic. Predict first, submit, investigate with the controls, observe and explain, then try again or take that topic’s 10-question quiz. Models are simplified and for learning only; never handle organisms, samples, chemicals or equipment. Progress and scores stay separate by topic in this browser session.</div>`;
  home.querySelectorAll("[data-open-grade]").forEach(card=>{card.addEventListener("click",()=>openGrade(Number(card.dataset.openGrade)));card.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();openGrade(Number(card.dataset.openGrade));}});});
}
function biologySortMarkup(m){
  if(m.kind!=="diversity"&&m.kind!=="classification")return "";
  const values=biologyValues(m.id),selected=m.kind==="diversity"?values.feature:values.rule,habitat=values.habitat;
  const organisms=[
    {name:"Bird",habitat:"Air and land",traits:{"Body covering":"Feathers","Number of legs":"2","Where it lives":"Air and land","How it moves":"Flies and walks","Has a backbone":"Yes","Makes its own food":"No","Lives mostly in water":"No"}},
    {name:"Fish",habitat:"Water",traits:{"Body covering":"Scales","Number of legs":"0","Where it lives":"Water","How it moves":"Swims","Has a backbone":"Yes","Makes its own food":"No","Lives mostly in water":"Yes"}},
    {name:"Frog",habitat:"Land and water",traits:{"Body covering":"Smooth, moist skin","Number of legs":"4","Where it lives":"Land and water","How it moves":"Hops and swims","Has a backbone":"Yes","Makes its own food":"No","Lives mostly in water":"Sometimes"}},
    {name:"Butterfly",habitat:"Air and land",traits:{"Body covering":"Exoskeleton","Number of legs":"6","Where it lives":"Air and land","How it moves":"Flies","Has a backbone":"No","Makes its own food":"No","Lives mostly in water":"No"}},
    {name:"Oak tree",habitat:"Land",traits:{"Body covering":"Bark and leaves","Number of legs":"0","Where it lives":"Land","How it moves":"Grows in place","Has a backbone":"No","Makes its own food":"Yes","Lives mostly in water":"No"}},
    {name:"Mushroom",habitat:"Land",traits:{"Body covering":"No feathers or fur","Number of legs":"0","Where it lives":"Land","How it moves":"Grows in place","Has a backbone":"No","Makes its own food":"No","Lives mostly in water":"No"}}
  ];
  const matching=organisms.filter(o=>m.kind!=="diversity"||habitat==="All habitats"||o.habitat===habitat);
  const groups=new Map();
  matching.forEach(o=>{const group=o.traits[selected]||"Other";if(!groups.has(group))groups.set(group,[]);groups.get(group).push(o.name);});
  return `<section class="sort-activity" aria-live="polite"><h5>${m.kind==="diversity"?"Explore the sort":"Group by a shared characteristic"}</h5><p>${m.kind==="diversity"?"Change the feature or habitat to regroup these examples. Traits are observable examples, not rules for every organism.":"Choose a characteristic and compare which organisms share it. These are simplified examples."}</p><div class="sort-groups">${Array.from(groups,([group,names])=>`<div class="sort-group"><strong>${esc(selected)}: ${esc(group)}</strong>${names.map(name=>`<span class="sort-organism">${esc(name)}</span>`).join("")}</div>`).join("")}</div></section>`;
}
function biologyControlMarkup(m){
  return m.controls.map(c=>{const value=biologyValues(m.id)[c.key],options=c.key==="zoom"&&biologyValues(m.id).cell==="Animal cell"?c.options.filter(o=>o!=="Chloroplast"):c.options;if(c.type==="select")return `<label class="control-item"><span class="control-line"><span class="control-label">${esc(c.label)}</span></span><select data-bio-key="${esc(c.key)}" aria-label="${esc(c.label)}">${options.map(o=>`<option${o===value?" selected":""}>${esc(o)}</option>`).join("")}</select></label>`;if(c.type==="toggle")return `<div class="control-item"><span class="control-line"><span class="control-label">${esc(c.label)}</span><span class="control-value">${value?esc(c.on):esc(c.off)}</span></span><label class="toggle-row"><input type="checkbox" data-bio-key="${esc(c.key)}" ${value?"checked":""} aria-label="${esc(c.label)}"><span>${value?esc(c.on):esc(c.off)}</span></label></div>`;return `<label class="control-item"><span class="control-line"><span class="control-label">${esc(c.label)}</span><span class="control-value" data-bio-value="${esc(c.key)}">${esc(value)} ${esc(c.unit||"")}</span></span><input type="range" min="${c.min}" max="${c.max}" step="${c.step}" value="${value}" data-bio-key="${esc(c.key)}" aria-label="${esc(c.label)}"><span class="range-minmax"><span>${c.min} ${esc(c.unit||"")}</span><span>${c.max} ${esc(c.unit||"")}</span></span></label>`;}).join("");
}
function updateBiologyLiveText(){
  if(state.subject!=="biology")return;const m=biologyModules.find(x=>x.id===state.module);if(!m)return;
  const desc=$("bio-what"),notice=$("bio-notice");if(desc)desc.textContent=biologyExplanation(m,biologyValues(m.id));
  if(notice)notice.textContent=`Selected: ${m.controls.map(c=>`${c.label}: ${biologyValues(m.id)[c.key]}`).join(" · ")}. Observe the labels and arrows; this is a simplified model, not to scale.`;
  const canvas=$("lab-canvas");if(canvas)canvas.setAttribute("aria-label",`${m.title}. ${m.diagram.join(". ")}. ${biologyExplanation(m,biologyValues(m.id))}`);
}
function renderBiologyModule(){
  const m=biologyModules.find(x=>x.id===state.module);if(!m)return;
  const grade=biologyGradeInfo[m.grade],index=grade.ids.indexOf(m.id)+1,prediction=biologyState.predictions[m.id],predictionChoice=biologyState.predictionChoices[m.id],answer=biologyState.answers[m.id],investigated=biologyState.investigated.has(m.id);
  state.grade=m.grade;state.page="grade";home.hidden=true;gradeView.hidden=false;quizView.hidden=true;
  const done=progress(m.grade);
  gradeView.innerHTML=`<header class="grade-header"><div><div class="grade-kicker">Explore Biology · ${esc(grade.name)}</div><h2>${esc(grade.name)} Biology lab</h2><p>${esc(grade.description)}</p></div><div class="top-actions"><div class="grade-progress" aria-label="${done} of ${grade.ids.length} activities completed"><span>${done}/${grade.ids.length} complete</span><span class="progress-track"><span class="progress-fill" style="display:block;width:${done/grade.ids.length*100}%"></span></span></div></div></header>
  <div class="grade-layout"><nav class="topic-list" aria-label="${esc(grade.name)} Biology topics">${grade.ids.map((id,i)=>{const item=biologyModules.find(x=>x.id===id);return `<button class="topic-link" type="button" data-bio-module="${id}" aria-current="${id===m.id}"><span class="topic-number">${String(i+1).padStart(2,"0")}</span><span class="topic-text">${esc(item.short)}${biologyState.completed.has(id)?" · ✓":""}</span></button>`;}).join("")}</nav>
  <article class="module-card"><header class="module-head"><div><div class="module-number">Topic ${index} · Biology ${esc(grade.name)}</div><h3>${esc(m.title)}</h3><p class="module-intro">${esc(m.intro)}</p></div><span class="simulation-tag">SAFE VIRTUAL MODEL</span></header>
  <section class="prediction-box"><h4>1. Make a prediction</h4><p>${esc(m.predict)}</p><div class="prediction-options" role="group" aria-label="Choose your prediction">${m.predictOptions.map((o,i)=>`<button class="prediction-choice" type="button" data-bio-prediction="${i}" aria-pressed="${predictionChoice===i}" ${prediction!==undefined?"disabled":""}>${esc(o)}</button>`).join("")}</div>${prediction===undefined?`<button class="prediction-submit" type="button" id="bio-submit-prediction" ${predictionChoice===undefined?"disabled":""}>Submit prediction</button>`:`<p class="prediction-saved" role="status">Prediction saved: “${esc(m.predictOptions[prediction])}” Now explore the model and compare what you observe.</p>`}</section>
  <div class="simulation-content"${prediction===undefined?" hidden":""}><div class="canvas-shell" id="canvas-shell"><canvas id="lab-canvas" role="img" aria-label="${esc(m.title)} simplified labelled model"></canvas><div class="canvas-hint">SIMPLIFIED VIRTUAL MODEL · NOT TO SCALE</div></div><p class="biology-diagram-caption" id="bio-diagram-caption"><strong>Diagram labels:</strong> ${m.diagram.map(esc).join(" · ")}</p><div class="sim-footer"><span id="run-status">${state.running?"Animation running":"Ready to explore"}</span><span class="sim-disclaimer">${esc(m.note)}</span></div><div class="module-lower"><section class="control-box"><h4 class="box-title">2. Investigate</h4><p class="module-intro">Change a setting or run the model. Follow the labels, arrows and movement.</p><div class="control-grid">${biologyControlMarkup(m)}</div><div id="bio-sort-container">${biologySortMarkup(m)}</div><div class="measurements" id="measurements" aria-live="polite"></div><div class="control-actions"><button class="primary-button small-button" id="run-control" type="button">${state.running?"❚❚ Pause":"▶ Run"}</button><button class="secondary-button small-button" id="reset-control" type="button">↺ Reset</button><button class="secondary-button small-button" id="bio-try-again" type="button">Try again</button><button class="primary-button small-button" id="bio-topic-quiz" type="button">Topic quiz · ${biologyState.quizScores[m.id]===null?"not taken":`${biologyState.quizScores[m.id]}/${m.quiz.length}`}</button></div><p class="comparison-status" id="bio-investigation-prompt" aria-live="polite">${investigated?"Your investigation is ready. Choose an observation and explain it.":"Change a control or press Run before answering."}</p></section>
  <aside class="observation-box" aria-label="Explanation and observation"><div><h4 class="box-title">What is happening?</h4><div class="what-happening" id="bio-what" aria-live="polite">${esc(biologyExplanation(m,biologyValues(m.id)))}</div><p class="what-values" id="bio-notice">${esc(`Selected: ${m.controls.map(c=>`${c.label}: ${biologyValues(m.id)[c.key]}`).join(" · ")}. Observe the labels and arrows; this is a simplified model, not to scale.`)}</p></div><div class="observation-check"><h5>3. Observe and explain</h5><p>${esc(m.observe)}</p><div class="observation-options" role="group" aria-label="Choose what you observed">${m.choices.map((o,i)=>`<button class="observation-choice${answer===i?(i===m.answer?" is-correct":" is-incorrect"):""}" type="button" data-bio-answer="${i}" aria-pressed="${answer===i}" ${!investigated||answer===m.answer?"disabled":""}>${esc(o)}</button>`).join("")}</div><p class="observation-feedback${answer===m.answer?" good":answer!==undefined?" bad":""}" id="bio-feedback" aria-live="polite">${answer===m.answer?"Correct. "+esc(m.learn):answer!==undefined?"Try again. Hint: "+esc(m.hint):"Explore the model, then choose an observation."}</p><p class="activity-completion"${biologyState.completed.has(m.id)?"":" hidden"}>Nice work! This topic activity is complete.</p></div><details><summary>Learn more</summary><p>${esc(m.learn)}</p></details></aside></div></div></article></div>`;
  gradeView.querySelectorAll("[data-bio-module]").forEach(b=>b.addEventListener("click",()=>selectModule(b.dataset.bioModule)));
  gradeView.querySelectorAll("[data-bio-prediction]").forEach(b=>b.addEventListener("click",()=>{biologyState.predictionChoices[m.id]=Number(b.dataset.bioPrediction);gradeView.querySelectorAll("[data-bio-prediction]").forEach(x=>x.setAttribute("aria-pressed",String(x===b)));$("bio-submit-prediction").disabled=false;}));
  const submit=$("bio-submit-prediction");if(submit)submit.addEventListener("click",()=>{biologyState.predictions[m.id]=biologyState.predictionChoices[m.id];renderModule();});
  gradeView.querySelectorAll("[data-bio-key]").forEach(control=>{const update=()=>{const c=m.controls.find(x=>x.key===control.dataset.bioKey);biologyValues(m.id)[c.key]=control.type==="checkbox"?control.checked:control.type==="range"?Number(control.value):control.value;if(m.kind==="cell"&&c.key==="cell"&&biologyValues(m.id).cell==="Animal cell"&&biologyValues(m.id).zoom==="Chloroplast"){biologyValues(m.id).zoom="Whole cell";renderBiologyModule();return;}biologyState.investigated.add(m.id);if(control.type==="range"){gradeView.querySelector(`[data-bio-value="${c.key}"]`).textContent=`${control.value} ${c.unit||""}`;control.style.setProperty("--pct",`${(Number(control.value)-Number(control.min))/(Number(control.max)-Number(control.min))*100}%`);}if(control.type==="checkbox"){control.parentElement.querySelector("span").textContent=control.checked?c.on:c.off;control.closest(".control-item").querySelector(".control-value").textContent=control.checked?c.on:c.off;}const sortContainer=$("bio-sort-container");if(sortContainer)sortContainer.innerHTML=biologySortMarkup(m);updateBiologyLiveText();updateMeasurements();draw();const locked=biologyState.answers[m.id]===m.answer;gradeView.querySelectorAll("[data-bio-answer]").forEach(b=>b.disabled=locked);const prompt=$("bio-investigation-prompt");if(prompt)prompt.textContent="Your investigation is ready. Choose an observation and explain it.";};control.addEventListener("input",update);control.addEventListener("change",update);});
  gradeView.querySelectorAll("[data-bio-answer]").forEach(b=>b.addEventListener("click",()=>{const selected=Number(b.dataset.bioAnswer);biologyState.answers[m.id]=selected;if(selected===m.answer)biologyState.completed.add(m.id);renderBiologyModule();setupCanvas();}));
  $("bio-topic-quiz").addEventListener("click",()=>openQuiz(m.id));$("run-control").addEventListener("click",toggleRun);$("reset-control").addEventListener("click",resetModule);$("bio-try-again").addEventListener("click",resetModule);
  setupCanvas();updateMeasurements();renderNav();
}
function renderBiologyQuiz(){
  const m=biologyModules.find(x=>x.id===biologyState.quizTopic);if(!m)return;
  const answers=biologyState.quizAnswers[m.id],i=biologyState.quizIndex[m.id],complete=i>=m.quiz.length;
  const correctCount=answers.reduce((n,a)=>n+(a&&a.correct?1:0),0);biologyState.quizScores[m.id]=complete?correctCount:null;
  home.hidden=true;gradeView.hidden=true;quizView.hidden=false;
  const difficulty=["Introductory","Introductory +","Developing","Developing +","Applying","Applying +","Reasoning","Reasoning +","Challenging","Most challenging"][i];
  if(complete){
    quizView.innerHTML=`<header class="quiz-top"><div><div class="grade-kicker">Biology · ${esc(biologyGradeInfo[m.grade].name)} · ${esc(m.title)}</div><h2>Topic quiz complete</h2><p>You answered all 10 questions. Review what you learned, then try again.</p></div><button class="secondary-button" type="button" id="back-to-lab">← Back to ${esc(biologyGradeInfo[m.grade].name)}</button></header><div class="quiz-final" role="status"><span>Result: ${correctCount} out of ${m.quiz.length} correct. ${correctCount>=8?"Excellent work!":correctCount>=5?"Good effort—review the explanations and explore again.":"Keep exploring; practice helps learning."}</span><button class="secondary-button small-button" type="button" id="retake-quiz">Try again</button></div>`;
  }else{
    const q=m.quiz[i],record=answers[i],cycle=biologyState.quizCycles[m.id],options=[q[1],q[2],q[3]],shift=(cycle+i)%options.length,ordered=options.slice(shift).concat(options.slice(0,shift)),correctIndex=ordered.indexOf(q[1]);
    quizView.innerHTML=`<header class="quiz-top"><div><div class="grade-kicker">Biology · ${esc(biologyGradeInfo[m.grade].name)} · ${esc(m.title)}</div><h2>Topic quiz</h2><p>One question at a time. Questions build from introductory to challenging.</p></div><button class="secondary-button" type="button" id="back-to-lab">← Back to ${esc(biologyGradeInfo[m.grade].name)}</button></header><div class="quiz-progress"><span>Question ${i+1} of ${m.quiz.length} · ${esc(difficulty)}</span><span class="progress-track"><span class="progress-fill" style="display:block;width:${i/m.quiz.length*100}%"></span></span><span>Score ${correctCount}</span></div><article class="quiz-box"><h3>${esc(q[0])}</h3><div class="quiz-options" role="group" aria-label="Question ${i+1} answer choices">${ordered.map((o,j)=>`<button class="quiz-option${record&&record.selected===j?(record.correct?" correct":" incorrect"):""}" type="button" data-bio-quiz-answer="${j}" aria-pressed="${!!record&&record.selected===j}" ${record?"disabled":""}>${esc(o)}</button>`).join("")}</div><div class="answer-feedback${record?(record.correct?" good":" bad"):""}" aria-live="polite">${record?(record.correct?"Correct! ":"Not quite. ")+esc(q[4]):"Choose the best answer."}</div>${record&&!record.correct?`<p class="quiz-hint"><strong>Hint:</strong> ${esc(q[5])}</p>`:""}${record?`<div class="quiz-next-row"><span class="biology-flow-label">${record.correct?"Ready for the next, harder question.":"Review the hint, then continue when ready."}</span><button class="primary-button small-button" type="button" id="next-bio-question">${i===m.quiz.length-1?"See results":"Next question →"}</button></div>`:""}</article>`;
  }
  $("back-to-lab").addEventListener("click",()=>{state.module=m.id;state.grade=m.grade;state.page="grade";renderNav();renderModule();});
  const retry=$("retake-quiz");if(retry)retry.addEventListener("click",()=>{biologyState.quizCycles[m.id]++;biologyState.quizAnswers[m.id]=Array(m.quiz.length).fill(null);biologyState.quizIndex[m.id]=0;biologyState.quizScores[m.id]=null;renderBiologyQuiz();});
  quizView.querySelectorAll("[data-bio-quiz-answer]").forEach(btn=>btn.addEventListener("click",()=>{const selected=Number(btn.dataset.bioQuizAnswer),q=m.quiz[i],shift=(biologyState.quizCycles[m.id]+i)%3,ordered=[q[1],q[2],q[3]].slice(shift).concat([q[1],q[2],q[3]].slice(0,shift));answers[i]={selected,correct:ordered[selected]===q[1]};renderBiologyQuiz();}));
  const next=$("next-bio-question");if(next)next.addEventListener("click",()=>{biologyState.quizIndex[m.id]++;if(biologyState.quizIndex[m.id]>=m.quiz.length)biologyState.quizScores[m.id]=biologyState.quizAnswers[m.id].reduce((n,a)=>n+(a&&a.correct?1:0),0);renderBiologyQuiz();renderNav();});
}
function renderModule(){
  if(state.subject==="biology"){renderBiologyModule();return;}
  if(state.subject==="chemistry"){renderChemistryModule();return;}
  const m=current();if(!m)return;
  const grade=gradeInfo[m.grade],index=grade.ids.indexOf(m.id)+1;
  gradeView.hidden=false;home.hidden=true;quizView.hidden=true;
  const done=progress(m.grade);
  gradeView.innerHTML=`<header class="grade-header"><div><div class="grade-kicker">Explore ${esc(grade.name)}</div><h2>${esc(grade.name)} learning lab</h2><p>${esc(grade.description)}</p></div><div class="top-actions"><div class="grade-progress" aria-label="${done} of ${grade.ids.length} modules completed"><span>${done}/${grade.ids.length} complete</span><span class="progress-track"><span class="progress-fill" style="display:block;width:${done/grade.ids.length*100}%"></span></span></div><button class="primary-button small-button" type="button" data-quiz="${m.grade}">Class quiz · ${state.quizScores[m.grade]===null?"not taken":`${state.quizScores[m.grade]}/3`}</button></div></header>
  <div class="grade-layout"><nav class="topic-list" aria-label="${esc(grade.name)} topics">${grade.ids.map((id,i)=>{const item=modules.find(x=>x.id===id);return `<button class="topic-link" type="button" data-module="${id}" aria-current="${id===m.id}"><span class="topic-number">${String(i+1).padStart(2,"0")}</span><span class="topic-text">${esc(item.short)}</span></button>`;}).join("")}</nav>
  <article class="module-card"><header class="module-head"><div><div class="module-number">Module ${index} · ${esc(grade.name)}</div><h3>${esc(m.title)}</h3><p class="module-intro">${esc(m.intro)}</p></div><span class="simulation-tag"><span aria-hidden="true">●</span> VIRTUAL MODEL</span></header>
  ${renderPredictionPanel(m)}
  <div class="simulation-content"${state.predictions[m.id]===undefined?" hidden":""}>
  <div class="canvas-shell" id="canvas-shell"><canvas id="lab-canvas" aria-label="${esc(m.title)} interactive diagram"></canvas><div class="canvas-hint">INTERACTIVE SIMULATION · NOT TO SCALE</div></div>
  <div class="sim-footer"><span id="run-status" aria-live="polite">${state.running?"Animation running":"Ready to explore"}</span><span class="sim-disclaimer">${esc(m.note)}</span></div>
  <div class="module-lower"><section class="control-box" aria-label="Simulation controls"><h4 class="box-title">2. Investigate</h4><div class="control-grid">${renderControls(m)}</div><div class="measurements" id="measurements" aria-live="polite"></div><div class="control-actions"><button class="primary-button small-button" id="run-control" type="button">${state.running?"❚❚ Pause":"▶ Run"}</button><button class="secondary-button small-button" id="reset-control" type="button">↺ Reset</button><button class="secondary-button small-button" id="compare-control" type="button">${state.comparisons[m.id]&&state.comparisons[m.id].first&&!state.comparisons[m.id].second?"Compare settings":"Try another setting"}</button></div><p class="comparison-status" id="compare-status" aria-live="polite">${state.comparisons[m.id]&&state.comparisons[m.id].first&&!state.comparisons[m.id].second?"Setting A saved. Change a control, then compare.":"Save a setting, change a control, then compare two runs."}</p>${renderComparison(m)}</section>
  ${renderObservationPanel(m)}
  <section class="formula-panel" id="formula-panel" aria-labelledby="formula-heading"><h4 id="formula-heading">Live formula and worked example</h4><div class="formula-grid">${["formula","substitution","result","meaning","example","note","settings"].map(key=>`<div class="formula-item ${key}"><span class="formula-label">${({formula:"Formula or model rule",substitution:"Substitute current values",result:"Calculated result",meaning:"What it means",example:"Familiar example",note:"Model limits",settings:"Current controls (some may be inactive in this view)"})[key]}</span><p class="formula-value" data-formula-field="${key}"></p></div>`).join("")}</div></section>
  </div></div></article></div>`;
  gradeView.querySelectorAll("[data-module]").forEach(b=>b.addEventListener("click",()=>selectModule(b.dataset.module)));
  gradeView.querySelector("[data-quiz]").addEventListener("click",()=>openQuiz(m.grade));
  gradeView.querySelectorAll("[data-prediction-choice]").forEach(button=>button.addEventListener("click",()=>{
    const submit=$("submit-prediction");
    if(!submit)return;
    state.predictionChoices[m.id]=Number(button.dataset.predictionChoice);
    gradeView.querySelectorAll("[data-prediction-choice]").forEach(option=>option.setAttribute("aria-pressed",String(option===button)));
    submit.disabled=false;
  }));
  const submitPrediction=$("submit-prediction");
  if(submitPrediction)submitPrediction.addEventListener("click",()=>{
    if(state.predictionChoices[m.id]===undefined)return;
    state.predictions[m.id]=state.predictionChoices[m.id];
    renderModule();
  });
  gradeView.querySelector("#compare-control").addEventListener("click",saveComparison);
  gradeView.querySelectorAll("[data-observation-answer]").forEach(button=>button.addEventListener("click",()=>{
    const selected=Number(button.dataset.observationAnswer);
    state.observationAnswers[m.id]=selected;
    const check=observationChecks[m.id];
    const correct=selected===check.answer;
    gradeView.querySelectorAll("[data-observation-answer]").forEach(option=>{
      const active=Number(option.dataset.observationAnswer)===selected;
      option.setAttribute("aria-pressed",String(active));
      option.classList.toggle("is-correct",active&&correct);
      option.classList.toggle("is-incorrect",active&&!correct);
      if(correct)option.disabled=true;
    });
    const feedback=$("observation-feedback");
    feedback.textContent=correct?"That’s right. "+check.feedback+" "+(state.predictions[m.id]===predictions[m.id].answer?"Your prediction matched the model.":"Your prediction differed from the model. Comparing both is a useful way to learn."):"Try again. Hint: "+observationHints[m.id];
    feedback.classList.toggle("good",correct);
    feedback.classList.toggle("bad",!correct);
    if(correct){
      state.completed.add(m.id);
      $("activity-completion").hidden=false;
      $("investigation-prompt").textContent="You observed the model. Compare your observation with your prediction.";
      updateProgressInHeader();
    }
  }));
  gradeView.querySelectorAll("[data-key]").forEach(control=>{
    const update=()=>{
      const key=control.dataset.key;
      state.values[m.id][key]=control.type==="checkbox"?control.checked:(control.type==="range"?Number(control.value):control.value);
      markInvestigated(m);
      if(control.type==="range"){const pct=(Number(control.value)-Number(control.min))/(Number(control.max)-Number(control.min))*100;control.style.setProperty("--pct",pct+"%");const c=m.controls.find(x=>x.key===key);gradeView.querySelector(`[data-value-label="${key}"]`).textContent=`${Number(control.value).toFixed(c.step<1?1:0)} ${c.unit||""}`;}
      if(control.type==="checkbox"){const status=state.values[m.id][key]?m.controls.find(x=>x.key===key).on:m.controls.find(x=>x.key===key).off;control.parentElement.querySelector("span").textContent=status;control.closest(".control-item").querySelector(".control-value").textContent=status;}
      updateMeasurements();$("what-happening").textContent=explanations[m.id](vals(m.id));$("what-values").textContent=currentControlSummary(m);draw();
      updateFormulaPanel();
    };
    control.addEventListener("input",update);control.addEventListener("change",update);
    if(control.type==="range"){const pct=(Number(control.value)-Number(control.min))/(Number(control.max)-Number(control.min))*100;control.style.setProperty("--pct",pct+"%");}
  });
  $("run-control").addEventListener("click",toggleRun);
  $("reset-control").addEventListener("click",resetModule);
  setupCanvas();
  updateMeasurements();
  updateFormulaPanel();
  state.visited.add(m.id);
  renderNav();
  updateProgressInHeader();
}
function updateProgressInHeader(){const p=gradeView.querySelector(".grade-progress");if(!p)return;const g=state.grade,info=activeGradeInfo()[g];if(!info)return;const done=progress(g);p.setAttribute("aria-label",`${done} of ${info.ids.length} modules completed`);p.querySelector("span").textContent=`${done}/${info.ids.length} complete`;p.querySelector(".progress-fill").style.width=`${done/info.ids.length*100}%`;}
function renderNav(){const info=activeGradeInfo();document.querySelectorAll(".nav-button").forEach(b=>{b.setAttribute("aria-current",String(state.page==="home"?b.dataset.grade==="home":(state.page==="grade"||state.page==="quiz")&&Number(b.dataset.grade)===state.grade));if(b.dataset.grade!=="home"){const count=b.querySelector(".nav-count");if(count)count.textContent=info[Number(b.dataset.grade)].ids.length;}});document.querySelectorAll("[data-subject]").forEach(b=>b.setAttribute("aria-pressed",String(b.dataset.subject===state.subject)));}
function openGrade(grade){state.page="grade";state.grade=grade;const ids=activeGradeInfo()[grade].ids;if(!ids.includes(state.module))state.module=ids[0];state.running=false;state.elapsed=0;renderNav();renderModule();}
function selectModule(id){const list=state.subject==="biology"?biologyModules:state.subject==="chemistry"?chemistryModules:modules;const m=list.find(x=>x.id===id);if(!m)return;state.module=id;state.lastModule[state.subject]=id;state.grade=m.grade;state.elapsed=0;state.running=false;renderModule();}
function openQuiz(grade){if(state.subject==="biology"){const topic=biologyModules.find(m=>m.id===grade)||biologyModules.find(m=>m.grade===grade&&m.id===state.module);if(!topic)return;biologyState.quizTopic=topic.id;state.module=topic.id;state.grade=topic.grade;}else state.grade=grade;state.page="quiz";state.running=false;renderNav();renderQuiz();}
function renderQuiz(){
  if(state.subject==="biology"){renderBiologyQuiz();return;}
  if(state.subject==="chemistry"){renderChemistryQuiz();return;}
  const grade=gradeInfo[state.grade],questions=quizzes[state.grade],answers=state.quizAnswers[state.grade];
  home.hidden=true;gradeView.hidden=true;quizView.hidden=false;
  const score=answers.reduce((n,a,i)=>n+(a===questions[i].answer?1:0),0),complete=answers.every(a=>a!==null);
  state.quizScores[state.grade]=complete?score:null;
  quizView.innerHTML=`<header class="quiz-top"><div><div class="grade-kicker">${esc(grade.name)} · Quick check</div><h2>Show what you discovered</h2><p>Choose an answer for each question. You will see feedback straight away.</p></div><button class="secondary-button" type="button" id="back-to-lab">← Back to ${esc(grade.name)}</button></header>
  ${questions.map((q,i)=>`<article class="quiz-box"><h3>${i+1}. ${esc(q.q)}</h3><div class="quiz-options" role="group" aria-label="Question ${i+1}">${q.options.map((o,j)=>`<button class="quiz-option${answers[i]===j?(j===q.answer?" correct":" incorrect"):""}" type="button" data-q="${i}" data-a="${j}" aria-pressed="${answers[i]===j}" ${answers[i]!==null?"disabled":""}>${esc(o)}</button>`).join("")}</div><div class="answer-feedback${answers[i]===null?"":answers[i]===q.answer?" good":" bad"}" aria-live="polite">${answers[i]===null?"":(answers[i]===q.answer?"Correct! ":"Not quite. ")+esc(q.why)}</div></article>`).join("")}
  ${complete?`<div class="quiz-final" role="status"><span>Quiz complete: ${score} out of ${questions.length} correct. ${score===questions.length?"Brilliant work!":"Review the explanations, then explore the lab again."}</span><button class="secondary-button small-button" type="button" id="retake-quiz">Try again</button></div>`:""}`;
  $("back-to-lab").addEventListener("click",()=>{state.page="grade";renderNav();renderModule();});
  if(complete)$("retake-quiz").addEventListener("click",()=>{state.quizAnswers[state.grade]=Array(questions.length).fill(null);state.quizScores[state.grade]=null;renderQuiz();});
  quizView.querySelectorAll(".quiz-option:not(:disabled)").forEach(btn=>btn.addEventListener("click",()=>{const qi=Number(btn.dataset.q),ai=Number(btn.dataset.a);state.quizAnswers[state.grade][qi]=ai;renderQuiz();}));
}
function renderChemistryQuiz(){
  const grade=chemistryGradeInfo[state.grade],questions=chemistryQuizzes[state.grade],answers=chemistryState.quizAnswers[state.grade];
  home.hidden=true;gradeView.hidden=true;quizView.hidden=false;
  const score=answers.reduce((n,a,i)=>n+(a===questions[i].answer?1:0),0),complete=answers.every(a=>a!==null);chemistryState.quizScores[state.grade]=complete?score:null;
  quizView.innerHTML=`<header class="quiz-top"><div><div class="grade-kicker">Chemistry · ${esc(grade.name)} quick check</div><h2>Show what you discovered</h2><p>Choose an answer for each question. Feedback appears straight away.</p></div><button class="secondary-button" type="button" id="back-to-lab">← Back to ${esc(grade.name)}</button></header>${questions.map((q,i)=>`<article class="quiz-box"><h3>${i+1}. ${esc(q.q)}</h3><div class="quiz-options" role="group" aria-label="Question ${i+1}">${q.options.map((o,j)=>`<button class="quiz-option${answers[i]===j?(j===q.answer?" correct":" incorrect"):""}" type="button" data-q="${i}" data-a="${j}" aria-pressed="${answers[i]===j}" ${answers[i]!==null?"disabled":""}>${esc(o)}</button>`).join("")}</div><div class="answer-feedback${answers[i]===null?"":answers[i]===q.answer?" good":" bad"}" aria-live="polite">${answers[i]===null?"":(answers[i]===q.answer?"Correct! ":"Not quite. ")+esc(q.why)}</div></article>`).join("")}${complete?`<div class="quiz-final" role="status"><span>Quiz complete: ${score} out of ${questions.length} correct. ${score===questions.length?"Brilliant work!":"Review the explanations, then explore again."}</span><button class="secondary-button small-button" type="button" id="retake-quiz">Try again</button></div>`:""}`;
  $("back-to-lab").addEventListener("click",()=>{state.page="grade";renderNav();renderModule();});
  if(complete)$("retake-quiz").addEventListener("click",()=>{chemistryState.quizAnswers[state.grade]=Array(questions.length).fill(null);chemistryState.quizScores[state.grade]=null;renderChemistryQuiz();});
  quizView.querySelectorAll(".quiz-option:not(:disabled)").forEach(btn=>btn.addEventListener("click",()=>{chemistryState.quizAnswers[state.grade][Number(btn.dataset.q)]=Number(btn.dataset.a);renderChemistryQuiz();}));
}
function markInvestigated(m=current()){
  if(state.subject==="biology"){if(biologyState.predictions[state.module]===undefined)return;biologyState.investigated.add(state.module);const prompt=$("bio-investigation-prompt");if(prompt)prompt.textContent="Your investigation is ready. Choose an observation and explain it.";const topic=biologyModules.find(x=>x.id===state.module),locked=biologyState.answers[state.module]===topic.answer;gradeView.querySelectorAll("[data-bio-answer]").forEach(button=>button.disabled=locked);return;}
  if(state.subject==="chemistry"){if(chemistryState.predictions[state.module]===undefined)return;chemistryState.investigated.add(state.module);gradeView.querySelectorAll("[data-chem-answer]").forEach(button=>button.disabled=false);return;}
  if(!m||state.predictions[m.id]===undefined)return;
  state.investigated.add(m.id);
  gradeView.querySelectorAll("[data-observation-answer]").forEach(button=>button.disabled=false);
  const prompt=$("investigation-prompt");
  if(prompt)prompt.textContent="Your investigation is ready. Choose an answer and compare it with your prediction.";
}
function saveComparison(){
  const m=current();
  markInvestigated(m);
  if(!state.investigated.has(m.id))return;
  const comparison=state.comparisons[m.id]||(state.comparisons[m.id]={first:null,second:null});
  const snapshot=snapshotModule(m),status=$("compare-status"),button=$("compare-control");
  if(!comparison.first||comparison.second){
    comparison.first=snapshot;comparison.second=null;
    status.textContent="Setting A saved. Change at least one control, then compare.";
    button.textContent="Compare settings";
  }else{
    if(comparison.first.settings===snapshot.settings){
      status.textContent="The settings are unchanged. Adjust a control before comparing.";
      return;
    }
    comparison.second=snapshot;
    status.textContent="Compare the measurements and settings below. Try another setting to begin a new comparison.";
    button.textContent="Try another setting";
  }
  const old=gradeView.querySelector(".comparison-results");
  if(old)old.remove();
  if(comparison.second)gradeView.querySelector(".control-box").insertAdjacentHTML("beforeend",renderComparison(m));
}
function resetModule(){
  if(state.subject==="biology"){const id=state.module;state.running=false;state.elapsed=0;biologyState.values[id]=JSON.parse(JSON.stringify(biologyDefaults[id]));delete biologyState.predictionChoices[id];delete biologyState.predictions[id];delete biologyState.answers[id];biologyState.investigated.delete(id);renderModule();return;}
  if(state.subject==="chemistry"){const id=state.module;state.running=false;state.elapsed=0;chemistryState.values[id]=JSON.parse(JSON.stringify(chemistryDefaults[id]));delete chemistryState.predictionChoices[id];delete chemistryState.predictions[id];delete chemistryState.answers[id];chemistryState.investigated.delete(id);renderModule();return;}
  state.running=false;state.elapsed=0;state.values[state.module]=JSON.parse(JSON.stringify(defaultValues[state.module]));
  delete state.predictionChoices[state.module];delete state.predictions[state.module];delete state.investigated[state.module];delete state.observationAnswers[state.module];delete state.comparisons[state.module];
  renderModule();
}
function toggleRun(){
  markInvestigated();
  state.running=!state.running;if(state.running&&state.module==="motion-distance")state.elapsed=0;
  const b=$("run-control");b.textContent=state.running?"❚❚ Pause":"▶ Run";$("run-status").textContent=state.running?"Animation running":"Paused · ready to explore";lastTime=0;if(state.running)raf=requestAnimationFrame(animate);draw();updateFormulaPanel();
}
function updateMeasurements(){const el=$("measurements");if(!el)return;if(state.subject==="biology"){const m=biologyModules.find(x=>x.id===state.module),values=biologyValues(m.id),items=[[m.controls[0].label,String(values[m.controls[0].key])],["Activity status",biologyState.investigated.has(m.id)?"Investigated":"Ready to explore"],["Topic quiz",biologyState.quizScores[m.id]===null?"Not taken":`${biologyState.quizScores[m.id]}/${m.quiz.length}`]];el.innerHTML=items.map(([name,value])=>`<span class="measure-chip">${esc(name)} <strong>${esc(value)}</strong></span>`).join("");updateBiologyLiveText();return;}if(state.subject==="chemistry"){const m=chemistryModules.find(x=>x.id===state.module),list=chemistryMetrics(m,chemValues(m.id));el.innerHTML=list.map(([name,value])=>`<span class="measure-chip">${esc(name)} <strong>${esc(value)}</strong></span>`).join("");return;}const m=current(),list=m.metrics();el.innerHTML=list.map(([name,value])=>`<span class="measure-chip">${esc(name)} <strong>${esc(value)}</strong></span>`).join("");}
function setupCanvas(){const c=$("lab-canvas");if(!c)return;if(canvasObserver)canvasObserver.disconnect();ctx=c.getContext("2d");const resize=()=>{const box=c.getBoundingClientRect();if(!box.width||!box.height)return;dpr=Math.min(devicePixelRatio||1,2);canvasW=box.width;canvasH=box.height;c.width=Math.round(canvasW*dpr);c.height=Math.round(canvasH*dpr);ctx=c.getContext("2d");ctx.setTransform(dpr,0,0,dpr,0,0);draw();};canvasObserver=new ResizeObserver(resize);canvasObserver.observe(c);resize();}
function animate(t){if(!state.running)return;if(!lastTime)lastTime=t;state.elapsed+=Math.min((t-lastTime)/1000,.05);lastTime=t;draw();if(state.subject==="biology")updateBiologyLiveText();else updateFormulaPanel();if(state.running)raf=requestAnimationFrame(animate);}
function resetCanvas(){ctx.clearRect(0,0,canvasW,canvasH);ctx.lineCap="round";ctx.lineJoin="round";ctx.textAlign="left";ctx.font="11px system-ui, sans-serif";}
function text(s,x,y,color="#adbdc2",size=11,align="left"){ctx.fillStyle=color;ctx.font=`${Math.max(size,9)}px system-ui, sans-serif`;ctx.textAlign=align;ctx.fillText(s,x,y);}
function line(x1,y1,x2,y2,color="#9db0b6",w=2,dash=[]){ctx.save();ctx.strokeStyle=color;ctx.lineWidth=w;ctx.setLineDash(dash);ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();ctx.restore();}
function circle(x,y,r,fill="#ffb66d",stroke=null){ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fillStyle=fill;ctx.fill();if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=1.5;ctx.stroke();}}
function arrow(x1,y1,x2,y2,color="#69e0c1",w=2){line(x1,y1,x2,y2,color,w);const a=Math.atan2(y2-y1,x2-x1);ctx.fillStyle=color;ctx.beginPath();ctx.moveTo(x2,y2);ctx.lineTo(x2-8*Math.cos(a-.45),y2-8*Math.sin(a-.45));ctx.lineTo(x2-8*Math.cos(a+.45),y2-8*Math.sin(a+.45));ctx.closePath();ctx.fill();}
function draw(){
 if(!ctx||!canvasW||!canvasH)return;resetCanvas();const id=state.module,v=vals(),w=canvasW,h=canvasH;
 if(state.subject==="biology"){drawBiology(w,h);return;}
 if(state.subject==="chemistry"){drawChemistry(chemValues(),w,h);return;}
 if(id==="motion-distance")drawMotion(v,w,h);
 else if(id==="light-shadow")drawShadow(v,w,h);
 else if(id==="electric-circuits")drawCircuit(v,w,h,false);
 else if(id==="magnets")drawMagnets(v,w,h);
 else if(id==="heat")drawHeat(v,w,h);
 else if(id==="motion-time")drawMotionTime(v,w,h);
 else if(id==="current-effects")drawCurrent(v,w,h);
 else if(id==="light")drawOptics(v,w,h);
 else if(id==="electric-effects")drawLiquid(v,w,h);
 else if(id==="forces")drawForces(v,w,h);
 else if(id==="pressure-weather")drawPressure(v,w,h);
 else if(id==="sound")drawSound(v,w,h);
 else if(id==="reflection-eye")drawEye(v,w,h);
 else if(id==="natural-phenomena")drawNatural(v,w,h);
}
function bioWrappedLabel(label,x,y,maxWidth,color="#c7d4d4",size=9){
 const words=label.split(/\s+/),lines=[];let current="";
 words.forEach(word=>{const test=current?current+" "+word:word;if(ctx.measureText(test).width>maxWidth&&current){lines.push(current);current=word;}else current=test;});
 if(current)lines.push(current);lines.slice(0,3).forEach((part,i)=>text(part,x,y+i*12,color,size,"center"));
}
function bioNode(label,x,y,color="#1e343b",r=30){
 circle(x,y,r,color,"#4c7474");bioWrappedLabel(label,x,y-r/2,Math.max(52,r*1.65),"#e0e9e7",9);
}
function drawBiology(w,h){
 const m=biologyModules.find(x=>x.id===state.module),v=biologyValues(m.id),cx=w*.5,cy=h*.5,pulse=state.running?Math.sin(state.elapsed*3):0;
 text(m.title,cx,30,"#cde4dc",12,"center");
 if(m.kind==="plant"||m.kind==="plant-compare"){
  const stemX=m.kind==="plant"?cx:cx*.55,ground=h*.69;
  line(stemX,ground,stemX,h*.31,"#75c98d",6);line(stemX,ground,stemX-42,h*.79,"#c19d76",3);line(stemX,ground,stemX+42,h*.79,"#c19d76",3);
  for(let i=0;i<5;i++){const y=h*(.38+i*.055);line(stemX,y,stemX+(i%2?34:-34),y-17,"#77c68c",2);circle(stemX+(i%2?34:-34),y-17,12,"#4d9c71");}
  const part=v.part||v.structure||"Leaf";text(`${part}: ${part==="Root"||part==="Roots"?"anchor & absorb":part==="Stem"||part==="Stems"?"support & transport":part==="Leaf"||part==="Leaves"?"make sugars":part==="Flower"||part==="Flowers"?"reproduction":part==="Fruit"||part==="Fruits"?"protect seeds":"can grow"}`,cx,h*.91,"#c5d3d2",10,"center");
  if(m.kind==="plant"){for(let j=0;j<5;j++){const a=j*Math.PI*2/5;circle(stemX+Math.cos(a)*12,h*.27+Math.sin(a)*12,8,"#f1bf83");}circle(stemX,h*.27,6,"#d98d58");text("flower",stemX,h*.21,"#e2d4b8",9,"center");text("leaf",stemX+48,h*.39,"#bfe4c6",9,"center");text("roots",stemX,h*.85,"#e1c39f",9,"center");}
  else{const second=w*.77;line(second,ground,second,h*.39,"#75c98d",4);for(let i=0;i<4;i++){const y=h*(.44+i*.06);circle(second+(i%2?19:-19),y,8,"#68aa7d");}const left=w*.28,right=w*.72,y=h*.58,structure=v.structure;text(v.example||"Compare forms",cx,h*.94,"#c2d0d1",9,"center");text(structure,left,y-30,"#bfe4c6",9,"center");text(structure,right,y-30,"#bfe4c6",9,"center");if(structure==="Roots"){for(let j=0;j<5;j++){line(left,y,left+(j-2)*9,y+32,"#c19d76",2);line(right,y,right+(j-2)*15,y+30,"#c19d76",2);}}else if(structure==="Stems"){line(left,y+28,left,y-20,"#5da46e",5);line(right,y+28,right,y-20,"#9f805b",9);line(right,y-1,right+15,y-16,"#9f805b",5);}else if(structure==="Leaves"){ctx.fillStyle="#4d9c71";ctx.beginPath();ctx.ellipse(left,y,24,12,-.35,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.ellipse(right,y,11,24,.25,0,Math.PI*2);ctx.fill();}else if(structure==="Flowers"){for(let j=0;j<5;j++){const a=j*Math.PI*2/5;circle(left+Math.cos(a)*11,y+Math.sin(a)*11,7,"#f1bf83");}circle(left,y,5,"#d98d58");for(let j=0;j<7;j++){const a=j*Math.PI*2/7;circle(right+Math.cos(a)*13,y+Math.sin(a)*13,6,"#d88b9c");}circle(right,y,5,"#e6c46f");}else if(structure==="Fruits"){circle(left,y,19,"#d9815c");circle(right,y,15,"#7da85e");}else{for(let j=0;j<4;j++){circle(left-15+j*10,y,4,"#e2cb87");circle(right-12+j*8,y+(j%2)*4,4,"#a9c77d");}}}
  text("light ↓",w*.86,h*.25,"#f0d18a",9,"center");line(w*.86,h*.29,w*.7,h*.37,"#f0d18a",1.5);text("soil",w*.13,ground+19,"#bea887",9,"center");return;
