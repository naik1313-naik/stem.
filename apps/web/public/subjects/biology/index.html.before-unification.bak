  const lost=v.change==="Deforestation"?.5:v.change==="Less water"?.28:v.change==="Fewer plants"?.55:1;
  nodes.forEach((n,i)=>{const x=w*n[1],y=h*n[2];if(i===1&&lost<.7){ctx.globalAlpha=lost;}bioNode(n[0],x,y,n[3],28);ctx.globalAlpha=1;});
  arrow(w*.22,h*.27,w*.32,h*.34,"#edcc7b",2);arrow(w*.43,h*.39,w*.56,h*.37,"#69e0c1",2);arrow(w*.66,h*.4,w*.78,h*.48,"#ffb66d",2);arrow(w*.76,h*.56,w*.45,h*.68,"#bd9bd9",2);arrow(w*.43,h*.74,w*.38,h*.44,"#74bed0",2);
